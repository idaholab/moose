[Tests]
  issues = '#19571'
  design = 'LibtorchDRLControl.md'
  [read-parameters]
    type = CSVDiff
    input = libtorch_drl_control.i
    csvdiff = parameter_read.csv
    cli_args = "Outputs/file_base='parameter_read'"
    # A retried time step executes the control again, drawing another policy sample.
    restep = false
    requirement = "The system shall be able to read a neural network from a parameter file and use "
                  "it to control a transient process."
    capabilities = 'libtorch'
  []
  [read-parameters-period]
    type = CSVDiff
    input = libtorch_drl_control.i
    csvdiff = parameter_read_period.csv
    cli_args = "Controls/src_control/num_steps_in_period=2 Outputs/file_base='parameter_read_period'"
    # A retried time step executes the control again, drawing another policy sample.
    restep = false
    requirement = "The system shall be able to hold a DRL control signal over a multi-step control "
                  "period and advance the observation history once per period."
    capabilities = 'libtorch'
  []
  [read-parameters-bounded]
    type = CSVDiff
    input = libtorch_drl_control.i
    csvdiff = parameter_read_bounded.csv
    # mynet_control_bounded.net is an untrained Beta actor with the architecture of src_control,
    # saved by the LibtorchDRLControlTrainer in transfers/sampler_drl_control_transfer/trainer.i.
    # With action_scaling_factors = 100, the bounds limit left_flux to [-100, 100], narrower than
    # the range the unbounded controller reaches in parameter_read.csv.
    cli_args = "Controls/src_control/filename='mynet_control_bounded.net' "
               "Controls/src_control/min_control_value=-1 Controls/src_control/max_control_value=1 "
               "Outputs/file_base='parameter_read_bounded'"
    # A retried time step executes the control again, drawing another policy sample.
    restep = false
    requirement = "The system shall be able to control a transient process with a bounded neural "
                  "network read from a parameter file, sampling each action within the bounds."
    capabilities = 'libtorch'
  []
  [read-parameters-smoothed]
    type = CSVDiff
    input = libtorch_drl_control.i
    csvdiff = parameter_read_smoothed.csv
    # The control drives a ConstantPostprocessor instead of the BC so that the smoothed value
    # applied_flux is output next to the policy action left_flux.
    cli_args = "Controls/src_control/control_smoothing_factor=0.5 "
               "Controls/src_control/parameters='Postprocessors/applied_flux/value' "
               "Postprocessors/applied_flux/type=ConstantPostprocessor "
               "Postprocessors/applied_flux/execute_on='INITIAL TIMESTEP_END' "
               "Outputs/file_base='parameter_read_smoothed'"
    # A retried time step executes the control again, drawing another policy sample.
    restep = false
    requirement = "The system shall be able to exponentially smooth the control signal applied by a "
                  "DRL controller."
    capabilities = 'libtorch'
  []
  [without-nn]
    type = CSVDiff
    input = libtorch_drl_control.i
    csvdiff = run_wo_nn.csv
    cli_args = "Outputs/file_base='run_wo_nn' Controls/inactive='src_control' "
               "Postprocessors/left_flux/control_name='src_control_empty' "
               "Postprocessors/log_prob_left_flux/control_name='src_control_empty'"
    requirement = "The system shall be able to run with a DRL controller without having a neural net "
                  "initialized in it."
    capabilities = 'libtorch'
  []
  [invalid-execute-on]
    type = RunException
    input = libtorch_drl_control.i
    cli_args = "Controls/src_control/execute_on='TIMESTEP_END'"
    expect_err = "LibtorchDRLControl only supports 'TIMESTEP_BEGIN' for 'execute_on'."
    requirement = "The system shall reject DRL controller execute flags other than timestep begin."
    capabilities = 'libtorch'
  []
[]
