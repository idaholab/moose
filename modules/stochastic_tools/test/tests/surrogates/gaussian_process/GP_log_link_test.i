# Gaussian Process with log link function for positivity constraint.
#
# This version does NOT use sub.i, MultiApps, Controls, or Transfers.
# Training and testing data are read from CSV files generated by
# generate_gp_data.py.
#
# Function:
#
#   f(x) = 1/(1+(10*x)^4) + 0.5*exp(-100*(x-0.5)^2)
#
# Domain:
#
#   x in [0,1]
#
# Required CSV files:
#
#   train.csv : columns x,y
#   test.csv  : columns x,y_true

[StochasticTools]
[]

[Samplers]
  # Training inputs.
  # Reads only the x column from train.csv.
  [train_sample]
    type = CSVSampler
    samples_file = 'train.csv'
    column_names = 'x'
    execute_on = 'INITIAL TIMESTEP_END'
  []

  # Testing inputs.
  # Reads only the x column from test.csv.
  # Do not include y_true in this sampler because the GP input is 1-D.
  [test_sample]
    type = CSVSampler
    samples_file = 'test.csv'
    column_names = 'x'
    execute_on = 'INITIAL FINAL'
  []
[]

[VectorPostprocessors]
  # Reads the full training CSV file.
  #
  # Because train.csv has header:
  #
  #   x,y
  #
  # this creates vectors:
  #
  #   train_data/x
  #   train_data/y
  #
  # DO NOT set execute_on here. CSVReaderVectorPostprocessor suppresses
  # execute_on internally.
  [train_data]
    type = CSVReaderVectorPostprocessor
    csv_file = 'train.csv'
    header = true
  []

  # Reads the full testing CSV file for comparison with GP predictions.
  #
  # Because test.csv has header:
  #
  #   x,y_true
  #
  # this creates vectors:
  #
  #   test_data/x
  #   test_data/y_true
  #
  # DO NOT set execute_on here.
  [test_data]
    type = CSVReaderVectorPostprocessor
    csv_file = 'test.csv'
    header = true
  []
[]

[Reporters]
  # GP prediction and GP standard deviation on the test points.
  [samp_avg]
    type = EvaluateSurrogate
    model = GP_avg
    sampler = test_sample
    evaluate_std = true
    parallel_type = ROOT
    execute_on = FINAL
  []
[]

[Trainers]
  [GP_avg_trainer]
    type = GaussianProcessTrainer
    execute_on = TIMESTEP_END

    covariance_function = 'covar'

    standardize_params = true
    standardize_data = true

    # Predictor/input data comes from the x column of train.csv
    # through train_sample.
    sampler = train_sample

    # Response/output data comes from the y column of train.csv
    # through train_data.
    response = train_data/y

    # Enforce positivity through the log link:
    #
    #   g(y) = log(y - link_lower_bound)
    #
    # For this analytic function, f(x) > 0 on [0,1], so use lower bound 0.
    link_function = log
    link_lower_bound = 0.0
  []
[]

[Surrogates]
  [GP_avg]
    type = GaussianProcessSurrogate
    trainer = GP_avg_trainer
  []
[]

[Covariance]
  [covar]
    type = SquaredExponentialCovariance

    # The problem is now 1-D, so length_factor has one value.
    signal_variance = 1
    noise_variance = 1e-6
    length_factor = '0.2'
  []
[]

[Outputs]
  [out]
    type = CSV
    execute_on = FINAL
  []
[]
