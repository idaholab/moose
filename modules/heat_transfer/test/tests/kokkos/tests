    []
    [time]
      type = 'CSVDiff'
      input = 'kokkos_convective_flux_function.i'
      csvdiff = 'kokkos_convective_flux_function_out.csv'
      cli_args = "Functions/coefficient/expression='t*10.0'"
      detail = 'a function of time,'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
      allow_test_objects = true
      prereq = 'convective_flux_function/constant'
    []
    [temperature]
      type = 'CSVDiff'
      input = 'kokkos_convective_flux_function.i'
      csvdiff = 'kokkos_convective_flux_function_out.csv'
      cli_args = 'BCs/right/coefficient=coefficient_temperature BCs/right/coefficient_function_type=TEMPERATURE'
      detail = 'a function of temperature, and'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
