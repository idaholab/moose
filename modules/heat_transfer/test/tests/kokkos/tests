      detail = 'with a perfect Jacobian including the coupled variable derivatives.'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
      allow_test_objects = true
    []
  []

  [truss]
    type = 'Exodiff'
    input = 'kokkos_truss_heat_conduction.i'
    exodiff = 'kokkos_truss_heat_conduction_out.e'
    rel_err = 1e-6
    abs_zero = 1e-10
    design = 'KokkosTrussHeatConduction.md KokkosTrussHeatConductionTimeDerivative.md'
    requirement = 'The Kokkos system shall compute heat conduction in truss elements taking the cross-sectional area into account.'
    capabilities = 'kokkos'
    compute_devices = 'cpu'
  []

  [homogenization]
    design = 'KokkosHomogenizedHeatConduction.md KokkosAnisoHomogenizedHeatConduction.md KokkosHomogenizedThermalConductivity.md'
    requirement = 'The Kokkos system shall compute homogenized thermal conductivity using the asymptotic expansion homogenization approach'
    [scalar]
      type = 'Exodiff'
      input = 'kokkos_homogenization.i'
      exodiff = 'kokkos_homogenization_out.e'
      detail = 'for scalar heterogeneous thermal conductivities,'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
    []
    [tensor]
      type = 'Exodiff'
