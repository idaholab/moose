      type = 'Exodiff'
      input = 'kokkos_heat_conduction_ortho.i'
      exodiff = 'kokkos_heat_conduction_ortho_out.e'
      detail = 'for an orthotropic conductivity,'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
      allow_test_objects = true
    []
    [jacobian]
      type = 'PetscJacobianTester'
      input = 'kokkos_heat_conduction_ortho.i'
      cli_args = 'Materials/heat/thermal_conductivity_temperature_coefficient_function=coefficient Outputs/exodus=false'
      detail = 'with a perfect Jacobian for a temperature-dependent conductivity.'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
      allow_test_objects = true
    []
  []

  [specific_heat]
    type = 'Exodiff'
    input = 'kokkos_specific_heat_transient.i'
    exodiff = 'kokkos_specific_heat_transient_out.e'
    design = 'KokkosSpecificHeatConductionTimeDerivative.md'
    requirement = 'The Kokkos system shall compute the time derivative term of the heat equation with the specific heat and the density as arguments.'
    capabilities = 'kokkos'
    compute_devices = 'cpu'
  []

  [temperature_dependent]
    design = 'KokkosHeatConductionMaterial.md KokkosHeatCapacityConductionTimeDerivative.md KokkosHeatConductionBC.md KokkosThermalSensitivity.md KokkosThermalConductivity.md'
    requirement = 'The Kokkos system shall compute heat conduction with temperature-dependent properties given by functions and coupled variable derivatives'
    [solution]
      type = 'Exodiff'
      input = 'kokkos_temperature_dependent.i'
      exodiff = 'kokkos_temperature_dependent_out.e'
      detail = 'by solving the coupled problem,'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
      allow_test_objects = true
    []
    [jacobian]
      type = 'PetscJacobianTester'
      input = 'kokkos_temperature_dependent.i'
