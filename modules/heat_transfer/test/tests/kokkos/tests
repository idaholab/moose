  [radiative_heat_flux]
    issues = '#30655'
    design = 'KokkosRadiativeHeatFluxBC.md'
    requirement = 'The Kokkos system shall be able to compute numerically accurate Jacobians when specifying a radiative boundary condition for a plate heat structure'
    [constant]
      type = 'PetscJacobianTester'
      input = 'kokkos_radiation_heat_flux_bc.i'
      ratio_tol = 1e-6
      difference_tol = 2e-5
      max_threads = 1
      max_parallel = 1
      detail = 'with a unit view factor, and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [view_factor]
      type = 'PetscJacobianTester'
      input = 'kokkos_radiation_heat_flux_bc.i'
      cli_args = 'BCs/bc/view_factor=view_factor'
      ratio_tol = 1e-6
      difference_tol = 2e-5
      max_threads = 1
      max_parallel = 1
      detail = 'with a view factor given by a function.'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
    []
