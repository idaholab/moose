      input = 'kokkos_homogenization_tensor.i'
      exodiff = 'kokkos_homogenization_full_tensor.e'
      cli_args = 'Outputs/file_base=kokkos_homogenization_full_tensor Materials/heat2/thermal_conductivity="100 1 0 0 80 8 0 0 0"'
      detail = 'for full tensor heterogeneous thermal conductivities.'
      capabilities = 'kokkos'
      compute_devices = 'cpu'
    []
  []

  [convective_flux_function]
    design = 'KokkosConvectiveFluxFunction.md'
    requirement = 'The Kokkos system shall compute a convective heat flux boundary condition with the heat transfer coefficient given as'
