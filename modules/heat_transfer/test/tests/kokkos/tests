      cli_args = 'BCs/right/coefficient=coefficient_temperature BCs/right/coefficient_function_type=TEMPERATURE Outputs/csv=false'
      detail = 'a function of temperature with a perfect Jacobian.'
      capabilities = 'kokkos'
