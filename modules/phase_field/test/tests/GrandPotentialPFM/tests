[Tests]
  [GrandPotentialPFM]
    type = 'Exodiff'
    input = 'GrandPotentialPFM.i'
    exodiff = 'GrandPotentialPFM_out.e'
    issues = '#6977'
    design = '/GrandPotentialKernelAction.md'
    requirement = 'The system shall provide classes to implement a Grand Potential phase field '
                  'formulation'
  []
  [GrandPotentialMultiphase]
    type = 'Exodiff'
    input = 'GrandPotentialMultiphase.i'
    exodiff = 'GrandPotentialMultiphase_out.e'
    issues = '#8213'
    design = '/ACSwitching.md'
    requirement = 'The system shall provide a Grand Potential based multiphase model'
  []
  [GrandPotentialAnisotropy]
    type = 'Exodiff'
    input = 'GrandPotentialAnisotropy.i'
    exodiff = 'GrandPotentialAnisotropy_out.e'
    abs_zero = 1e-8
    issues = '#11802 #12554'
    design = '/ACInterface2DMultiPhase1.md /ACInterface2DMultiPhase2.md '
             '/InterfaceOrientationMultiphaseMaterial.md'
    requirement = 'The system shall provide a Grand Potential based dendritic solidification '
                  'capability in 2D'
  []
  [GrandPotentialStrictMassConservation]
    type = 'Exodiff'
    input = 'GrandPotentialStrictMassConservation.i'
    exodiff = 'GrandPotentialStrictMassConservation_out.e'
    custom_cmp = GrandPotentialStrictMassConservation.cmp
    issues = '#23329'
    design = '/GrandPotentialKernelAction.md'
    requirement = 'The system shall provide classes to implement a Grand Potential phase field '
                  'formulation with strict mass conservation'
    capabilities = 'method!=dbg'
    valgrind = 'heavy'
  []
  [GrandPotentialStrictMassConservationTwoSpecies]
    type = 'CSVDiff'
    input = 'GrandPotentialStrictMassConservationTwoSpecies.i'
    csvdiff = 'GrandPotentialStrictMassConservationTwoSpecies_out.csv'
    # c_err and w_err vanish for the exact solution and come out at ~1e-8 here, limited by the
    # linear and nonlinear solve tolerances. 1e-6 leaves room for solver and partitioning
    # differences; coupling the second species to the first gives |w_err| ~ 7.
    abs_zero = 1e-6
    issues = '#23329 #34237'
    design = '/GrandPotentialKernelAction.md'
    requirement = 'The system shall solve the strict mass conservation Grand Potential '
                  'formulation for multiple species, each with its own per-phase equilibrium '
                  'concentrations and curvature coefficients'
    capabilities = 'method!=dbg'
    valgrind = 'heavy'
  []
  [GrandPotentialStrictMassConservationTwoSpecies_jac]
    type = 'PetscJacobianTester'
    input = 'GrandPotentialStrictMassConservationTwoSpecies.i'
    # Nonzero chemical potentials so the order parameter derivatives of the per-species
    # coefficients and mobilities enter the Jacobian; at w = 0 they multiply zero
    cli_args = 'Mesh/nx=4 Mesh/ny=4 Executioner/num_steps=1 Outputs/csv=false '
               'ICs/w_IC/type=ConstantIC ICs/w_IC/variable=w ICs/w_IC/value=-5 '
               'ICs/w2_IC/type=ConstantIC ICs/w2_IC/variable=w2 ICs/w2_IC/value=-10'
    issues = '#34237'
    design = '/GrandPotentialKernelAction.md'
    requirement = 'The system shall compute the Jacobian of the strict mass conservation Grand '
                  'Potential formulation with multiple species, including the coupling between '
                  'each species and the order parameters'
    capabilities = 'method!=dbg'
  []
  [StrictMassConservationErrors]
    issues = '#23329 #34237'
    design = '/GrandPotentialKernelAction.md'
    requirement = 'The system shall report an error for the strict mass conservation Grand '
                  'Potential formulation if'
    [concentrations_size]
      type = RunException
      input = 'GrandPotentialStrictMassConservation.i'
      cli_args = "Modules/PhaseField/GrandPotential/concentrations='c c2'"
      expect_err = "Provide as many concentrations as entries in 'chemical_potentials'."
      detail = 'the number of concentrations differs from the number of chemical potentials, or'
    []
    [coefficients_size]
      type = RunException
      input = 'GrandPotentialStrictMassConservation.i'
      cli_args = "Modules/PhaseField/GrandPotential/hj_c_min='hv_c_min'"
      expect_err = "Provide length of 'chemical_potentials' \* length of "
                   "'switching_function_names' values."
      detail = 'the number of per-phase concentration minima is not the number of chemical '
               'potentials times the number of phases, or'
    []
    [curvature_coefficients_size]
      type = RunException
      input = 'GrandPotentialStrictMassConservation.i'
      cli_args = "Modules/PhaseField/GrandPotential/hj_over_kVa='hv_over_kVa'"
      expect_err = "Provide length of 'chemical_potentials' \* length of "
                   "'switching_function_names' values."
      detail = 'the number of per-phase curvature coefficients is not the number of chemical '
               'potentials times the number of phases.'
    []
  []
  [GrandPotentialInterface]
    type = 'CSVDiff'
    input = 'GrandPotentialInterface.i'
    csvdiff = 'GrandPotentialInterface_out_mat_0001.csv'
    issues = '#12147'
    design = '/GrandPotentialInterface.md'
    requirement = 'The system shall provide a material to automatically compute grand potential '
                  'model interface parameters based on provided interfacial free energies and widths'
    valgrind = 'heavy'
  []
  [GrandPotentialAnisotropyAntitrap]
    type = 'Exodiff'
    input = 'GrandPotentialAnisotropyAntitrap.i'
    exodiff = 'GrandPotentialAnisotropyAntitrap_out.e'
    issues = '#13373'
    design = '/AntitrappingCurrent.md'
    requirement = 'The system shall provide a Grand Potential based dendritic solidification '
                  'capability for alloy with antitrapping current'
  []
  [SinteringBase]
    type = 'Exodiff'
    input = 'SinteringBase.i'
    exodiff = 'SinteringBase_out.e'
    issues = '#18420'
    design = '/GrandPotentialSinteringMaterial.md'
    requirement = 'The system shall provide a Grand Potential based sintering model'
    abs_zero = 4e-10
  []
  [SinteringParabolic]
    type = 'Exodiff'
    input = 'SinteringParabolic.i'
    exodiff = 'SinteringParabolic_out.e'
    issues = '#18420'
    design = '/GrandPotentialSinteringMaterial.md'
    requirement = 'The system shall provide a Grand Potential based sintering model with parabolic '
                  'defect free energies'
  []
  [SinteringDilute]
    type = 'Exodiff'
    input = 'SinteringDilute.i'
    exodiff = 'SinteringDilute_out.e'
    issues = '#18420'
    design = '/GrandPotentialSinteringMaterial.md'
    requirement = 'The system shall provide a Grand Potential based sintering model with dilute '
                  'solution defect free energies'
  []
  [SinteringIdeal]
    type = 'Exodiff'
    input = 'SinteringIdeal.i'
    exodiff = 'SinteringIdeal_out.e'
    issues = '#18420'
    design = '/GrandPotentialSinteringMaterial.md'
    requirement = 'The system shall provide a Grand Potential based sintering model with ideal '
                  'solution defect free energies'
  []

  [GrandPotentialMultiphase_ad]
    type = 'Exodiff'
    input = 'GrandPotentialMultiphase_AD.i'
    exodiff = 'GrandPotentialMultiphase_out.e'
    issues = '#15573'
    design = '/ACSwitching.md /CoupledSwitchingTimeDerivative.md'
    requirement = 'MOOSE shall provide a Grand Potential based multiphase model with AD option'
  []

  [ADGrandPotentialMultiphase_jac]
    type = 'PetscJacobianTester'
    input = 'GrandPotentialMultiphase_AD.i'
    run_sim = 'True'
    cli_args = 'Mesh/nx=3 Mesh/ny=3 Outputs/exodus=false Executioner/num_steps=1'
    ratio_tol = 1e-7
    issues = '#15573'
    design = '/ACSwitching.md /CoupledSwitchingTimeDerivative.md'
    requirement = 'The jacobian for the AD Allen-Cahn problem with a variable dependent coeffecients shall be perfect'
  []
[]
