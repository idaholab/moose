[Tests]
  [./kobayashi]
    type = 'Exodiff'
    input = 'kobayashi.i'
    exodiff = 'kobayashi_out.e'
  [../]
  [./adkobayashi]
    type = 'Exodiff'
    input = 'adkobayashi.i'
    exodiff = 'adkobayashi_out.e'
    custom_cmp = 'adkobayashi.exodiff'
    valgrind = HEAVY
  [../]

  [kobayashi_variable_mobility_jacobian]
    type = 'PetscJacobianTester'
    input = 'kobayashi_variable_mobility_jacobian.i'
    run_sim = 'True'
    ratio_tol = 1e-7
    issues = '#34180'
    design = '/ACInterfaceKobayashi1.md /ACInterfaceKobayashi2.md'
    requirement = 'The system shall compute a correct Jacobian for the anisotropic Kobayashi Allen-Cahn interface kernels with a mobility that depends on the order parameter and on a coupled variable.'
