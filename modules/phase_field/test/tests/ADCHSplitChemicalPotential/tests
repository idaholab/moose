[Tests]
  issues = '#14396'
  design = 'ADCHSplitChemicalPotential.md ADCHSplitConcentration.md'
  [./simple_transient_diffusion]
    type = 'Exodiff'
    input = 'simple_transient_diffusion.i'
    exodiff = 'simple_transient_diffusion_out.e'
    requirement = 'The system shall solve a simple Cahn-Hilliard problem using automatic '
                  'differentiation with ADCHSplitChemicalPotential and ADCHSplitConcentration.'
  [../]
  [./simple_transient_diffusion-jac]
    type = 'PetscJacobianTester'
    input = 'simple_transient_diffusion.i'
    run_sim = true
    difference_tol = 1e-7
    cli_args = 'Outputs/exodus=false'
    allow_test_objects = true
    requirement = 'The system shall compute accurate Jacobians for the automatic differentiation '
                  'ADCHSplitChemicalPotential and ADCHSplitConcentration kernels.'
  [../]
[]
