[Tests]
  issues = '#4763'
  design = 'phase_field/Nucleation/LangevinNoise.md'

  [./integral]
    type = 'CSVDiff'
    input = 'integral.i'
    csvdiff = 'integral.csv'

    requirement = 'The system shall supply a noise field with a domain integral of zero'
  [../]
  [./normal]
    max_parallel = 1
    type = 'Exodiff'
    input = 'normal.i'
    exodiff = 'normal.e'

    requirement = 'The system shall supply a normal distributed noise field with a domain integral of zero'
  [../]
  [./uniform]
    max_parallel = 1
    type = 'Exodiff'
    input = 'uniform.i'
    exodiff = 'uniform.e'

    requirement = 'The system shall supply a uniformly distributed noise field with a domain integral of zero'
  [../]
  [./integral_normal_masked]
    type = 'CSVDiff'
    input = 'normal_masked.i'
    csvdiff = 'normal_masked.csv'

    requirement = 'The system shall supply a normal distributed noise field with an amplitude mask and a domain integral of zero'
  [../]

  [./seed_error]
    type = 'RunException'
    input = 'integral.i'
    cli_args = 'Kernels/conserved_langevin/seed=1234'
    expect_err = "This parameter has no effect in this kernel. The noise is generated in the user object"

    requirement = "The system shall error out with a helpful message if a 'seed' parameter is supplied to the conserved noise kernel"
  [../]
[]
