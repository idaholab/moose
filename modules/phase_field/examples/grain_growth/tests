[Tests]
  issues = '#7319'
  [./grain_growth_2D_graintracker]
    type = RunApp
    input = 'grain_growth_2D_graintracker.i'
    # Only run in opt mode to avoid timeouts in dbg.
    capabilities = 'method!=dbg'
    check_input = True
    design = 'GrainGrowthAction.md GrainTracker.md'
    requirement = 'The system shall be able to syntax check a 2D grain growth example that uses the GrainGrowth action and tracks grains with the GrainTracker.'
  [../]
  [./grain_growth_2D_random]
    type = RunApp
    input = 'grain_growth_2D_random.i'
    capabilities = 'method!=dbg'
    check_input = True
    design = 'GrainGrowthAction.md PolycrystalRandomIC.md'
    requirement = 'The system shall be able to syntax check a 2D grain growth example that uses the GrainGrowth action with a randomly seeded polycrystal initial condition.'
  [../]
  [./grain_growth_2D_voronoi]
    type = RunApp
    input = 'grain_growth_2D_voronoi.i'
    capabilities = 'method!=dbg'
    check_input = True
    design = 'GBEvolution.md PolycrystalVoronoi.md'
    requirement = 'The system shall be able to syntax check a 2D grain growth example built explicitly from a Voronoi tessellation polycrystal initial condition.'
  [../]
  [./grain_growth_2D_voronoi_newadapt]
    type = RunApp
    input = 'grain_growth_2D_voronoi_newadapt.i'
    cli_args = 'Adaptivity/max_h_level=0'
    capabilities = 'method!=dbg'
    check_input = True
    design = 'GBEvolution.md PolycrystalVoronoi.md'
    requirement = 'The system shall be able to syntax check a 2D grain growth example built from a Voronoi tessellation polycrystal initial condition with mesh adaptivity.'
  [../]
  [./grain_growth_3D]
    type = RunApp
    input = 'grain_growth_3D.i'
    # Only run in opt mode to avoid timeouts in dbg.
    capabilities = 'method!=dbg'
    check_input = True

    cli_args = 'Mesh/uniform_refine=0'
    design = 'GrainGrowthAction.md GrainTracker.md'
    requirement = 'The system shall be able to syntax check a 3D grain growth example that uses the GrainGrowth action and tracks grains with the GrainTracker.'
  [../]
  [./grain_growth_3D_large]
    type = RunApp
    input = '3D_6000_gr.i'
    # Only run in opt mode to avoid timeouts in dbg.
    capabilities = 'method!=dbg'
    check_input = True

    cli_args = 'Mesh/nx=10 Mesh/ny=10 Mesh/ny=10 UserObjects/voronoi/grain_num=10 GlobalParams/op_num=10'
    issues = '#7319 #11804'
    design = 'GBEvolution.md PolycrystalVoronoi.md GrainTracker.md'
    requirement = 'The system shall be able to syntax check a large-scale 3D grain growth example with many grains, built explicitly from a Voronoi tessellation polycrystal initial condition.'
  [../]
[]
