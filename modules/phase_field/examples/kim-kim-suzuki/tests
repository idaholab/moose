[Tests]
  design = 'phase_field/MultiPhase/KKS.md'
  [./kks_example_dirichlet]
    type = RunApp
    input = 'kks_example_dirichlet.i'
    issues = '#5924'
    check_input = True
    requirement = 'The system shall syntax check a two-phase Kim-Kim-Suzuki example with Dirichlet boundary conditions.'
  [../]
  [./kks_example_noflux]
    type = RunApp
    input = 'kks_example_noflux.i'
    issues = '#5924'
    check_input = True
    requirement = 'The system shall syntax check a two-phase Kim-Kim-Suzuki example with no-flux boundary conditions.'
  [../]
  [./kks_example_ternary]
    type = RunApp
    input = 'kks_example_ternary.i'
    issues = '#6244'
    # Note: we use a smaller mesh, as this does not affect the
    # --check-input results in any way other than the amount of time
    # it takes to run.
    check_input = True
    cli_args = 'Mesh/nx=2 Mesh/ny=2'
    requirement = 'The system shall syntax check a Kim-Kim-Suzuki example for a ternary (three-component) system.'
  [../]
[]
