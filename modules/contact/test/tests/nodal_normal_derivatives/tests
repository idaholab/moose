[Tests]
  issues = '#33378'

  [interpolated_normals_rejected]
    type = RunException
    input = ../3d-mortar-contact/frictionless-mortar-3d.i
    cli_args = 'Constraints/normal_lm/interpolate_normals=true'
    expect_err = 'cannot be combined with quadrature-point normal interpolation'
    max_parallel = 1
    design = 'ComputeWeightedGapLMMechanicalContact.md'
    requirement = 'Mechanical mortar contact shall reject interpolated quadrature-point normals.'
  []

  [unsupported_weighted_gap_uo]
    type = RunException
    input = unsupported_weighted_gap_uo.i
    cli_args = 'Outputs/exodus=false'
    expect_err = "Nodal-normal derivatives are not supported by user object 'czm_uo'."
    max_parallel = 1
    design = 'ComputeWeightedGapLMMechanicalContact.md'
    requirement = 'Mechanical mortar contact shall reject a weighted-gap user object that does not support nodal-normal derivatives.'
  []

  [nonnodal_displacement]
    type = RunException
    input = ../3d-mortar-contact/frictionless-mortar-3d.i
    cli_args = 'Variables/disp_x/family=MONOMIAL Variables/disp_x/order=CONSTANT'
    expect_err = 'Nodal-normal derivatives require a nodal displacement variable.'
    max_parallel = 1
    design = 'ComputeWeightedGapLMMechanicalContact.md'
    requirement = 'Mechanical mortar contact shall require nodal displacement variables when constructing nodal-normal derivatives.'
  []

  [cross_system_displacement]
    type = RunException
    input = ../3d-mortar-contact/frictionless-mortar-3d.i
    cli_args = "Problem/nl_sys_names='displaced contact' Variables/disp_x/solver_sys=displaced "
               "Variables/disp_y/solver_sys=contact Variables/disp_z/solver_sys=displaced "
               "Variables/mortar_normal_lm/solver_sys=displaced Constraints/active=normal_lm"
    expect_err = 'Nodal-normal derivatives require displacement variables in the nonlinear system assembled by this contact object.'
    max_parallel = 1
    design = 'ComputeWeightedGapLMMechanicalContact.md'
    requirement = 'Mechanical mortar contact shall reject displacement variables from a different nonlinear system when constructing nodal-normal derivatives.'
  []

  [curved_3d_parallel]
    type = RunApp
    input = curved_3d_action.i
    cli_args = 'Mesh/top_block/nx=2 Mesh/top_block/ny=1 Mesh/top_block/nz=1 Mesh/bottom_block/nx=2 Mesh/bottom_block/ny=1 Mesh/bottom_block/nz=1 Mesh/Partitioner/nx=2 Contact/mortar/formulation=mortar_penalty Contact/mortar/penalty=1e-3 Contact/mortar/penalty_friction=1e-3 ICs/inactive=normal_lm Executioner/nl_abs_tol=1e-4 Executioner/line_search=basic Problem/use_hash_table_matrix_assembly=true'
    expect_out = 'Solve Converged!'
    min_parallel = 2
    max_parallel = 2
    mesh_mode = DISTRIBUTED
    design = 'ContactAction.md PenaltyFrictionUserObject.md AutomaticMortarGeneration.md'
    requirement = 'Distributed three-dimensional mortar-penalty friction shall assemble and solve on a fully overlapping, partitioned QUAD4 interface.'
  []

  [mortar_penalty_friction_jacobian]
    type = PetscJacobianTester
    input = curved_3d_action.i
    cli_args = 'Mesh/top_block/nx=1 Mesh/top_block/ny=1 Mesh/top_block/nz=1 Mesh/bottom_block/nx=2 Mesh/bottom_block/ny=1 Mesh/bottom_block/nz=1 Contact/mortar/formulation=mortar_penalty Contact/mortar/penalty=1e-3 Contact/mortar/penalty_friction=1e-3 ICs/inactive=normal_lm Executioner/nl_abs_tol=1e-4 Problem/error_on_jacobian_nonzero_reallocation=true -snes_test_err 1e-7'
    run_sim = false
    # Projection coordinates and mortar-segment integration geometry remain frozen.
    ratio_tol = 1.1e-5
    difference_tol = 6.5e-5
    max_parallel = 1
    design = 'ContactAction.md PenaltyFrictionUserObject.md'
    requirement = 'Three-dimensional mortar-penalty friction shall include secondary nodal-normal and tangent-basis derivatives and preallocate their fixed-topology one-ring coupling.'
  []

  [mortar_contact_pjfnk]
    type = RunApp
    input = curved_3d_action.i
    cli_args = 'Mesh/top_block/nx=1 Mesh/top_block/ny=1 Mesh/top_block/nz=1 Mesh/bottom_block/nx=2 Mesh/bottom_block/ny=2 Mesh/bottom_block/nz=1 Contact/mortar/model=frictionless Problem/error_on_jacobian_nonzero_reallocation=true Executioner/solve_type=PJFNK Executioner/end_time=0.05 Executioner/dt=0.05'
    expect_out = 'Solve Converged!'
    max_parallel = 1
    design = 'ContactAction.md ComputeWeightedGapLMMechanicalContact.md AutomaticMortarGeneration.md'
    requirement = 'Three-dimensional mortar contact shall support residual-only PJFNK evaluations and explicit preconditioning Jacobians with nodal-normal derivatives.'
  []

  [tri6_normal_derivatives]
    type = RunApp
    input = curved_3d_action.i
    cli_args = 'Mesh/top_block/nx=1 Mesh/top_block/ny=1 Mesh/top_block/nz=1 Mesh/bottom_block/nx=1 Mesh/bottom_block/ny=1 Mesh/bottom_block/nz=1 Mesh/top_block/elem_type=TET10 Mesh/bottom_block/elem_type=TET10 Variables/disp_x/order=SECOND Variables/disp_y/order=SECOND Variables/disp_z/order=SECOND Contact/mortar/model=frictionless Problem/error_on_jacobian_nonzero_reallocation=false Executioner/end_time=0.05 Executioner/dt=0.05 Executioner/line_search=basic'
    expect_out = 'Solve Converged!'
    capabilities = 'ad_size>=200'
    max_parallel = 1
    design = 'ContactAction.md AutomaticMortarGeneration.md'
    requirement = 'Quasistatic mortar contact shall assemble and solve with active TET10 elements and TRI6 interface faces when sufficient AD storage is available.'
  []

  [tri7_normal_derivatives]
    type = RunApp
    input = curved_3d_action.i
    cli_args = 'Mesh/top_block/nx=1 Mesh/top_block/ny=1 Mesh/top_block/nz=1 Mesh/bottom_block/nx=1 Mesh/bottom_block/ny=1 Mesh/bottom_block/nz=1 Mesh/top_block/elem_type=TET14 Mesh/bottom_block/elem_type=TET14 Mesh/top_curve/z_function=z Mesh/bottom_curve/z_function=z Variables/disp_x/order=THIRD Variables/disp_y/order=THIRD Variables/disp_z/order=THIRD Contact/mortar/model=frictionless Problem/error_on_jacobian_nonzero_reallocation=false Executioner/end_time=0.05 Executioner/dt=0.05 Executioner/line_search=basic'
    expect_out = 'Solve Converged!'
    capabilities = 'ad_size>=200'
    max_parallel = 1
    design = 'ContactAction.md AutomaticMortarGeneration.md'
    requirement = 'Quasistatic mortar contact shall execute with active TET14 elements and TRI7 interface faces when sufficient AD storage is available.'
  []

  [hex27_quad9]
    type = RunApp
    input = ../3d-mortar-contact/frictionless-mortar-3d-action.i
    cli_args = 'Mesh/top_block/nx=2 Mesh/top_block/ny=2 Mesh/top_block/nz=1 Mesh/top_block/elem_type=HEX27 Mesh/bottom_block/nx=2 Mesh/bottom_block/ny=2 Mesh/bottom_block/nz=1 Mesh/bottom_block/elem_type=HEX27 Variables/disp_x/order=SECOND Variables/disp_y/order=SECOND Variables/disp_z/order=SECOND Executioner/solve_type=NEWTON Executioner/end_time=0.5 Outputs/exodus=false Outputs/csv=false'
    capabilities = 'ad_size>=200'
    expect_out = 'The number of nodes in contact is [1-9][0-9]*'
    max_parallel = 1
    mesh_mode = REPLICATED
    design = 'ContactAction.md AutomaticMortarGeneration.md'
    requirement = 'Quasistatic mortar contact shall execute with active HEX27 elements and QUAD9 interface faces when sufficient AD storage is available.'
  []
[]
