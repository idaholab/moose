                  'outputs for a monotonic mode-I mortar CZM loading path.'
    rel_err = 1.0e-6
    abs_zero = 1.0e-8
    override_columns = 'jump_t traction_t'
    override_rel_err = '1.0e-6 1.0e-6'
    override_abs_zero = '1.0e-4 1.0e-4'
  []
  [nonpositive_nodal_integral_error]
    type = RunException
    issues = '#34130'
    design = 'userobjects/BilinearMixedModeCohesiveZoneModel.md'
    input = czm_objectivity_3d.i
    cli_args = 'Mesh/bottom/elem_type=HEX20 Mesh/top/elem_type=HEX20 Outputs/csv=false'
    expect_err = 'which is not positive for the QUAD8 secondary faces of this mesh at the active '
                 'finite element order. Set .use_dual = true.'
    requirement = 'The system shall report an error, suggesting the dual basis, if the mortar '
                  'cohesive zone interface has faces whose nodal test functions do not have a '
                  'positive integral.'
  []
  [partly_covered_quadratic_face_error]
    type = RunException
    issues = '#34130'
    design = 'userobjects/BilinearMixedModeCohesiveZoneModel.md'
    input = traction_curve_modeI_3d.i
    cli_args = 'Mesh/base/elem_type=HEX20 Mesh/top/elem_type=HEX20 UserObjects/czm_uo/use_dual=true '
               'Outputs/file_base=partly_covered_quadratic_face_error_out'
    expect_err = 'is only partly covered by the primary surface'
    requirement = 'The system shall report an error if a second-order secondary face of a mortar '
                  'cohesive zone interface is only partly covered by the primary surface.'
  []
  [dual_quadratic_faces]
    type = CSVDiff
    issues = '#34130'
    design = 'userobjects/BilinearMixedModeCohesiveZoneModel.md'
    input = traction_curve_modeI_3d.i
    # The secondary face spans the primary exactly, since a partly covered second-order face is
    # rejected
    cli_args = 'Mesh/base/elem_type=HEX20 Mesh/top/elem_type=HEX20 Mesh/base/xmin=0 Mesh/base/xmax=1 '
               'Mesh/bottom_node/coord="0 0 0" Mesh/bottom_roller_node/coord="1 0 0" '
               'UserObjects/czm_uo/use_dual=true Executioner/dt=0.1 Executioner/end_time=0.3 '
               'Outputs/file_base=dual_quadratic_faces_out'
    csvdiff = dual_quadratic_faces_out.csv
    requirement = 'The system shall compute the mode-I traction of a mortar cohesive zone interface '
                  'with QUAD8 faces, whose standard nodal test functions do not have a positive '
                  'integral, by weighting the mortar integrals with the dual basis.'
    rel_err = 1.0e-6
    abs_zero = 1.0e-8
    override_columns = 'traction_t1 traction_t2'
    override_rel_err = '1.0e-6 1.0e-6'
    override_abs_zero = '1.0e-4 1.0e-4'
