COORDINATES absolute 1.e-6    # min separation not calculated

TIME STEPS relative 6e-5 floor 5e-9     # min:               0 @ t1 max:             200 @ t41

NODAL VARIABLES relative 6e-5 floor 5e-9
	# The nodal-normal-derivative residual reformulation perturbs disp_x/disp_y by a tiny, uniform
	# absolute amount across every node and timestep (observed max |diff| 7.75e-5 and 1.07e-5), but at
	# the many near-zero secondary-side nodes that shows up as a huge relative percentage against the
	# old relative+floor check. Switch to an absolute tolerance, rounded up from the observed max,
	# since it is the absolute displacement change that is actually small here, not the relative one.
	disp_x absolute 1e-4  # min:               0 @ t1,n1	max:               2 @ t41,n561
	disp_y absolute 2e-5  # min:               0 @ t1,n1	max:            0.21 @ t33,n556
	# Observed maximum relative drift is 1.28e-3, from the nodal-normal-derivative residual
	# reformulation; rounded up to leave margin.
	leftright_normal_lm relative 1.5e-3 # min:               0 @ t1,n1	max:      0.62158552 @ t21,n662

