[Tests]
  issues = '#15215'
  design = 'ContactAction.md VariableCondensationPreconditioner.md'
  [dm_contact]
    type = 'CSVDiff'
    input = 'dm_mechanical_contact.i'
    csvdiff = 'dual_mortar_frictionless_contact_out.csv'
    rel_err = 1e-4
    cli_args = 'Contact/leftright/use_dual=true '
               'Outputs/file_base=dual_mortar_frictionless_contact_out'
    requirement = 'The system shall converge and match the solution produced by standard mortar '
                  'contact.'
    allow_warnings = true
    mesh_mode = REPLICATED
  []
  [std_contact]
    type = 'CSVDiff'
    input = 'dm_mechanical_contact.i'
    csvdiff = 'std_mortar_frictionless_contact_out.csv'
    rel_err = 1e-4
    cli_args = 'Contact/leftright/use_dual=false '
               'Outputs/file_base=std_mortar_frictionless_contact_out'
    requirement = 'The system shall converge and match the solution produced by dual mortar contact.'
    allow_warnings = true
    mesh_mode = REPLICATED
  []
  [dm_contact_precon]
    type = 'CSVDiff'
    input = 'dm_mechanical_contact_precon.i'
    csvdiff = 'dual_mortar_frictionless_contact_out.csv'
    rel_err = 1e-4
    cli_args = 'Outputs/file_base=dual_mortar_frictionless_contact_out '
               'Preconditioning/vcp/adaptive_condensation=true'
    requirement = 'The system shall converge and match the solution with the standard methods using '
                  'variable condenstation with AMG.'
    allow_warnings = true
    mesh_mode = REPLICATED
    # uses same output name
    prereq = 'dm_contact'
  []
  [dm_contact_precon_no_adaptivity]
    type = 'CSVDiff'
    input = 'dm_mechanical_contact_precon.i'
    csvdiff = 'dual_mortar_frictionless_contact_out.csv'
    rel_err = 1e-4
    cli_args = 'Outputs/file_base=dual_mortar_frictionless_contact_out '
               'Preconditioning/vcp/adaptive_condensation=false'
    requirement = 'The system shall converge and match the solution with the standard methods using '
                  'variable condenstation with AMG, by always condensing out the LMs.'
    allow_warnings = true
    mesh_mode = REPLICATED
    prereq = 'dm_contact_precon'
  []
  [dm_contact_precon_full_dinv]
    type = 'CSVDiff'
    input = 'dm_mechanical_contact_precon.i'
    csvdiff = 'dual_mortar_frictionless_contact_out.csv'
    rel_err = 1e-4
    cli_args = 'Outputs/file_base=dual_mortar_frictionless_contact_out '
               'Preconditioning/vcp/is_lm_coupling_diagonal=false'
    requirement = 'The system shall converge and match the solution with the standard methods using '
                  'variable condenstation with AMG, by using LU to solve for the LM variable (not '
                  'assuming diagonal coupling with the primal variable).'
    allow_warnings = true
    mesh_mode = REPLICATED
    prereq = 'dm_contact_precon_no_adaptivity'
  []

  [force_balance]
    design = 'ContactAction.md NormalMortarMechanicalContact.md'
    issues = '#33657'
    requirement = 'Mortar mechanical contact shall transmit equal and opposite forces across a '
                  'curved interface.'
    # abs_zero checks the normalized force imbalance against zero.
    [dual]
      type = 'CSVDiff'
      input = 'mortar_mechanical_contact_force_balance.i'
      csvdiff = 'dual_mortar_force_balance.csv'
      abs_zero = 1e-8
      cli_args = 'Contact/leftright/use_dual=true '
                 'Outputs/file_base=dual_mortar_force_balance'
      detail = 'The forces shall balance with a dual (biorthogonal) Lagrange multiplier basis.'
    []
    [standard]
      type = 'CSVDiff'
      input = 'mortar_mechanical_contact_force_balance.i'
      csvdiff = 'std_mortar_force_balance.csv'
      abs_zero = 1e-8
      cli_args = 'Contact/leftright/use_dual=false '
                 'Outputs/file_base=std_mortar_force_balance'
      detail = 'The forces shall balance with a standard Lagrange multiplier basis.'
    []
    [penalty]
      type = 'CSVDiff'
      input = 'mortar_mechanical_contact_force_balance.i'
      csvdiff = 'penalty_mortar_force_balance.csv'
      abs_zero = 1e-8
      # Match the penalty scale to the bulk stiffness while retaining robust convergence.
      cli_args = 'Contact/leftright/formulation=mortar_penalty Contact/leftright/penalty=1e6 '
                 'Outputs/file_base=penalty_mortar_force_balance'
      detail = 'The forces shall balance with a penalty formulation.'
    []
  []

  [augmented_lagrange_recover]
    type = 'CSVDiff'
    input = 'mortar_mechanical_contact_force_balance.i'
    csvdiff = 'augmented_lagrange_mortar_force_balance.csv'
    # The contact force depends on the normal Lagrange multipliers carried between time steps, so
    # it changes on recover if they are not restored.
    cli_args = 'Contact/leftright/formulation=mortar_penalty Contact/leftright/penalty=1e6 '
               'Problem/type=AugmentedLagrangianContactProblem '
               'Contact/leftright/al_penetration_tolerance=1e-3 Executioner/line_search=none '
               'Executioner/nl_max_its=50 Outputs/comp/show=secondary_force_x '
               'Outputs/file_base=augmented_lagrange_mortar_force_balance'
    issues = '#34127'
    design = 'PenaltyWeightedGapUserObject.md'
    requirement = 'The system shall restore the augmented Lagrange normal contact multipliers of a '
                  'mortar penalty contact interface when recovering a transient simulation.'
  []

  [force_balance_friction]
    design = 'ContactAction.md NormalMortarMechanicalContact.md'
    issues = '#33378'
    requirement = 'Mortar mechanical contact shall transmit equal and opposite forces across a '
                  'curved, frictional interface.'
    # The penalty formulation checks normal and tangential force balance without PDASS active-set
    # parameters.
    [penalty]
      type = 'CSVDiff'
      input = 'mortar_mechanical_contact_force_balance_friction.i'
      csvdiff = 'penalty_mortar_force_balance_friction.csv'
      abs_zero = 1e-8
      cli_args = 'Contact/leftright/formulation=mortar_penalty Contact/leftright/penalty=1e6 '
                 'Contact/leftright/penalty_friction=1e5 '
                 'Outputs/file_base=penalty_mortar_force_balance_friction'
      detail = 'The normal and frictional forces shall balance with a penalty formulation.'
    []
  []

  [friction_recover]
    type = 'CSVDiff'
    input = 'mortar_mechanical_contact_force_balance_friction.i'
    csvdiff = 'penalty_mortar_friction_recover.csv'
    # The contact force depends on the tangential traction carried between time steps, so it
    # changes on recover if that history is not restored.
    cli_args = 'Contact/leftright/formulation=mortar_penalty Contact/leftright/penalty=1e6 '
               'Contact/leftright/penalty_friction=1e5 Outputs/comp/show=secondary_force_x '
               'Outputs/file_base=penalty_mortar_friction_recover'
    issues = '#34127'
    design = 'PenaltyFrictionUserObject.md'
    requirement = 'The system shall restore the tangential traction history of a mortar penalty '
                  'frictional contact interface when recovering a transient simulation.'
  []
[]
