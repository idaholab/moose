# Regression tests for the transformed dual basis on higher-order (TRI6/QUAD8) mortar
# secondary faces, all driven from transformed-dual-vcp-3d.i (a node-conforming
# BreakMeshByBlock interface promoted to second order via ElementOrderConversionGenerator).
#
# The QUAD8 (HEX20) case runs at the default AD size. The TET10 case fan-splits each
# interface square into four TRI6 triangles, so its mortar residual needs a larger
# derivative container and is gated ad_size>=100 (larger-AD recipe only); at default AD the
# TRI6 transform is covered at the coefficient level by the TransformedDualBasisTest unit test.

[Tests]
  issues = '#33558'
  design = 'Transformed_dual_basis_for_higher_order_mortar.md'
  [patch]
    requirement = 'The system shall recover a spatially uniform mortar contact pressure using the '
                  'locally quadratic transformed dual basis on a node-conforming higher-order '
                  'secondary contact face discretized with '
    [tet10]
      type = 'CSVDiff'
      input = 'transformed-dual-vcp-3d.i'
      cli_args = 'Mesh/gen/elem_type=TET4 '
                 'Outputs/file_base=transformed-dual-vcp-3d_tet10_out'
      csvdiff = 'transformed-dual-vcp-3d_tet10_out.csv'
      abs_zero = 1.0e-8
      # The fan-split TRI6 interface couples each secondary triangle to several primary
      # triangles, so the mortar residual needs >64 AD derivatives; 100 is safe headroom.
      # The gold is solution-based, so it holds for any build meeting this threshold.
      capabilities = 'ad_size>=100'
      detail = 'TRI6 faces on a TET10 volume mesh.'
    []
  []
  [vcp]
    design = 'Transformed_dual_basis_for_higher_order_mortar.md VariableCondensationPreconditioner.md'
    requirement = 'The system shall precondition the transformed dual mortar Lagrange multiplier '
                  'with the variable condensation preconditioner by '
    [exact]
      type = 'CSVDiff'
      input = 'transformed-dual-vcp-3d.i'
      csvdiff = 'transformed-dual-vcp-3d_out.csv'
      abs_zero = 1.0e-8
      detail = 'inverting the non-diagonal coupling matrix exactly to recover the uniform contact '
               'pressure, and'
    []
    [diagonal_warning]
      type = 'RunApp'
      input = 'transformed-dual-vcp-3d.i'
      cli_args = 'Preconditioning/vcp/is_lm_coupling_diagonal=true'
      expect_out = 'non-diagonal coupling matrix D'
      # The guardrail only warns (the diagonal inverse degrades the preconditioner but the
      # solve still converges); allow_warnings lets it through testroot's allow_warnings = false.
      allow_warnings = true
      detail = 'warning that a diagonal-only coupling inverse degrades the preconditioner when the '
               'transformed coupling matrix is not diagonal.'
    []
  []
[]
