[Tests]
  issues = '#9972'
[./equilibrium_without_action]
  type = 'Exodiff'
  input = 'equilibrium_without_action.i'
  exodiff = 'equilibrium_out.e'
  design = 'AddCoupledEqSpeciesAction.md'
  requirement = 'The system shall be able to solve an aqueous equilibrium reaction system that is set up explicitly, without using the parsing action, to provide a reference solution for the parser test.'
[../]
[./equilibrium_action]
  type = 'Exodiff'
  input = 'equilibrium_action.i'
  exodiff = 'equilibrium_out.e'
  prereq = equilibrium_without_action
  design = 'AddCoupledEqSpeciesAction.md'
  requirement = 'The system shall be able to parse a comma delimited list of aqueous equilibrium reactions and reproduce the solution obtained without using the parsing action.'
[../]
