[Tests]
  design = 'NSLiquidFractionAux.md NSFVPhaseChangeSource.md NSFVMixtureFunctorMaterial.md'
  issues = '#23357'
  [gallium_melting]
    type = RunApp
    input = 'gallium_melting.i'
    cli_args = "Nx=20 Ny=10 Executioner/num_steps=10"
    requirement = 'The system shall be able to simulate the melting of gallium.'
    heavy = true
  []
  [gallium_melting_linearfv]
    type = RunApp
    input = 'gallium_melting_linear.i'
    cli_args = "Nx=20 Ny=12 Executioner/end_time=0.01 Mesh/gen/bias_x=1.0"
    requirement = 'The system shall be able to simulate the melting of gallium using the LinearFV system.'
    heavy = true
  []
  [gallium_melting_physics]
    type = RunApp
    input = 'gallium_melting-physics.i'
    cli_args = "Nx=20 Ny=10"
    requirement = 'The system shall be able to simulate the melting of gallium using the Navier Stokes physics syntax.'
    heavy = true
  []
  [stefan_phasechange_problem]
    type = RunApp
    input = '1d_stefan_T.i'
    requirement = 'Stefan melting analytical problem for the LinearFV phase change model.'
    heavy = true
  []

