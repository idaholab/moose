[Tests]
  design = 'LinearFVPressureCorrectionDiffusionJump.md LinearPWCNSFVMomentumFlux.md '
           'FVPressureJumpGreenGaussGradient.md'
  issues = '#31995'

  [orthogonal_isotropic]
    type = GoogleTest
    unit_test = PressureJumpInterface.OrthogonalIsotropic
    requirement = 'The system shall compute the half-cell conductances and interface transmissibility for orthogonal isotropic diffusion without a nonorthogonal correction.'
  []
  [conserves_flux_and_preserves_jump]
    type = GoogleTest
    unit_test = PressureJumpInterface.ConservesFluxAndPreservesJump
    requirement = 'The system shall construct pressure-jump interface coefficients that conserve the flux through both half cells while preserving the prescribed pressure jump.'
  []
  [orientation_reversal]
    type = GoogleTest
    unit_test = PressureJumpInterface.OrientationReversal
    requirement = 'The system shall preserve the pressure-jump interface coefficients and reverse the flux sign when the interface orientation and element-neighbor ordering are reversed.'
  []
  [rejects_invalid_geometry_and_coefficients]
    type = GoogleTest
    unit_test = PressureJumpInterface.RejectsInvalidGeometryAndCoefficients
    requirement = 'The system shall reject pressure-jump interface data with a nonpositive projected half-cell distance, a nonpositive or nonfinite normal mobility, or a zero face area.'
  []
  [manufactured_piecewise_linear_pressure]
    type = GoogleTest
    unit_test = PressureJumpInterface.ManufacturedPiecewiseLinearPressure
    requirement = 'The system shall recover the conservative flux and both one-sided pressures for a manufactured piecewise-linear pressure field across an anisotropic interface.'
  []
  [hydrostatic_balance_across_jump]
    type = GoogleTest
    unit_test = PressureJumpInterface.HydrostaticBalanceAcrossJump
    requirement = 'The system shall weight the one-sided H/A fluxes with the half-cell conductances so that a fluid at rest, with a body force balanced by the pressure gradient on each side of a pressure-jump interface, has zero face mass flux and the one-sided linear face pressures.'
  []
[]
