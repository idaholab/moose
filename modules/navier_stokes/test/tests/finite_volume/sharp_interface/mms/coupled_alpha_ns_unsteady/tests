[Tests]
  design = 'INTERFOAM_PARITY_IMPLEMENTATION_PLAN.md'
  [unsteady_coupled_alpha_ns]
    type = MMSTest
    input = 'test.py'
    test_case = TestUnsteadyCoupledAlphaNS
    requirement = 'The split reduced-pressure sharp-interface finite-volume solver shall exhibit second-order spatial convergence in alpha, velocity, and the reconstructed pressure-coupled velocity correction for a smooth one-step unsteady manufactured solution that couples alpha transport to rho(alpha) and mu(alpha) in the momentum-pressure solve.'
  []
  [unsteady_coupled_alpha_ns_mules]
    type = MMSTest
    input = 'test_mules.py'
    test_case = TestUnsteadyCoupledAlphaNSMULES
    requirement = 'The split reduced-pressure sharp-interface finite-volume solver shall support a MULES-enabled manufactured sharp-interface bounded-transport path with rho(alpha)-coupled momentum, bounded alpha, convergent interface-position and mass diagnostics, and convergent coupled alpha, velocity, and rho errors for the zero-compression variant.'
  []
