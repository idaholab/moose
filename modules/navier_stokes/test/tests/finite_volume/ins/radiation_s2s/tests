[Tests]
  design = 'LinearFVGrayLambert.md'
  issues = '#33641'

  [radiation_s2s_linearfv_noaction_simple]
    type = Exodiff
    input = 'radiative_transfer_no_action_linearfv_simple.i'
    exodiff = 'radiative_transfer_no_action_linearfv_simple_out.e'
    mesh_mode = REPLICATED # RadiationTransferAction does not allow distributed mesh
    requirement = 'The system shall be able to solve surface-to-surface radiation with LinearFV system and SIMPLE solver.'
    issues = '#33641'
  []

  [parallel_plates_convergence]
    type = MMSTest
    input = mms_spatial.py
    test_case = TestGrayLambertParallelPlates
    requirement = 'The system shall demonstrate first-order spatial convergence of the surface temperatures and radiative heat fluxes for two conducting slabs exchanging gray diffuse radiation when solved with SIMPLE.'
  []
[]
