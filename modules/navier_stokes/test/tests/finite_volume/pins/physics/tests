[Tests]
  issues = '#27502'
  design = 'navier_stokes/pinsfv.md PNSFVSolidHeatTransferPhysics.md'
  [solid-only]
    type = 'Exodiff'
    input = solid_phase_alone.i
    exodiff = solid_phase_alone_out.e
    requirement = 'The system shall be able to model a heated porous solid phase.'
  []
  [solid_and_fluid]
    type = 'Exodiff'
    input = heated_porous_medium.i
    exodiff = heated_porous_medium_out.e
    requirement = 'The system shall be able to model heated flow in a porous medium with convection between phases.'
  []
  [effective-solid-conductivity]
    requirement = 'The system shall use the solid thermal conductivity of a porous medium as an effective conductivity, so that the steady conduction temperature rise in a heated porous solid does not depend on the porosity, for a porosity of'
    issues = '#34448'
    [low-porosity]
      type = 'CSVDiff'
      input = solid_conduction_porosity.i
      csvdiff = 'solid_conduction_porosity_out.csv'
      detail = '0.25 and'
    []
    [high-porosity]
      type = 'CSVDiff'
      input = solid_conduction_porosity.i
      csvdiff = 'solid_conduction_porosity_out.csv'
      cli_args = 'porosity=0.75'
      prereq = 'effective-solid-conductivity/low-porosity'
      detail = '0.75.'
    []
  []
  [linear-solid-conductivity]
    requirement = 'The system shall use the solid thermal conductivity of a porous medium as an effective conductivity in the linear finite volume solid energy equation, so that the steady conduction temperature rise in a heated porous solid does not depend on the porosity, for a porosity of'
    design = 'PNSLinearFVSolidHeatTransferPhysics.md'
    issues = '#31995 #34448'
    [low-porosity]
      type = 'CSVDiff'
      input = solid_conduction_porosity_linear.i
      csvdiff = 'solid_conduction_porosity_linear_out.csv'
      detail = '0.25 and'
    []
    [high-porosity]
      type = 'CSVDiff'
      input = solid_conduction_porosity_linear.i
      csvdiff = 'solid_conduction_porosity_linear_out.csv'
      cli_args = 'porosity=0.75'
      prereq = 'linear-solid-conductivity/low-porosity'
      detail = '0.75.'
    []
  []
  [linear-solid-anisotropic-conductivity]
    requirement = 'The system shall support an anisotropic effective solid thermal conductivity in the linear finite volume solid energy equation of a porous medium'
    design = 'PNSLinearFVSolidHeatTransferPhysics.md LinearFVAnisotropicDiffusion.md'
    issues = '#31995'
    [conduction]
      type = 'CSVDiff'
      input = solid_conduction_anisotropic_linear.i
      csvdiff = 'solid_conduction_anisotropic_linear_out.csv'
      detail = 'matching the analytical temperature rise of a heated slab conducting along its high-conductivity direction, and'
    []
    [heat-flux]
      type = 'CSVDiff'
      input = solid_conduction_anisotropic_linear.i
      csvdiff = 'solid_conduction_anisotropic_linear_heat_flux.csv'
      cli_args = "Physics/NavierStokes/SolidHeatTransferSegregated/solid/heat_flux_boundaries='top' "
                 "Physics/NavierStokes/SolidHeatTransferSegregated/solid/boundary_heat_fluxes='100' "
                 "Outputs/file_base=solid_conduction_anisotropic_linear_heat_flux"
      detail = 'matching the analytical temperature rise when a heat flux is also imposed on the boundary opposite the fixed temperature.'
    []
  []
  [linear-solid-variable-cp]
    type = 'CSVDiff'
    input = solid_heating_variable_cp_linear.i
    csvdiff = 'solid_heating_variable_cp_linear_out.csv'
    requirement = 'The system shall conserve the enthalpy of a stationary porous solid with a temperature-dependent specific heat in the linear finite volume solid energy equation, matching the analytical temperature of a uniformly heated insulated solid.'
    design = 'PNSLinearFVSolidHeatTransferPhysics.md'
    issues = '#31995'
  []
[]
