[Tests]
  issues = '#27502'
  design = 'navier_stokes/pinsfv.md PNSFVSolidHeatTransferPhysics.md'
  [solid-only]
    type = 'Exodiff'
    input = solid_phase_alone.i
    exodiff = solid_phase_alone_out.e
    requirement = 'The system shall be able to model a heated porous solid phase.'
  []
  [solid_and_fluid]
    type = 'Exodiff'
    input = heated_porous_medium.i
    exodiff = heated_porous_medium_out.e
    requirement = 'The system shall be able to model heated flow in a porous medium with convection between phases.'
  []
  [effective-solid-conductivity]
    requirement = 'The system shall use the solid thermal conductivity of a porous medium as an effective conductivity, so that the steady conduction temperature rise in a heated porous solid does not depend on the porosity, for a porosity of'
    issues = '#34448'
    [low-porosity]
      type = 'CSVDiff'
      input = solid_conduction_porosity.i
      csvdiff = 'solid_conduction_porosity_out.csv'
      detail = '0.25 and'
    []
    [high-porosity]
      type = 'CSVDiff'
      input = solid_conduction_porosity.i
      csvdiff = 'solid_conduction_porosity_out.csv'
      cli_args = 'porosity=0.75'
      prereq = 'effective-solid-conductivity/low-porosity'
      detail = '0.75.'
    []
  []
  [intrinsic-solid-conductivity]
    type = 'CSVDiff'
    input = solid_conduction_porosity.i
    csvdiff = 'solid_conduction_porosity_out.csv'
    # The pure solid conductivity 2 times the solid fraction 0.5 is the effective conductivity 1
    cli_args = "porosity=0.5 Physics/NavierStokes/SolidHeatTransfer/solid/effective_conductivity=false "
               "FunctorMaterials/constants/prop_values='2 1000 1000'"
    prereq = 'effective-solid-conductivity/high-porosity'
    requirement = 'The system shall multiply the conductivity of the pure solid by the solid fraction of a porous medium when the solid thermal conductivity is not an effective conductivity.'
    issues = '#34448'
  []
[]
