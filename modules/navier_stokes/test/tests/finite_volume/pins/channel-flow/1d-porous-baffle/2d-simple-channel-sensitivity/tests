[Tests]
  [param-study]
    type = 'CSVDiff'
    input = porous-baffle-2d-param-study.i
    csvdiff = 'porous-baffle-2d-param-study_out.csv porous-baffle-2d-param-study_out_p_line_0001.csv porous-baffle-2d-param-study_out_u_line_0001.csv'
    requirement = 'The system shall preserve the pressure drop and centerline profiles for a parameterized porous baffle case with configurable inlet velocity, form loss, and Forchheimer friction.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md LinearFVMomentumFriction.md'
    recover = false
    max_threads = 1
    allow_warnings = true
  []
  [param-study-pressure-two-term]
    type = 'CSVDiff'
    input = porous-baffle-2d-param-study.i
    csvdiff = 'porous-baffle-2d-param-study-pressure-two-term_out.csv'
    requirement = 'The system shall preserve the parameterized porous baffle integral response when using the two-term pressure expansion.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md FVReconstructedPressureGradient.md'
    cli_args = "LinearFVKernels/p_diffusion/use_two_term_pressure_expansion=true "
               "Outputs/file_base=porous-baffle-2d-param-study-pressure-two-term_out"
    recover = false
    max_threads = 1
    allow_warnings = true
  []
[]
