[Tests]
  [linear]
    type = 'CSVDiff'
    input = porous-baffle-2d.i
    csvdiff = 'porous-baffle-2d_out.csv'
    requirement = 'The system shall preserve the two-dimensional porous baffle pressure jump, zero transverse leakage, and non-oscillatory centerline velocity profile using the linear finite volume SIMPLE solve.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md LinearFVMomentumFriction.md'
    cli_args = ''
    recover = false
    max_threads = 1
    allow_warnings = true
    abs_zero = 1e-8
  []
  [linear-pressure-two-term]
    type = 'CSVDiff'
    input = porous-baffle-2d.i
    csvdiff = 'porous-baffle-2d-pressure-two-term_out.csv'
    requirement = 'The system shall preserve the two-dimensional porous baffle integral pressure and velocity response when using the two-term pressure expansion.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md FVReconstructedPressureGradient.md'
    cli_args = "LinearFVKernels/p_diffusion/use_two_term_pressure_expansion=true "
               "Outputs/file_base=porous-baffle-2d-pressure-two-term_out"
    recover = false
    max_threads = 1
    allow_warnings = true
    abs_zero = 1e-8
  []

  [insfv]
    type = 'CSVDiff'
    input = porous-baffle-2d-insfv.i
    csvdiff = 'porous-baffle-2d-insfv_out.csv'
    requirement = 'The system shall preserve the two-dimensional porous baffle pressure jump and centerline velocity profile using the nonlinear incompressible finite volume solve.'
    design = 'PINSFVRhieChowInterpolator.md BernoulliPressureVariable.md PINSFVMomentumFriction.md'
    cli_args = ''
    recover = false
    max_threads = 1
    allow_warnings = true
  []
[]
