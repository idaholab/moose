    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-pressure-two-term.csv'
    requirement = 'The system shall preserve the viscous zero-gradient one-dimensional porous baffle pressure solution when using the two-term pressure expansion.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md FVReconstructedPressureGradient.md'
    cli_args = "forcheimer_value=0 mu=1 "
