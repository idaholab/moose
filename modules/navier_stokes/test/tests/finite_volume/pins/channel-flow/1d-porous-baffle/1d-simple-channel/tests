    design = 'SIMPLE.md PorousRhieChowMassFlux.md LinearFVMomentumFriction.md'
    cli_args = "forcheimer_value=50 mu=1 Outputs/file_base=linear-bernoulli-forcheimer-form-loss "
               "UserObjects/rc/baffle_form_loss='10 10'"
    recover = false
    max_threads = 1
    allow_warnings = true
  []

  [linear-bernoulli-no-visc-pressure-two-term]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-no-visc-pressure-two-term.csv'
    requirement = 'The system shall preserve the zero-gradient one-dimensional porous baffle pressure solution when using the two-term pressure expansion.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md FVReconstructedPressureGradient.md'
    cli_args = "forcheimer_value=0 "
               "LinearFVKernels/p_diffusion/use_two_term_pressure_expansion=true "
