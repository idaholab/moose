[Tests]
  [linear-bernoulli-no-visc]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-no-visc.csv'
    requirement = 'The system shall preserve the one-dimensional porous baffle Bernoulli pressure jump and the non-oscillatory superficial velocity profile using the linear finite volume SIMPLE solve.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md LinearFVMomentumFriction.md'
    cli_args = 'forcheimer_value=0 Outputs/file_base=linear-bernoulli-no-visc'
    recover = false
    max_threads = 1
    allow_warnings = true
  []
  [linear-bernoulli]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli.csv'
    requirement = 'The system shall preserve the one-dimensional porous baffle Bernoulli pressure jump and the non-oscillatory superficial velocity profile using the linear finite volume SIMPLE solve.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md LinearFVMomentumFriction.md'
    cli_args = 'forcheimer_value=0 mu=1 Outputs/file_base=linear-bernoulli'
    recover = false
    max_threads = 1
    allow_warnings = true
  []
  [linear-bernoulli-forcheimer]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-forcheimer.csv'
    requirement = 'The system shall preserve the one-dimensional porous baffle Bernoulli pressure jump and the non-oscillatory superficial velocity profile using the linear finite volume SIMPLE solve.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md LinearFVMomentumFriction.md'
    cli_args = 'forcheimer_value=50 mu=1 Outputs/file_base=linear-bernoulli-forcheimer'
    recover = false
    max_threads = 1
    allow_warnings = true
  []
