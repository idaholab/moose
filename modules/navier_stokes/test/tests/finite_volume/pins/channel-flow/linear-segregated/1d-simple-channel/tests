[Tests]
  issues = '#31995'
  [linear-bernoulli-no-visc]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-no-visc.csv'
    requirement = 'The system shall preserve the one-dimensional porous baffle Bernoulli jumps and constant superficial velocity without volumetric friction.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md BernoulliFormLossPressureJump.md LinearFVMomentumFriction.md LinearPWCNSFVMomentumPressure.md'
    cli_args = 'forchheimer_value=0 Outputs/file_base=linear-bernoulli-no-visc'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [linear-bernoulli-forchheimer]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-forchheimer.csv'
    requirement = 'The system shall add the one-dimensional Forchheimer pressure drop while preserving the porous baffle jumps and constant superficial velocity.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md BernoulliFormLossPressureJump.md LinearFVMomentumFriction.md LinearPWCNSFVMomentumPressure.md'
    cli_args = 'forchheimer_value=50 mu=1 Outputs/file_base=linear-bernoulli-forchheimer'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [linear-bernoulli-forchheimer-form-loss]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'linear-bernoulli-forchheimer-form-loss.csv'
    requirement = 'The system shall add Forchheimer and irreversible baffle form losses while preserving constant one-dimensional superficial velocity.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md BernoulliFormLossPressureJump.md LinearFVMomentumFriction.md LinearPWCNSFVMomentumPressure.md'
    cli_args = "forchheimer_value=50 mu=1 Outputs/file_base=linear-bernoulli-forchheimer-form-loss "
               "UserObjects/pressure_jump/form_loss='10 10'"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [form-loss-reference-lower-higher]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'form-loss-reference-lower-higher.csv'
    requirement = 'The system shall evaluate the irreversible baffle form loss with the lower-porosity velocity on the first baffle and the higher-porosity velocity on the second baffle, where both reference sides are the element side of the face.'
    design = 'BernoulliFormLossPressureJump.md'
    cli_args = "forchheimer_value=50 mu=1 Outputs/file_base=form-loss-reference-lower-higher "
               "UserObjects/pressure_jump/form_loss='10 10' "
               "UserObjects/pressure_jump/reference_velocity_side='lower_porosity higher_porosity'"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [form-loss-reference-higher-lower]
    type = 'CSVDiff'
    input = porous-baffle-1d.i
    csvdiff = 'form-loss-reference-higher-lower.csv'
    requirement = 'The system shall evaluate the irreversible baffle form loss with the higher-porosity velocity on the first baffle and the lower-porosity velocity on the second baffle, where both reference sides are the neighbor side of the face.'
    design = 'BernoulliFormLossPressureJump.md'
    cli_args = "forchheimer_value=50 mu=1 Outputs/file_base=form-loss-reference-higher-lower "
               "UserObjects/pressure_jump/form_loss='10 10' "
               "UserObjects/pressure_jump/reference_velocity_side='higher_porosity lower_porosity'"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []

  [reject-ordinary-velocity-gradient]
    type = RunException
    input = porous-baffle-1d.i
    cli_args = 'Variables/superficial_u/gradient_method=green-gauss'
    expect_err = "Velocity variable 'superficial_u' must use FVVelocityJumpGreenGaussGradient as its default gradient method"
    requirement = 'The system shall reject ordinary Green-Gauss as the velocity variable gradient when internal pressure jumps are present.'
    design = 'FVVelocityJumpGreenGaussGradient.md PorousRhieChowMassFlux.md'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []

  [reject-ordinary-pressure-gradient]
    type = RunException
    input = porous-baffle-1d.i
    cli_args = 'Variables/pressure/gradient_method=green-gauss'
    expect_err = "Pressure variable 'pressure' must use FVPressureJumpGreenGaussGradient as its default gradient method"
    requirement = 'The system shall reject ordinary Green-Gauss as the pressure variable gradient when internal pressure jumps are present.'
    design = 'FVPressureJumpGreenGaussGradient.md PorousRhieChowMassFlux.md'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []

  [reject-ordinary-coupling-gradient]
    type = RunException
    input = porous-baffle-1d.i
    cli_args = 'LinearFVKernels/u_pressure/gradient_method=green-gauss'
    expect_err = "must use the pressure variable's FVPressureJumpGreenGaussGradient or an FVReconstructedPressureGradient based on it"
    requirement = 'The system shall reject ordinary Green-Gauss for pressure-momentum coupling across an internal pressure jump.'
    design = 'FVPressureJumpGreenGaussGradient.md PorousRhieChowMassFlux.md'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [form-loss-owner-elem-left-to-right]
    type = 'CSVDiff'
    input = form-loss-orientation.i
    csvdiff = 'form-loss-owner-elem-left-to-right.csv'
    requirement = 'The system shall apply the irreversible form-loss sign from owner to non-owner when the FaceInfo element owns the jump and the flow travels left to right.'
    design = 'BernoulliFormLossPressureJump.md porous_rhie_chow_baffle.md'
    issues = '#31995'
    cli_args = 'Outputs/file_base=form-loss-owner-elem-left-to-right'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [form-loss-owner-elem-right-to-left]
    type = 'CSVDiff'
    input = form-loss-orientation.i
    csvdiff = 'form-loss-owner-elem-right-to-left.csv'
    requirement = 'The system shall apply the irreversible form-loss sign from owner to non-owner when the FaceInfo element owns the jump and the flow travels right to left.'
    design = 'BernoulliFormLossPressureJump.md porous_rhie_chow_baffle.md'
    issues = '#31995'
    cli_args = "inlet_u=-0.1 velocity_inlet_boundary=right pressure_outlet_boundary=left direction=-1 Outputs/file_base=form-loss-owner-elem-right-to-left"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [form-loss-owner-neighbor-left-to-right]
    type = 'CSVDiff'
    input = form-loss-orientation.i
    csvdiff = 'form-loss-owner-neighbor-left-to-right.csv'
    requirement = 'The system shall apply the irreversible form-loss sign from owner to non-owner when the FaceInfo neighbor owns the jump and the flow travels left to right.'
    design = 'BernoulliFormLossPressureJump.md porous_rhie_chow_baffle.md'
    issues = '#31995'
    cli_args = "primary_block=2 paired_block=1 Outputs/file_base=form-loss-owner-neighbor-left-to-right"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
  [form-loss-owner-neighbor-right-to-left]
    type = 'CSVDiff'
    input = form-loss-orientation.i
    csvdiff = 'form-loss-owner-neighbor-right-to-left.csv'
    requirement = 'The system shall apply the irreversible form-loss sign from owner to non-owner when the FaceInfo neighbor owns the jump and the flow travels right to left.'
    design = 'BernoulliFormLossPressureJump.md porous_rhie_chow_baffle.md'
    issues = '#31995'
    cli_args = "primary_block=2 paired_block=1 inlet_u=-0.1 velocity_inlet_boundary=right pressure_outlet_boundary=left direction=-1 Outputs/file_base=form-loss-owner-neighbor-right-to-left"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
[]
