  [jump-gradient-multiple-variables]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "Problem/linear_sys_names='u_system pressure_system s_system' "
               "Variables/s1/type=MooseLinearVariableFVReal Variables/s1/solver_sys=s_system "
               "Variables/s1/gradient_method=jump_aware "
               "Variables/s2/type=MooseLinearVariableFVReal Variables/s2/solver_sys=s_system "
               "Variables/s2/gradient_method=jump_aware "
               "LinearFVKernels/s1_diffusion/type=LinearFVDiffusion "
               "LinearFVKernels/s1_diffusion/variable=s1 "
               "LinearFVKernels/s2_diffusion/type=LinearFVDiffusion "
               "LinearFVKernels/s2_diffusion/variable=s2 "
               "LinearFVKernels/active='u_advection u_pressure p_diffusion HbyA_divergence "
               "s1_diffusion s2_diffusion' "
               "Executioner/passive_scalar_systems=s_system "
               "Executioner/passive_scalar_equation_relaxation=1 "
               "Executioner/passive_scalar_absolute_tolerance=1e-8 Executioner/num_iterations=1"
    expect_err = "must be used by exactly one pressure variable, but it is used by 2"
    requirement = 'The system shall reject a pressure-jump Green-Gauss gradient method that is shared by more than one variable.'
    design = 'FVPressureJumpGreenGaussGradient.md'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
  []
