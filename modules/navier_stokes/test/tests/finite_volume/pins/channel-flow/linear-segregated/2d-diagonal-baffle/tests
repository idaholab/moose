[Tests]
  issues = '#31995'
  [straight-diagonal]
    type = 'CSVDiff'
    input = porous-baffle-straight-diagonal.i
    csvdiff = 'porous-baffle-straight-diagonal_out.csv porous-baffle-straight-diagonal_out_horizontal_profile_0001.csv porous-baffle-straight-diagonal_out_skew_pressure_profile_0001.csv porous-baffle-straight-diagonal_out_v_y_left_of_interface_0001.csv porous-baffle-straight-diagonal_out_v_y_right_of_interface_0001.csv'
    requirement = 'The system shall preserve pressure and velocity profiles across a straight channel with a diagonal porous baffle form-loss jump without introducing transverse velocity oscillations.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md BernoulliFormLossPressureJump.md '
             'FVPressureJumpGreenGaussGradient.md LinearFVPressureCorrectionDiffusionJump.md '
             'LinearFVMomentumFriction.md LinearPWCNSFVMomentumPressure.md'
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
    abs_zero = 1e-8
  []
  [straight-diagonal-complete-stress]
    type = 'CSVDiff'
    input = porous-baffle-straight-diagonal.i
    csvdiff = 'porous-baffle-straight-diagonal-complete-stress_out.csv porous-baffle-straight-diagonal-complete-stress_out_v_y_left_of_interface_0001.csv porous-baffle-straight-diagonal-complete-stress_out_v_y_right_of_interface_0001.csv'
    requirement = 'The system shall include conservative nonorthogonal and deviatoric viscous stress corrections with harmonic two-point transmissibility across a diagonal porous baffle with discontinuous viscosity.'
    design = 'SIMPLE.md PorousRhieChowMassFlux.md BernoulliFormLossPressureJump.md '
             'FVPressureJumpGreenGaussGradient.md LinearFVPressureCorrectionDiffusionJump.md '
             'LinearPWCNSFVMomentumFlux.md'
    cli_args = "LinearFVKernels/u_advection/use_nonorthogonal_correction=true "
               "LinearFVKernels/v_advection/use_nonorthogonal_correction=true "
               "LinearFVKernels/u_advection/use_deviatoric_terms=true "
               "LinearFVKernels/v_advection/use_deviatoric_terms=true "
               "mu=0.2 "
               "mu_zone_2=2.0 "
               "Outputs/file_base=porous-baffle-straight-diagonal-complete-stress_out"
    recover = false # we don't support recovery for SIMPLE yet
    max_threads = 1 # see libmesh issue #3808
    abs_zero = 1e-8
  []
[]
