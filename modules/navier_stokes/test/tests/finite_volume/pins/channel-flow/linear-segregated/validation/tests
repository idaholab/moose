[Tests]
  issues = '#31995'
  [form-loss-size-mismatch]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "UserObjects/pressure_jump/form_loss='10'"
    expect_err = 'Must have the same length as boundary'
    requirement = 'The system shall reject a form-loss coefficient vector whose length does not match the pressure-jump boundary list.'
    design = 'BernoulliFormLossPressureJump.md'
    recover = false
    max_threads = 1
  []
  [reference-side-size-mismatch]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "UserObjects/pressure_jump/form_loss='10 10' UserObjects/pressure_jump/reference_velocity_side='lower_porosity'"
    expect_err = 'Must have the same length as boundary'
    requirement = 'The system shall reject a reference-velocity-side vector whose length does not match the pressure-jump boundary list.'
    design = 'BernoulliFormLossPressureJump.md'
    recover = false
    max_threads = 1
  []
  [reference-side-without-form-loss]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "UserObjects/pressure_jump/reference_velocity_side='lower_porosity lower_porosity'"
    expect_err = 'Requires form_loss to be provided'
    requirement = 'The system shall reject a reference-velocity-side selection when no form-loss coefficients are provided.'
    design = 'BernoulliFormLossPressureJump.md'
    recover = false
    max_threads = 1
  []
  [negative-form-loss]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "UserObjects/pressure_jump/form_loss='-1 0'"
    expect_err = 'All entries must be >= 0'
    requirement = 'The system shall reject a negative form-loss coefficient.'
    design = 'BernoulliFormLossPressureJump.md'
    recover = false
    max_threads = 1
  []
  [nonpositive-jump-density]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = 'UserObjects/pressure_jump/density=0'
    expect_err = 'density must be positive on pressure-jump face'
    requirement = 'The system shall reject a nonpositive density on a pressure-jump face.'
    design = 'BernoulliFormLossPressureJump.md'
    recover = false
    max_threads = 1
  []
  [nonpositive-jump-porosity]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = 'UserObjects/pressure_jump/porosity=0'
    expect_err = 'porosity must be positive on pressure-jump face'
    requirement = 'The system shall reject a nonpositive porosity on a pressure-jump face.'
    design = 'BernoulliFormLossPressureJump.md'
    recover = false
    max_threads = 1
  []
  [overlapping-jump-boundaries]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "UserObjects/active='pressure_jump duplicate_jump rc' UserObjects/rc/pressure_jump_models='pressure_jump duplicate_jump'"
    expect_err = 'Pressure jump models must not act on overlapping boundaries'
    requirement = 'The system shall reject pressure-jump models that act on overlapping boundaries.'
    design = 'PorousRhieChowMassFlux.md'
    recover = false
    max_threads = 1
  []
  [reconstructed-wrong-base]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = 'FVGradientMethods/reconstructed/base_gradient_method=green-gauss'
    expect_err = "must use the pressure variable's FVPressureJumpGreenGaussGradient as its base_gradient_method"
    requirement = 'The system shall reject a reconstructed pressure gradient whose base method is not the pressure-jump Green-Gauss method.'
    design = 'FVPressureJumpGreenGaussGradient.md FVReconstructedPressureGradient.md PorousRhieChowMassFlux.md'
    recover = false
    max_threads = 1
  []
  [ordinary-pressure-diffusion]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = "LinearFVKernels/active='u_advection u_pressure ordinary_p_diffusion HbyA_divergence' UserObjects/rc/p_diffusion_kernel=ordinary_p_diffusion LinearFVKernels/ordinary_p_diffusion/use_nonorthogonal_correction=false"
    expect_err = 'Pressure jump models require LinearFVPressureCorrectionDiffusionJump'
    requirement = 'The system shall reject an ordinary pressure-correction diffusion kernel when pressure-jump models are configured.'
    design = 'PorousRhieChowMassFlux.md LinearFVPressureCorrectionDiffusionJump.md'
    recover = false
    max_threads = 1
  []
  [two-term-without-reconstruction]
    type = RunException
    input = pressure-jump-errors.i
    cli_args = 'LinearFVKernels/u_pressure/gradient_method=jump_aware LinearFVKernels/p_diffusion/use_two_term_pressure_expansion=true'
    expect_err = 'Two-term pressure expansion requires the momentum-pressure kernels linked to the Rhie-Chow object to use FVReconstructedPressureGradient'
    requirement = 'The system shall reject two-term pressure expansion unless the momentum-pressure kernels use a reconstructed pressure gradient.'
    design = 'LinearFVPressureCorrectionDiffusionJump.md FVReconstructedPressureGradient.md'
    recover = false
    max_threads = 1
  []
  [nonpositive-face-porosity]
