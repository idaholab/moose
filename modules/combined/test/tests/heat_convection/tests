[Tests]
  [./test_3d_tf]
    type = 'Exodiff'
    input = 'heat_convection_3d_tf_test.i'
    exodiff = 'out_3d_tf.e'
    abs_zero = 1e-10
    requirement = 'The system shall apply a convective flux boundary condition with a '
                  'ramped fluid temperature and a large heat transfer coefficient to verify '
                  'that the solid surface temperature of a 3D body tracks the ramping fluid '
                  'temperature.'
    design = 'ConvectiveFluxBC.md'
  [../]

