[Tests]
  [SCM]
    type = CSVDiff
    input = subchannel.i
    csvdiff = subchannel_out.csv
    capabilities = 'method!=dbg'
    valgrind = NONE
    recover = false
    # heavy = true
    # The monolithic outer iterations stop at P_tol and T_tol, which leaves differences of up to
    # about 1e-3 between platforms
    rel_err = 2e-3
    abs_zero = 1e-5
    max_threads = 1
    max_parallel = 1
  []
  [THM_pump]
    type = CSVDiff
    input = THM_SCM_coupling_pump.i
    csvdiff = 'THM_SCM_coupling_pump_out.csv THM_SCM_coupling_pump_out_subchannel0.csv'
    capabilities = 'method!=dbg'
