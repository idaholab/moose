[Tests]
  issues = '#26920'
  design = 'invOptNEML2Viscoplastic.md'
  [grad_check_viscoplastic]
    type = TaoGradientTester
    input = main.i
    capabilities = 'neml2'
    max_rel_tol = 1e-4
    max_threads = 1
    requirement = 'The system shall verify the adjoint parameter gradient of a NEML2 viscoplastic '
                  'material against a finite difference gradient for all four inverted material '
                  'parameters simultaneously.'
  []
  [recovery_multiparam]
    type = CSVDiff
    input = main.i
    csvdiff = main_out_OptimizationReporter_0001.csv
    capabilities = 'libtorch & neml2'
    rel_err = 1e-3
    recover = false
    max_threads = 1
    requirement = 'The system shall recover the Youngs modulus, yield stress, kinematic hardening '
                  'modulus and viscous reference stress of a NEML2 viscoplastic material from '
                  'displacement measurements using gradient based optimization started from an '
                  'off-truth initial guess.'
  []
[]
