[Tests]
  issues = '#18865'
  design = 'AbaqusUMATStress.md'

  [build]
    type = 'RunCommand'
    command = 'make'
    min_slots = 2 # memory heavy
    requirement = "The system shall compile UMAT plugins using the multi-file UMAT build system."
  []
  [test]
    type = 'RunApp'
    input = 'test.i'
    prereq = build
    valgrind = NONE
    requirement = "The system shall dynamically link the compiled UMAT plugins to enable their use in MOOSE simulations."
  []
[]
