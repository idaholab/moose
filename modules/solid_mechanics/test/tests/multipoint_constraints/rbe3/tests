[Tests]
  design = 'source/constraints/RBE3Constraint.md'
  issues = '#33821'
  [rbe3_force_split_equal]
    type = 'CSVDiff'
    input = 'rbe3_force_split_equal.i'
    csvdiff = 'rbe3_force_split_equal_out.csv'
    abs_zero = 1e-8
    requirement = 'The system shall distribute a force applied at the reference node of an RBE3 constraint with equal weights onto four independent nodes as one quarter each.'
  []

  [rbe3_force_split_weighted]
    type = 'CSVDiff'
    input = 'rbe3_force_split_equal.i'
    cli_args = 'Constraints/rbe3/weights="2 1 1 1"
                Outputs/file_base=rbe3_force_split_weighted'
    csvdiff = 'rbe3_force_split_weighted.csv'
    abs_zero = 1e-8
    requirement = 'The system shall distribute a force applied at the reference node of an RBE3 constraint with weights two, one, one, one onto the four independent nodes as the weighted least-squares solution.'
  []

  [plate_eigen_reference]
    type = 'CSVDiff'
    input = 'plate_eigen_reference.i'
    csvdiff = 'plate_eigen_reference_out_omega_squared_0001.csv'
    capabilities = 'slepc & mumps'
    requirement = 'The system shall compute the lowest eigenvalue of a plate clamped along one edge.'
  []

  [rbe3_plate_eigen_unchanged]
    type = 'CSVDiff'
    input = 'rbe3_plate_eigen_unchanged.i'
    csvdiff = 'rbe3_plate_eigen_unchanged_out_omega_squared_0001.csv'
    capabilities = 'slepc & mumps'
    rel_err = 1e-3
    requirement = 'The system shall leave the lowest eigenvalue of a plate unchanged within 0.1 percent when an RBE3 constraint with a reference node above a four-node patch is added, because the constraint adds no stiffness.'
  []

  [errors]
    requirement = 'The system shall report an error'
    [collinear]
      type = RunException
      input = 'rbe3_force_split_equal.i'
      cli_args = "Constraints/rbe3/independent_boundaries='corner1 corner3'
                  Constraints/rbe3/weights='1 1'"
      expect_err = "The independent nodes are collinear, or there is only one of them."
      detail = 'when the independent nodes of an RBE3 constraint with rotations are collinear,'
    []
    [duplicate]
      type = RunException
      input = 'rbe3_force_split_equal.i'
      cli_args = "Constraints/rbe3/independent_boundaries='corner1 corner1 corner3 corner4'"
      expect_err = "belongs to more than one node set of 'independent_boundaries'."
      detail = 'when a node appears more than once in the independent set of an RBE3 '
               'constraint,'
    []
    [reference_in_independent_set]
      type = RunException
      input = 'rbe3_force_split_equal.i'
      cli_args = "Constraints/rbe3/independent_boundaries='ref_node corner2 corner3 corner4'"
      expect_err = "is the reference node of this constraint. The reference node cannot be one of "
                   "the independent nodes it is constrained to."
      detail = 'when the reference node of an RBE3 constraint is in its independent set, and'
    []
    [weights_size]
      type = RunException
      input = 'rbe3_force_split_equal.i'
      cli_args = "Constraints/rbe3/weights='1 1'"
      expect_err = "This constraint was given 2 weights but 4 entries in 'independent_boundaries'."
      detail = 'when the number of weights of an RBE3 constraint differs from the number of '
               'independent node sets.'
    []
  []
[]
