
COORDINATES absolute 1.e-6    # min separation not calculated

TIME STEPS relative 1.e-6 floor 0.0     # min:               0 @ t1 max:          0.0005 @ t11

GLOBAL VARIABLES relative 5.5e-6 floor 1e-10
	e_xx   # min:               0 @ t1	max:          0.0005 @ t11
	ee_xx  # min:               0 @ t1	max:   0.00026666667 @ t11
	ep_xx  # min:               0 @ t1	max:   0.00023333333 @ t11
	s_xx   # min:               0 @ t1	max:        53333333 @ t11

NODAL VARIABLES relative 5.5e-6 floor 1e-10
	disp_x   # min:               0 @ t1,n1	max:          0.0005 @ t11,n2
	react_x  # min:               0 @ t1,n1	max:        53333333 @ t11,n1

ELEMENT VARIABLES relative 5.5e-6 floor 1e-10
	area                                          # min:               1 @ t1,b0,e1	max:               1 @ t1,b0,e1
	axial_stress                                  # min:               0 @ t1,b0,e1	max:        53333333 @ t11,b0,e1
	e_over_l                                      # min:           2e+11 @ t1,b0,e1	max:           2e+11 @ t1,b0,e1
	elastic_stretch                               # min:               0 @ t1,b0,e1	max:   0.00026666667 @ t11,b0,e1
	hardening_variable relative 5.5e-6 floor 1e-5 # min:               0 @ t1,b0,e1	max:       3333333.3 @ t11,b0,e1
	plastic_stretch                               # min:               0 @ t1,b0,e1	max:   0.00023333333 @ t11,b0,e1
	total_stretch                                 # min:               0 @ t1,b0,e1	max:          0.0005 @ t11,b0,e1

