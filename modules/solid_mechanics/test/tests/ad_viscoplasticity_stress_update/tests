[Tests]
  issues = '#13494'
  design = 'source/materials/ADViscoplasticityStressUpdate.md source/materials/ADComputeMultipleInelasticStress.md'
  [creep]
    type = CSVDiff
    input = creep.i
    csvdiff = creep_out.csv
    design = 'source/materials/PowerLawCreepStressUpdate.md source/materials/ADComputeMultipleInelasticStress.md'
    requirement = 'The system shall compute, using the PowerLawCreepStressUpdate called through the ADComputeMultipleInelasticStress, a creep strain based on an external loading.'
  []
  [creep-jac]
    type = 'PetscJacobianTester'
    input = 'creep.i'
    cli_args = "-snes_test_err 1e-11"
    run_sim = 'True'
    ratio_tol = 1.5e-7
    difference_tol = 1e8
    prereq = creep
    requirement = 'The system shall compute a perfect Jacobian for the AD regular creep problem'
    design = 'source/materials/PowerLawCreepStressUpdate.md source/materials/ADComputeMultipleInelasticStress.md'
  []

  [exact_spherical]
    type = CSVDiff
    input = exact.i
    csvdiff = exact_spherical_out.csv
    requirement = 'The system shall compute, using the ADViscoplasticityStressUpdate class, a ratio between the gauge stress, equivalent stress, and hydrostatic stress across a wide swath of exponents and stress states using spherical pore geometry in spherical coordinates.'
    capabilities = 'method!=dbg'
  []
  [exact_spherical-jac]
    type = 'PetscJacobianTester'
    input = 'exact.i'
    cli_args = "-snes_test_err 1e-11"
    run_sim = 'True'
    ratio_tol = 1e-7
    difference_tol = 1e4
    prereq = exact_spherical
    requirement = 'The system shall compute a perfect Jacobian for the AD exact spherical problem'
  []

  [exact_cylindrical]
    type = CSVDiff
    input = exact.i
    csvdiff = exact_cylindrical_out.csv
    cli_args = 'GlobalParams/pore_shape_model=CYLINDRICAL Outputs/file_base=exact_cylindrical_out'
    prereq = exact_spherical
    requirement = 'The system shall compute, using the ADViscoplasticityStressUpdate class, a ratio between the gauge stress, equivalent stress, and hydrostatic stress across a wide swath of exponents and stress states using spherical pore geometry in cylindrical coordinates.'
    capabilities = 'method!=dbg'
  []
  [exact_cylindrical-jac]
    type = 'PetscJacobianTester'
    input = 'exact.i'
    cli_args = "-snes_test_err 1e-11 GlobalParams/pore_shape_model=CYLINDRICAL "
               "Outputs/file_base=exact_cylindrical_out"
    run_sim = 'True'
    ratio_tol = 1e-7
    difference_tol = 1e4
    prereq = exact_cylindrical
    requirement = 'The system shall compute a perfect Jacobian for the AD exact cylindrical problem'
  []

  [lps_single]
    type = CSVDiff
    input = 'lps_single.i'
    csvdiff = 'lps_single_out.csv'
    requirement = 'The system shall compute, using the ADViscoplasticityStressUpdate class, the viscoplastic response using a single model with LPS spherical formulation that increases the porosity due to an external strain.'
  []
  [lps_single-jac]
    type = 'PetscJacobianTester'
    input = 'lps_single.i'
    cli_args = "-snes_test_err 1e-11"
    run_sim = 'True'
    ratio_tol = 3e-7
    difference_tol = 1e8
    prereq = lps_single
    requirement = 'The system shall compute a perfect Jacobian for the AD lps single problem'
  []

  [lps_single_split]
    type = CSVDiff
    input = 'lps_single_split.i'
    csvdiff = 'lps_single_split_out.csv'
    requirement = 'The system shall compute, using the ADViscoplasticityStressUpdate class, the viscoplastic response using two LPS models with spherical formulations and the same stress exponential that is close to combining the models into a single ADViscoplasticityStressUpdate instance.'
  []
  [lps_single_split-jac]
    type = 'PetscJacobianTester'
    input = 'lps_single_split.i'
    cli_args = "-snes_test_err 1e-11"
    run_sim = 'True'
    ratio_tol = 3e-7
    difference_tol = 1e8
    prereq = lps_single_split
    requirement = 'The system shall compute a perfect Jacobian for the AD lps single split problem'
  []

  [lps_dual]
    type = CSVDiff
    input = 'lps_dual.i'
    csvdiff = 'lps_dual_out.csv'
    requirement = 'The system shall compute, using the ADViscoplasticityStressUpdate class, the viscoplastic response using two LPS models with spherical formulations and two different stress exponents that increases the porosity due to an external strain.'
  []
  [lps_dual-jac]
    type = 'PetscJacobianTester'
    input = 'lps_dual.i'
    cli_args = "-snes_test_err 1e-11 Executioner/num_steps=2"
    run_sim = 'True'
    ratio_tol = 3e-7
    difference_tol = 1e8
    prereq = lps_dual
    requirement = 'The system shall compute a perfect Jacobian for the AD lps dual problem'
  []

  [gtn_single]
    type = CSVDiff
    input = 'gtn_single.i'
    csvdiff = 'gtn_single_out.csv'
    requirement = 'The system shall compute, using the ADViscoplasticityStressUpdate class, the viscoplastic response using a single model with GTN formulation that increases the porosity due to an external strain.'
  []
  [gtn_single-jac]
    type = 'PetscJacobianTester'
    input = 'gtn_single.i'
    cli_args = "-snes_test_err 1e-11"
    run_sim = 'True'
    ratio_tol = 3e-7
    difference_tol = 1e8
    prereq = gtn_single
    requirement = 'The system shall compute a perfect Jacobian for the AD gtn single problem'
  []

  [negative]
    requirement = 'The system shall handle a negative calculated porosity computed from a strain tensor, when automatic differentiaton is requested,'
    [zero]
      type = CSVDiff
      input = 'negative_porosity.i'
      csvdiff = 'negative_porosity_zero_out.csv'
      cli_args = 'Outputs/file_base=negative_porosity_zero_out Materials/lps/negative_behavior=ZERO'
      detail = 'by setting the porosity to zero.'
    []
    [initial]
      type = CSVDiff
      input = 'negative_porosity.i'
      csvdiff = 'negative_porosity_initial_out.csv'
      cli_args = 'Outputs/file_base=negative_porosity_initial_out Materials/lps/negative_behavior=INITIAL_CONDITION'
      detail = 'by setting the porosity to the initial condition.'
    []
    [exception]
      type = RunException
      input = 'negative_porosity.i'
      expect_err = 'porosity is negative'
      cli_args = 'Materials/lps/negative_behavior=EXCEPTION'
      detail = 'by throwing an exception.'
    []
  []
[]
