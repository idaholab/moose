[Tests]
  design = 'source/kernels/DisplacementRegularization.md source/kernels/ADDisplacementRegularization.md'
  issues = '#32970'

  [cantilever]
    requirement = 'The system shall stiffen the bending of a plane-strain elastic cantilever under a tip shear load when displacement regularization is added to both displacement components, with a tip deflection that depends on the regularization type, using'
    [none]
      type = CSVDiff
      input = 'cantilever.i'
      csvdiff = 'cantilever_none.csv'
      cli_args = "Kernels/active='' Outputs/file_base=cantilever_none"
      detail = 'no regularization, as the reference deflection,'
    []
    [huhu]
      type = CSVDiff
      input = 'cantilever.i'
      csvdiff = 'cantilever_huhu.csv'
      cli_args = 'regularization_type=huhu Outputs/file_base=cantilever_huhu'
      detail = 'HuHu regularization,'
    []
    [lulu]
      type = CSVDiff
      input = 'cantilever.i'
      csvdiff = 'cantilever_lulu.csv'
      cli_args = 'regularization_type=lulu Outputs/file_base=cantilever_lulu'
      detail = 'LuLu regularization,'
    []
    [huhu_lulu]
      type = CSVDiff
      input = 'cantilever.i'
      csvdiff = 'cantilever_huhu_lulu.csv'
      cli_args = 'regularization_type=huhu_lulu Outputs/file_base=cantilever_huhu_lulu'
      detail = 'HuHu-LuLu regularization, and'
    []
    [ad_huhu_lulu]
      type = CSVDiff
      input = 'cantilever.i'
      csvdiff = 'cantilever_huhu_lulu.csv'
      cli_args = 'reg_kernel=ADDisplacementRegularization regularization_type=huhu_lulu Outputs/file_base=cantilever_huhu_lulu'
      prereq = 'cantilever/huhu_lulu'
      detail = 'HuHu-LuLu regularization with automatic differentiation, matching the hand-coded Jacobian result.'
    []
  []

  [cantilever_jacobian]
    requirement = 'The system shall compute the correct Jacobian of the displacement regularization in a plane-strain elastic cantilever for'
    [huhu]
      type = PetscJacobianTester
      input = 'cantilever.i'
      cli_args = 'regularization_type=huhu'
      detail = 'HuHu regularization,'
    []
    [lulu]
      type = PetscJacobianTester
      input = 'cantilever.i'
      cli_args = 'regularization_type=lulu'
      detail = 'LuLu regularization,'
    []
    [huhu_lulu]
      type = PetscJacobianTester
      input = 'cantilever.i'
      cli_args = 'regularization_type=huhu_lulu'
      detail = 'HuHu-LuLu regularization, and'
    []
    [ad_huhu_lulu]
      type = PetscJacobianTester
      input = 'cantilever.i'
      cli_args = 'reg_kernel=ADDisplacementRegularization regularization_type=huhu_lulu'
      detail = 'HuHu-LuLu regularization with automatic differentiation.'
    []
  []

  [scalar]
    requirement = 'The system shall add the displacement regularization operator to a single second-order Lagrange variable, checked independently of the mechanics equations on a diffusion problem with a uniform source, for'
    [none]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_none.csv'
      cli_args = "Kernels/active='diffusion source' Outputs/file_base=scalar_none"
      detail = 'no regularization, as the reference solution,'
    []
    [huhu]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_huhu.csv'
      cli_args = 'regularization_type=huhu Outputs/file_base=scalar_huhu'
      detail = 'the HuHu Hessian contraction,'
    []
    [lulu]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_lulu.csv'
      cli_args = 'regularization_type=lulu Outputs/file_base=scalar_lulu'
      detail = 'the LuLu Laplacian contraction,'
    []
    [huhu_lulu_default_factor]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_huhu_lulu.csv'
      cli_args = 'regularization_type=huhu_lulu Outputs/file_base=scalar_huhu_lulu'
      detail = 'the HuHu-LuLu contraction with the default LuLu factor of one half in 2D,'
    []
    [huhu_lulu_manual_factor]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_huhu_lulu_manual_factor.csv'
      cli_args = 'regularization_type=huhu_lulu Kernels/regularization/lulu_factor=0.25 Outputs/file_base=scalar_huhu_lulu_manual_factor'
      detail = 'the HuHu-LuLu contraction with a user-supplied LuLu factor,'
    []
    [huhu_lulu_default_factor_3d]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_huhu_lulu_3d.csv'
      cli_args = "Mesh/dim=3 Mesh/elem_type=HEX27 Mesh/nz=4 BCs/zero/boundary='left right top bottom front back' regularization_type=huhu_lulu Outputs/file_base=scalar_huhu_lulu_3d"
      detail = 'the HuHu-LuLu contraction with the default LuLu factor of one third in 3D,'
    []
    [ad_huhu]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_huhu.csv'
      cli_args = 'reg_kernel=ADDisplacementRegularization regularization_type=huhu Outputs/file_base=scalar_huhu'
      prereq = 'scalar/huhu'
      detail = 'the HuHu contraction with automatic differentiation,'
    []
    [ad_lulu]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_lulu.csv'
      cli_args = 'reg_kernel=ADDisplacementRegularization regularization_type=lulu Outputs/file_base=scalar_lulu'
      prereq = 'scalar/lulu'
      detail = 'the LuLu contraction with automatic differentiation, and'
    []
    [ad_huhu_lulu]
      type = CSVDiff
      input = 'scalar_regularization.i'
      csvdiff = 'scalar_huhu_lulu.csv'
      cli_args = 'reg_kernel=ADDisplacementRegularization regularization_type=huhu_lulu Outputs/file_base=scalar_huhu_lulu'
      prereq = 'scalar/huhu_lulu_default_factor'
      detail = 'the HuHu-LuLu contraction with automatic differentiation.'
    []
  []

  [errors]
    requirement = 'The system shall report an error or warning for invalid displacement regularization input when'
    [lulu_factor_without_huhu_lulu]
      type = RunException
      input = 'scalar_regularization.i'
      cli_args = 'regularization_type=huhu Kernels/regularization/lulu_factor=0.25'
      expect_err = "Only used when 'regularization = huhu_lulu'"
      detail = 'a LuLu factor is given for a regularization type that does not use it,'
    []
    [large_lulu_factor]
      type = RunException
      input = 'scalar_regularization.i'
      cli_args = '--error regularization_type=huhu_lulu Kernels/regularization/lulu_factor=0.75'
      expect_err = "The 'lulu_factor' parameter is larger than 1 / dim"
      detail = 'the LuLu factor exceeds one over the mesh dimension, which may make the HuHu-LuLu energy negative, and'
    []
    [ad_large_lulu_factor]
      type = RunException
      input = 'scalar_regularization.i'
      cli_args = '--error reg_kernel=ADDisplacementRegularization regularization_type=huhu_lulu Kernels/regularization/lulu_factor=0.75'
      expect_err = "The 'lulu_factor' parameter is larger than 1 / dim"
      detail = 'the LuLu factor exceeds one over the mesh dimension with automatic differentiation.'
    []
  []
[]
