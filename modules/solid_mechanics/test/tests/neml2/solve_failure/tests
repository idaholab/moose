[Tests]
  issues = '#30793'
  design = 'NEML2ModelExecutor.md'
  [solve_failure]
    type = Exodiff
    requirement = 'The system shall be capable of handling exceptions from the NEML2 library and mark the solve as failed gracefully.'
    input = 'moose.i'
    exodiff = 'moose_out.e'
    allow_warnings = true
    capabilities = 'libtorch & neml2'
    valgrind = heavy
    # NEML2 Newton::solve keeps iterating converged batch rows until the whole batch converges,
    # so the converged state and tangent of a quadrature point depend on which other points share
    # its batch. The nonlinear path at the load reversal, and thus the number of cutbacks, then
    # depends on the domain partitioning.
    max_parallel = 1
  []
[]
