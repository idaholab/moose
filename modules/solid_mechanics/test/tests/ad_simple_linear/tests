[Tests]
  issues = '#5658 #12650'
  [./linear-hand-coded]
    type = 'Exodiff'
    input = 'linear-hand-coded.i'
    exodiff = 'linear-out.e'
    absent_out = '3 Nonlinear'
    requirement = 'The system shall be able to run a simple linear small-strain problem using a hand-coded Jacobian'
    design = 'ComputeSmallStrain.md'
  [../]
  [./linear-ad]
    type = 'Exodiff'
    input = 'linear-ad.i'
    exodiff = 'linear-out.e'
    absent_out = '3 Nonlinear'
    prereq = 'linear-hand-coded'
    requirement = 'The system shall be able to reproduce the results of the hand-coded simulation using automatic differentiation in the production stress divergence kernel'
    design = 'ADComputeSmallStrain.md'
  [../]
  [./linear-ad-reverse]
    type = 'Exodiff'
    input = 'linear-ad-reverse-dependency.i'
    exodiff = 'linear-out.e'
    absent_out = '3 Nonlinear'
    prereq = 'linear-ad'
    requirement = 'The system shall be able to reproduce the results of the hand-coded simulation using automatic differentiation with reversed stress and strain materials'
    design = 'ADComputeSmallStrain.md'
  [../]
  [./linear-hand-coded-jac]
    type = 'PetscJacobianTester'
    input = 'linear-hand-coded.i'
    run_sim = 'True'
    ratio_tol = 1e-8
    difference_tol = 1e6 # We have Young's modulus of 1e9 so finite differencing produces a large number
    requirement = 'The system shall compute a perfect Jacobian for the hand-coded problem'
    design = 'ComputeSmallStrain.md'
  [../]
  [./linear-ad-jac]
    type = 'PetscJacobianTester'
    input = 'linear-ad.i'
    run_sim = 'True'
    ratio_tol = 1e-8
    difference_tol = 1e-4
    requirement = 'The system shall compute a perfect Jacobian for the automatic differentiation problem'
    design = 'ADComputeSmallStrain.md'
  [../]
  [./linear-ad-jac-reverse]
    type = 'PetscJacobianTester'
    input = 'linear-ad-reverse-dependency.i'
    run_sim = 'True'
    ratio_tol = 1e-8
    difference_tol = 1e6 # We have Young's modulus of 1e9 so finite differencing produces a large number
    requirement = 'The system shall compute a perfect Jacobian for the automatic differentiation problem with reversed stress and strain materials'
    design = 'ADComputeSmallStrain.md'
  [../]
[]
