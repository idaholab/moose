[Tests]
  design = 'QuadSubChannel1PhaseProblem.md'
  issues = '#28497 #34303'
  [steady]
    type = CSVDiff
    input = steady.i
    csvdiff = 'steady_out.csv steady_out_pins_0001.csv'
    recover = false
    abs_zero = 1e-7
    max_threads = 1
    requirement = 'The system shall be able to restart after a steady state solution'
  []
  [steady_fluid]
    type = CSVDiff
    input = steady.i
    csvdiff = 'steady_out_fluid_0001.csv'
    prereq = 'steady'
    should_execute = false
    delete_output_before_running = false
    abs_zero = 1e-7
    # SumWij crosses zero near this channel's mid-height; its converged value there is about
    # 7.2e-6 kg/s, small enough that platform-dependent summation order moves it by about
    # 1.2e-9 kg/s, a relative difference that exceeds the default tolerance despite being
    # physically negligible next to the 1.1e-5 to 1.3e-2 kg/s crossflows elsewhere in the same
    # column. The override's absolute-zero floor must clear SumWij's own value here, not just
    # the noise between builds, so that both sides snap to zero and the relative check never
    # runs; 9e-6 does that while staying below the next-smallest real crossflow in this file
    override_columns = 'SumWij'
    override_rel_err = '5.5e-6'
    override_abs_zero = '9e-6'
    max_threads = 1
    requirement = 'The system shall be able to restart after a steady state solution, including the '
                  'mass flow rate field'
  []
  [transient]
    type = CSVDiff
    input = transient.i
    csvdiff = 'transient_out.csv transient_out_pins_0000.csv transient_out_pins_0001.csv
               transient_out_pins_0002.csv'
    prereq = 'steady_fluid'
    abs_zero = 5e-6
    requirement = 'The system shall be able to restart a transient from a steady state solution. '
                  'The time = 0 outputs must match the final steady outputs'
  []
  [transient_fluid]
    type = CSVDiff
    input = transient.i
    csvdiff = 'transient_out_fluid_0000.csv'
    prereq = 'transient'
    should_execute = false
    delete_output_before_running = false
    abs_zero = 5e-6
    # The restarted state at time = 0 inherits the same near-zero SumWij crossing as the
    # steady solve it restarts from; see the comment on 'steady_fluid' above
    override_columns = 'SumWij'
    override_rel_err = '5.5e-6'
    override_abs_zero = '9e-6'
    max_threads = 1
    requirement = 'The system shall be able to restart a transient from a steady state solution, '
                  'including the mass flow rate field. The time = 0 outputs must match the final '
                  'steady outputs'
  []
  [transient_fluid_later]
    type = CSVDiff
    input = transient.i
    csvdiff = 'transient_out_fluid_0001.csv transient_out_fluid_0002.csv'
    prereq = 'transient_fluid'
    should_execute = false
    delete_output_before_running = false
    abs_zero = 5e-6
    max_threads = 1
    requirement = 'The system shall be able to restart a transient from a steady state solution, '
                  'including the mass flow rate field at later timesteps'
  []
  [transient_time_integrator_warning]
    type = RunApp
    input = transient.i
    prereq = 'steady'
    cli_args = 'Executioner/scheme=bdf2 Outputs/file_base=transient_time_integrator_warning'
    allow_warnings = true
    expect_out = "The subchannel solver always uses implicit (backward) Euler time integration; the requested 'BDF2' time integrator is ignored."
    match_literal = true
    max_threads = 1
    requirement = 'The system shall warn when a subchannel transient input requests a MOOSE time integrator other than implicit Euler.'
  []
[]
