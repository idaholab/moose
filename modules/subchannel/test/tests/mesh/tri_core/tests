[Tests]
  design = 'SCMTriCoreMeshGenerator.md'
  issues = '#33354'
  [core]
    requirement = 'The system shall place triangular subchannel assemblies on a hexagonal core '
                  'lattice, with each assembly keeping its own subdomains, boundaries, and assembly '
                  'id,'
    [ducted]
      type = Exodiff
      input = core.i
      exodiff = core_in.e
      cli_args = '--mesh-only'
      recover = false
      mesh_mode = 'replicated'
      detail = 'for assemblies of different sizes surrounded by ducts,'
    []
    [empty_positions]
      type = Exodiff
      input = core_empty.i
      exodiff = core_empty_in.e
      cli_args = '--mesh-only'
      recover = false
      mesh_mode = 'replicated'
      detail = 'for a lattice with empty positions, and'
    []
    [detailed]
      type = Exodiff
      input = detailed_core.i
      exodiff = detailed_core_exodus.e
      recover = false
      mesh_mode = 'replicated'
      detail = 'for detailed 3D assemblies used to visualize core solutions.'
    []
  []
  [errors]
    requirement = 'The system shall report an error when building a subchannel core mesh'
    [overlap]
      type = RunException
      input = core.i
      cli_args = '--mesh-only TriSubChannelMesh/core/assembly_pitch=0.49'
      expect_err = 'The following assemblies overlap.*Assembly 0 \(\'small_duct\'\) and assembly 3 \(\'large_duct\'\)'
      mesh_mode = 'replicated'
      detail = 'if any two assemblies overlap,'
    []
    [empty_pattern]
      type = RunException
      input = core.i
      cli_args = "--mesh-only TriSubChannelMesh/core/pattern=''"
      expect_err = 'The pattern must contain at least one row'
      mesh_mode = 'replicated'
      detail = 'if the pattern is empty,'
    []
    [even_rows]
      type = RunException
      input = core.i
      cli_args = "--mesh-only TriSubChannelMesh/core/pattern='1 1; 1 0'"
      expect_err = 'A hexagonal pattern must have an odd number of rows'
      mesh_mode = 'replicated'
      detail = 'if the pattern has an even number of rows,'
    []
    [row_length]
      type = RunException
      input = core.i
      cli_args = "--mesh-only TriSubChannelMesh/core/pattern='1 1; 1 0; 1 1'"
      expect_err = 'Row 1 has 2 entries; a hexagonal pattern with 3 rows requires 3'
      mesh_mode = 'replicated'
      detail = 'if a pattern row has the wrong length,'
    []
    [bad_index]
      type = RunException
      input = core.i
      cli_args = "--mesh-only TriSubChannelMesh/core/pattern='1 1; 1 2 1; 1 1'"
      expect_err = 'Entry 2 is neither -1 nor a valid index into \'inputs\''
      mesh_mode = 'replicated'
      detail = 'if a pattern entry is not a valid input index,'
    []
    [not_scm_input]
      type = RunException
      input = core.i
      cli_args = '--mesh-only TriSubChannelMesh/gen/type=GeneratedMeshGenerator '
                 'TriSubChannelMesh/gen/dim=1 TriSubChannelMesh/core/inputs="large_duct small_duct gen" '
                 'TriSubChannelMesh/core/pattern="1 1; 1 0 1; 1 2"'
      expect_err = 'Input \'gen\' does not provide \'flat_to_flat\' metadata'
      mesh_mode = 'replicated'
      detail = 'if an input is not a triangular subchannel assembly or duct mesh, and'
    []
    [no_mesh_only]
      type = RunException
      input = core.i
      expect_err = 'can only be generated with --mesh-only; solving on it is not supported yet'
      mesh_mode = 'replicated'
      detail = 'if a solve is requested on a core of one-dimensional assemblies.'
    []
  []
  [unused_input]
    type = RunApp
    input = core.i
    cli_args = "--mesh-only TriSubChannelMesh/core/pattern='1 1; 1 1 1; 1 1'"
    expect_out = 'Input \'large_duct\' is not used in \'pattern\''
    allow_warnings = true
    recover = false
    mesh_mode = 'replicated'
    requirement = 'The system shall warn when an input of a subchannel core mesh is not used in the '
                  'core pattern.'
  []
[]
