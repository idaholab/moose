[Tests]
  design = 'SCMTriPowerAux.md SCMTriPowerIC.md'
  issues = '#28497 #29194'
  [SCMTriPower_cells_aligned_with_pins]
    type = CSVDiff
    input = 'test_with_pins.i'
    capabilities = 'method!=dbg'
    csvdiff = 'test_with_pins_out.csv test_with_pins_out_line_check_0001.csv'
    recover = False
    abs_zero = 1e-7
    rel_err = 1e-5
    requirement = 'The system will populate a sinusoidal linear heat rate on pins in a triangular lattice using an initial condition and auxiliary kernel'
  []
  [SCMTriPower_cells_not_aligned_with_pins]
    type = CSVDiff
    input = 'test_with_pins.i'
    capabilities = 'method!=dbg'
    csvdiff = 'not_aligned_with_pins.csv not_aligned_with_pins_line_check_0001.csv'
    cli_args = 'num_cells=31 SubChannel/T_relaxation=0.5 Outputs/file_base=not_aligned_with_pins'
    recover = False
    abs_zero = 1e-7
    rel_err = 2e-5
    requirement = 'The system will populate a sinusoidal linear heat rate on pins in a triangular lattice using an initial condition and auxiliary kernel in a mesh that has axial divisions that are not aligned with the heated region entrance and exit heights.'
  []
  [SCMTriPower_pin_dependent_axial_shape]
    type = CSVDiff
    input = 'seven_pin_shapes.i'
    csvdiff = 'seven_pin_shapes_out.csv seven_pin_shapes_out_q_prime_profiles_0001.csv'
    recover = False
    abs_zero = 1e-7
    issues = '#34082'
    requirement = 'The system will assign a different axial linear heat rate shape to each pin in a triangular lattice from a single function of the pin position, while conserving the power assigned to each pin by the radial power distribution, using an initial condition and auxiliary kernel.'
  []
  [SCMTriPower_postprocessor_power]
    type = CSVDiff
    input = 'postprocessor_power.i'
    csvdiff = 'postprocessor_power_out.csv'
    recover = False
    abs_zero = 1e-7
    issues = '#34082'
    requirement = 'The system will assign the pin linear heat rate in a triangular lattice using an initial condition when the total power is supplied by a postprocessor, so that the linear heat rate integrated over the pins equals that power.'
  []
[]
