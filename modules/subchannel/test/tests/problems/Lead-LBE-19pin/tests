[Tests]
    design = 'TriSubChannel1PhaseProblem.md'
    issues = '#29486'
    [test_LBE]
        type = CSVDiff
        input = test_LBE-19pin.i
        csvdiff = test_LBE-19pin_out.csv
        capabilities = 'method!=dbg'
        valgrind = NONE
        recover = false
        rel_err = 1e-5
        requirement = 'The system will examine the tri subchannel solver for lead bismuth eutetic coolant'
    []
    [test_LEAD]
        type = CSVDiff
        input = test_LEAD-19pin.i
        csvdiff = test_LEAD-19pin_out.csv
        capabilities = 'method!=dbg'
        valgrind = NONE
        recover = false
        requirement = 'The system will examine the tri subchannel solver for lead coolant'
    []
    [pacio_bare_pins]
        type = RunException
        input = test_LBE-19pin.i
        cli_args = 'SCMClosures/Chen/friction_model=Pacio'
        expect_err = "The Pacio-Chen-Todreas friction correlation applies only to wire-wrapped triangular assemblies\."
        issues = '#33608'
        requirement = 'The system shall reject the Pacio-Chen-Todreas friction correlation for a bare pin triangular assembly.'
    []
[]
