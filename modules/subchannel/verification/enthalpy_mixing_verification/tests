[Tests]
  design = 'enthalpy.md'
  issues = '#29196'
  [enthalpy_mixing_verification]
    type = CSVDiff
    input = two_channel.i
    csvdiff = two_channel_out.csv
    capabilities = 'method!=dbg'
    valgrind = NONE
    recover = false
    abs_zero = 1e-5
    max_threads = 1
    max_parallel = 1
    # The crossflow solve does not converge in every iteration; remove once #34306 is fixed
    allow_warnings = true
    requirement = 'The system shall model the turbulent enthalpy diffusion v2'
  []
[]
