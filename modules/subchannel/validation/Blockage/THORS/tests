    # so the result is not converged to round-off and can differ slightly between platforms
    rel_err = 5e-5
    abs_zero = 1e-5
    valgrind = NONE
    recover = false
    requirement = 'The system shall examine the subchannel solver for the FFM-5B high flow case'
  []
  [FFM-3A]
    type = CSVDiff
    input = 'FFM-3A.i'
    csvdiff  = 'FFM-3A_out.csv'
    capabilities = 'method!=dbg'
    abs_zero = 1e-5
    rel_err = 5e-5
    valgrind = NONE
    recover = false
    requirement = 'The system shall examine the subchannel solver for the FFM-3A case'
  []
