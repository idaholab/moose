[Tests]
    design = 'TriSubChannel1PhaseProblem.md'
    issues = '#1209 #29491 #29513'
    [toshiba-37]
        type = CSVDiff
        input = toshiba_37_pin.i
        csvdiff = toshiba_37_pin_out.csv
        # custom_cmp = 'test.exodiff'
        capabilities = 'method!=dbg'
        valgrind = NONE
        recover = false
        abs_zero = 1e-5
        # The outer iteration stops at T_tol = 1e-5, so the pressure drop differs by up to 6e-5
        # between compilers
        rel_err = 1e-4
        max_threads = 1
        requirement = 'The system shall examine the subchannel solver for the Toshiba 37-pin case'
    []
[]
