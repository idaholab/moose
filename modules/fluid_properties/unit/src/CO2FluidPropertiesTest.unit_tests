[Tests]
  design = 'CO2FluidProperties.md'
  issues = '#34070'

  [derivatives_near_critical]
    type = GoogleTest
    unit_test = CO2FluidPropertiesTest.derivativesNearCritical
    requirement = 'The system shall compute derivatives of the CO2 density, internal energy and enthalpy with respect to pressure and temperature, and an isobaric heat capacity equal to the temperature derivative of the enthalpy, near the critical point where the nonanalytic terms of the Span and Wagner equation of state are significant.'
