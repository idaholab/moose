[Tests]
  design = 'AdaptiveRayContainmentCheck.md'
  issues = '#33397 #33398'

  [write_3d_box]
    type = GoogleTest
    unit_test = OrientedBoundingBoxTest.WriteMeshBox3D
    requirement = 'The system shall write an oriented three-dimensional bounding box as a HEX8 mesh with the expected corners.'
  []
  [write_2d_box]
    type = GoogleTest
    unit_test = OrientedBoundingBoxTest.WriteMeshBox2D
    requirement = 'The system shall write an oriented two-dimensional bounding box as a QUAD4 mesh with the expected corners.'
  []
  [write_ray]
    type = GoogleTest
    unit_test = OrientedBoundingBoxTest.WriteRay
    requirement = 'The system shall write a ray spanning the shortest axis of an oriented bounding box as an EDGE2 mesh.'
  []
  [axis_aligned_queries]
    type = GoogleTest
    unit_test = OrientedBoundingBoxTest.QueryApiAxisAligned
    requirement = 'The system shall report geometry, projected coordinates, and containment for an axis-aligned oriented bounding box.'
  []
  [rotated_queries]
    type = GoogleTest
    unit_test = OrientedBoundingBoxTest.QueryApiRotated
    requirement = 'The system shall report projected coordinates and containment in the local basis of a rotated oriented bounding box.'
  []
  [default_construction]
    type = GoogleTest
    unit_test = OrientedBoundingBoxTest.DefaultConstructed
    requirement = 'The system shall initialize a default-constructed oriented bounding box with corners and centroid at the origin.'
  []
[]
