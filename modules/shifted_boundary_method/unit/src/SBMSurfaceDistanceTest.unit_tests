[Tests]
  design = 'UnsignedDistanceToSurfaceMesh.md'
  issues = '#31937 #31938'

  [edge_projection]
    type = GoogleTest
    unit_test = SBMSurfaceDistanceTest.Edge2NormalProjection
    requirement = 'The system shall compute the normal distance vector from a point whose projection lies on an EDGE2 surface element.'
  []
  [edge_node_fallback]
    type = GoogleTest
    unit_test = SBMSurfaceDistanceTest.Edge2NodeFallback
    requirement = 'The system shall compute the distance vector to the nearest EDGE2 node when the normal projection lies outside the element.'
  []
  [tilted_edge]
    type = GoogleTest
    unit_test = SBMSurfaceDistanceTest.Edge2TiltedDirection
    requirement = 'The system shall compute the direction and magnitude of the distance vector to a tilted EDGE2 surface element.'
  []
  [triangle_projection]
    type = GoogleTest
    unit_test = SBMSurfaceDistanceTest.Tri3NormalProjection
    requirement = 'The system shall compute the normal distance vector from a point whose projection lies on a TRI3 surface element.'
  []
  [tilted_triangle]
    type = GoogleTest
    unit_test = SBMSurfaceDistanceTest.Tri3Tilted
    requirement = 'The system shall compute nearest-feature distance vectors for points off and on a tilted TRI3 surface element.'
  []
[]
