[Tests]
  design = 'modules/shifted_boundary_method/grain_boundary_case.md'
  [grain_boundary_sczm_coarse_lambda1]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    csvdiff = 'grain_boundary_sczm_coarse_lambda1_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a shifted cohesive zone problem with volumetric locking '
                  'correction on a polycrystalline grain structure whose grain IDs and interfaces '
                  'are determined from one complete boundary mesh.'
  []
  [reversed_interface_pairs]
    type = CSVDiff
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    csvdiff = 'grain_boundary_sczm_coarse_lambda1_csv.csv'
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs="'
               '2 1; 4 1; 5 1; 4 2; 4 3; 5 3; 5 4"'
    prereq = grain_boundary_sczm_coarse_lambda1
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall orient true-interface normals consistently regardless of '
                  'interface-subdomain pair ordering.'
    issues = '#33397'
  []
  [outside_grains]
    type = Exodiff
    input = 'outside_grains.i'
    exodiff = 'outside_grains_out.e'
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall retain an element input subdomain when no grain occupancy is '
                  'selected.'
    issues = '#33397'
  []
  [sparse_grain_ids]
    type = Exodiff
    input = 'sparse_grain_ids.i'
    exodiff = 'sparse_grain_ids_out.e'
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall preserve grain names when boundary subdomain IDs are zero-based '
                  'and noncontiguous.'
    issues = '#33397'
  []
  [invalid_leaf_max_size]
    type = RunException
    input = 'outside_grains.i'
    cli_args = 'Mesh/grains/leaf_max_size=0'
    expect_err = 'Range check failed for parameter Mesh/grains/leaf_max_size'
    mesh_mode = REPLICATED
    requirement = 'The system shall reject a nonpositive maximum KD-tree leaf size.'
    issues = '#33397'
  []
  [grain_boundary_sczm_separate_interfaces]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_interfaces.i'
    csvdiff = 'grain_boundary_sczm_separate_interfaces_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a shifted cohesive zone problem on a polycrystalline '
                  'grain structure using a separately loaded surface mesh for each grain '
                  'interface.'
  []
  [explicit_surface_mesh_names]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_interfaces.i'
    csvdiff = 'grain_boundary_sczm_separate_interfaces_csv.csv'
    cli_args = "Mesh/grain1_grain2/save_with_name=surface_12 "
               "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/surface_meshes='surface_12 grain1_grain4 grain1_grain5 grain2_grain4 grain3_grain4 grain3_grain5 grain4_grain5'"
    prereq = grain_boundary_sczm_separate_interfaces
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall associate each surrogate boundary with a user-selected saved '
                  'surface mesh.'
  []
  [complete_interface_pair_count]
    type = RunException
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 2'"
    expect_err = 'Provide exactly one subdomain pair per boundary.'
    mesh_mode = REPLICATED
    requirement = 'The system shall require one explicit subdomain pair for each surrogate boundary.'
  []
  [ambiguous_distance_source]
    type = RunException
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/sbm_distance_uo=unused'
    expect_err = "Specify only one of 'sbm_distance_uo', 'generate_sbm_distance', and 'complete_interface_mesh'."
    mesh_mode = REPLICATED
    requirement = 'The system shall reject simultaneous explicit and automatically generated '
                  'distance sources.'
  []
  [unknown_manager_pair]
    type = RunException
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 99; 1 4; 1 5; 2 4; 3 4; 3 5; 4 5'"
    expect_err = 'maps to an interface not detected by the manager.'
    mesh_mode = REPLICATED
    requirement = 'The system shall reject an explicit subdomain pair that is absent from the '
                  'detected complete interface.'
  []
  [nonconformal_interface]
    type = RunException
    input = 'nonconformal_interface.i'
    cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/boundary='grain1_grain2' "
               "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 2'"
    expect_err = 'maps to an interface not detected by the manager.'
    mesh_mode = REPLICATED
    requirement = 'The system shall reject partially overlapping interface faces when the complete '
                  'interface mesh is nonconformal.'
    issues = '#33666'
  []
[]
