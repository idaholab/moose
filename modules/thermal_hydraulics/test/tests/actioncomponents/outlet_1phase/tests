[Tests]
  issues = '#19830 #32558'
  design = 'Outlet1PhaseAC.md'

  [phy:solidwall_outlet_3eqn]
    type = 'Exodiff'
    input = 'phy.solidwall_outlet_3eqn.i'
    exodiff = 'phy.solidwall_outlet_3eqn.e'
    gold_dir = '../../components/outlet_1phase/gold'
    custom_cmp = '../../components/outlet_1phase/phy.solidwall_outlet_3eqn.exodiff'
    # see relap7#530 why
    max_threads = 1
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model an outlet connected to a sealed pipe with '
                  '1D single phase compressible flow in a flow channel ActionComponent, using the '
                  'same input and reference results as the classic Outlet1Phase Component.'
  []
  [jacobian]
    type = 'PetscJacobianTester'
    input = 'jacobian.i'
    ratio_tol = 1e-6
    difference_tol = 15
    cli_args = 'Debug/check_jacobian=true'
    max_parallel = 1
    requirement = 'The system shall be able to compute numerically accurate Jacobians for '
                  '1D single phase flow in a flow channel ActionComponent with a pressure outlet, '
                  'using the same input as the classic Outlet1Phase Component.'
  []

  [clg:ctrl_p_3eqn]
    type = 'CSVDiff'
    input = 'clg.ctrl_p_3eqn.i'
    csvdiff = 'clg.ctrl_p_3eqn_out.csv'
    gold_dir = '../../components/outlet_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to control the pressure at a pressure outlet of a flow channel ActionComponent dynamically during a 1D single phase flow simulation, using the same input and reference results as the classic Outlet1Phase Component.'
  []
[]
