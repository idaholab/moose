[Tests]
  issues = '#19830 #32558 #33877'
  design = 'FlowChannel1PhaseAC.md'

  [jacobian]
    type = 'PetscJacobianTester'
    input = 'jacobian.i'
    ratio_tol = 7e-8
    difference_tol = 15
    cli_args = 'Debug/check_jacobian=true'
    max_threads = 1
    max_parallel = 1
    requirement = 'The system shall have correct Jacobians for a single-phase flow channel '
                  'ActionComponent, including the wall friction kernel and closures materials, '
                  'using the same input as the classic FlowChannel1Phase Component.'
  []

  [physics]
    requirement = 'The system shall simulate a single-phase flow channel ActionComponent, using '
                  'the same inputs and reference results as the classic FlowChannel1Phase '
                  'Component,'

    [steady]
      type = 'Exodiff'
      input = 'steady.i'
      exodiff = 'steady_out.e'
      gold_dir = '../../components/flow_channel_1phase/gold'
      custom_cmp = 'no_P_hf_vel.exodiff'
      detail = 'in a steady problem,'
    []
    [phy:par_fn]
      type = 'CSVDiff'
      input = 'phy.par_fn.i'
      csvdiff = 'phy.par_fn_out.csv'
      gold_dir = '../../components/flow_channel_1phase/gold'
      rel_err = 1e-10
      restep = false # Test is prescribed to abort on failed timestep
      detail = 'with a hydraulic diameter provided by a function.'
    []
  []
[]
