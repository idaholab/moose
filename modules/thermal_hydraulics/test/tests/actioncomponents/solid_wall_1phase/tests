[Tests]
  issues = '#19830 #32558'
  design = 'SolidWall1PhaseAC.md'

  [phy:3eqn]
    type = 'Exodiff'
    input = 'phy.3eqn.i'
    exodiff = 'phy.3eqn_out.e'
    gold_dir = '../../components/solid_wall_1phase/gold'
    custom_cmp = 'no_P_hf.exodiff'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a wall at the end of a single-phase flow '
                  'channel ActionComponent, using the same input and reference results as the '
                  'classic SolidWall1Phase Component.'
  []
  [jacobian]
    type = 'PetscJacobianTester'
    input = 'jacobian.i'
    ratio_tol = 2e-5
    difference_tol = 2100
    cli_args = 'Debug/check_jacobian=true'
    max_parallel = 1
    requirement = 'The system shall be able to compute a numerically accurate Jacobian for a wall '
                  'at the end of a single-phase flow channel ActionComponent, using the same '
                  'input as the classic SolidWall1Phase Component.'
  []
[]
