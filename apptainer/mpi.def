{#-
   Required jinja arguments:

   - MOOSE_DIR: Path on the host to the MOOSE repository

   Optional jinja arguments:

   - VARIANT: Set an alternate variant (from image)
-#}

{#- Directory definitions                              -#}
{%- set FILES_DIR = MOOSE_DIR + '/apptainer/files/mpi' -%}

{#- Image variant definitions
    rocky8_gcc:        moose-mpi-rocky8-gcc:8.10-gcc13.3.1-mpich5.0.2-openmpi5.0.11-20261027
    rocky8_oneapi:     moose-mpi-rocky8-oneapi:8.10-gcc13.3.1-oneapi2026.2.0-mpich4.3.2-20261027
    rocky9_gcc:        moose-mpi-rocky9-gcc:9.7-gcc13.3.1-mpich4.3.2-openmpi5.0.11-20261027
    ubuntu24_clang:    moose-mpi-ubuntu24-clang:24.04-clang22.1.8-gcc14.2.0-mpich5.0.2-openmpi5.0.11-20261027
    ubuntu24_cuda_gcc: moose-mpi-ubuntu24-cuda-gcc:24.04-cuda13.3.1-gcc14.2.0-mpich5.0.2-openmpi5.0.11-20261027
    ubuntu24_gcc:      moose-mpi-ubuntu24-gcc:24.04-gcc14.2.0-mpich5.0.2-openmpi5.0.11-20261027
    ubuntu24_gccmin:   moose-mpi-ubuntu24-gccmin:24.04-gcc9.5.0-mpich5.0.2-20261027
-#}
{%- set FROM_IMAGES = {
  "rocky8_gcc":        "ghcr.io/idaholab/moose-containers/staging-moose-mpi-rocky8-gcc@sha256:ecdb3a3364068c5b7b46f996d25248d02d0385343ffa03ea5cc9886be2bbed18",
  "rocky8_oneapi":     "ghcr.io/idaholab/moose-containers/staging-moose-mpi-rocky8-oneapi@sha256:718a139cecbc8a665090fa85bc3842610b5812c9ff123b671edfb7ea6e68c08f",
  "rocky9_gcc":        "ghcr.io/idaholab/moose-containers/staging-moose-mpi-rocky9-gcc@sha256:9cbb7abc592b148d4eea162994bd073e68f447c1f739a703455711b6cde45f66",
  "ubuntu24_clang":    "ghcr.io/idaholab/moose-containers/staging-moose-mpi-ubuntu24-clang@sha256:1c652adecbaa27d59d0a6c1a94ebf9004ac962b6c5210b0ad4158f7d69093f6b",
  "ubuntu24_cuda_gcc": "ghcr.io/idaholab/moose-containers/staging-moose-mpi-ubuntu24-cuda-gcc@sha256:0d9fc89c7680b6e4ef2f5f476abaa8e451e783225aa3ff31a8ee9d8cd124400c",
  "ubuntu24_gcc":      "ghcr.io/idaholab/moose-containers/staging-moose-mpi-ubuntu24-gcc@sha256:22dfa555db550756fb879f35bf83756205de9a9507a6fb8d1d15917ad073fd02",
  "ubuntu24_gccmin":   "ghcr.io/idaholab/moose-containers/staging-moose-mpi-ubuntu24-gccmin@sha256:f155881132568e894752d266d5b6d7e3f61dd0aca707b21fa48de848f10bb90a"
} -%}

Bootstrap: docker
From: {{ FROM_IMAGES.get(VARIANT, FROM_IMAGES.get("ubuntu24_gcc")) }}

%environment
    # Fix locale warnings
    export LC_ALL=C

    # Environment from underyling docker image
    test -f /moose_env.sh && . /moose_env.sh

%post -c /bin/bash
    set -uexo pipefail

    source /.singularity.d/build_utils.sh
    update_system_packages

    # Remove apptainer if it's installed
    if is_rocky && dnf list installed apptainer &> /dev/null; then
        dnf remove -y apptainer
    fi

    # Enable additional rocky repos
    if is_rocky; then
        dnf install -y dnf-plugins-core
        if is_rocky8; then
            dnf config-manager --set-enabled powertools
            dnf install -y redhat-lsb-core.x86_64
        elif is_rocky9; then
            dnf config-manager --set-enabled crb
        fi
        dnf install -y epel-release
    fi

    # Additional installs
    INSTALLS=(
        "autoconf" "automake" "bash-completion" "bison" "cmake" "diffutils"
        "doxygen" "emacs" "flex" "lcov" "libtool" "ninja-build" "patch" "patchelf"
        "patchutils"
    )
    ROCKY_INSTALLS=(
        "cppunit" "cppunit-devel" "fftw-devel" "glpk-devel" "gsl-devel" "libpng"
        "libpng-devel" "libtirpc" "libtirpc-devel" "perl-IO-Compress" "perl-JSON"
        "perl-JSON-PP" "zlib-devel"
    )
    UBUNTU_INSTALLS=(
        "libcppunit-dev" "libfftw3-dev" "libglpk-dev" "libgsl-dev" "libio-compress-perl"
        "libjson-perl" "libjson-pp-perl" "libpng-dev" "libtirpc3" "libtirpc-dev"
        "zlib1g-dev" "libc6-dbg"
    )
    if is_rocky; then
        dnf install -y "${INSTALLS[@]}" "${ROCKY_INSTALLS[@]}"
        dnf debuginfo-install -y glibc
    elif is_ubuntu; then
        apt-get install -y --no-install-recommends "${INSTALLS[@]}" "${UBUNTU_INSTALLS[@]}"
    fi

    # Clean after install
    clean_system_packages

%test
    if [ -n "$MOOSE_MPICH_DIR" ]; then
        ${MOOSE_MPICH_DIR}/bin/mpiexec --version
    fi
    if [ -n "$MOOSE_OPENMPI_DIR" ]; then
        ${MOOSE_OPENMPI_DIR}/bin/mpiexec --version
        ${MOOSE_OPENMPI_DIR}/bin/ompi_info
    fi

%files
    {{ FILES_DIR }}/.singularity.d/env/02-fix-actions.sh /.singularity.d/env/02-fix-actions.sh
    {{ FILES_DIR }}/.singularity.d/moose_bashrc /.singularity.d/moose_bashrc
    {{ FILES_DIR }}/.singularity.d/build_utils.sh /.singularity.d/build_utils.sh
