{#-
   Required jinja arguments:

   - MOOSE_DIR: Path on the host to the MOOSE repository

   Optional jinja arguments:

   - VARIANT: Set an alternate variant (from image)
-#}

{#- Directory definitions                              -#}
{%- set FILES_DIR = MOOSE_DIR + '/apptainer/files/mpi' -%}

{#- Image variant definitions
    rocky8_gcc:        moose-mpi-rocky8-gcc:8.10-gcc13.3.1-mpich5.0.2-openmpi5.0.11-20261008
    rocky8_oneapi:     moose-mpi-rocky8-oneapi:8.10-gcc13.3.1-oneapi2026.1.1-mpich4.3.2-20261008
    rocky9_gcc:        moose-mpi-rocky9-gcc:9.7-gcc13.3.1-mpich4.3.2-openmpi5.0.11-20261008
    ubuntu24_clang:    moose-mpi-ubuntu24-clang:24.04-clang22.1.8-gcc14.2.0-mpich5.0.2-openmpi5.0.11-20261008
    ubuntu24_cuda_gcc: moose-mpi-ubuntu24-cuda-gcc:24.04-cuda13.3.1-gcc14.2.0-mpich5.0.2-openmpi5.0.11-20261008
    ubuntu24_gcc:      moose-mpi-ubuntu24-gcc:24.04-gcc14.2.0-mpich5.0.2-openmpi5.0.11-20261008
    ubuntu24_gccmin:   moose-mpi-ubuntu24-gccmin:24.04-gcc9.5.0-mpich5.0.2-20261008
-#}
{%- set FROM_IMAGES = {
  "rocky8_gcc":        "ghcr.io/idaholab/moose-containers/moose-mpi-rocky8-gcc@sha256:efa677939d9024753761f806df6257ed27acaa04f958b79eab7f95e540aa55ac",
  "rocky8_oneapi":     "ghcr.io/idaholab/moose-containers/moose-mpi-rocky8-oneapi@sha256:0e2a63370d0493b8357c801de1758a015b29ec0ef8a3c7aa0112b52ac92755d5",
  "rocky9_gcc":        "ghcr.io/idaholab/moose-containers/moose-mpi-rocky9-gcc@sha256:542cee398bd116d1d2b0474e024eadb914401df7b06f6bb3d20e023da7bbeb0a",
  "ubuntu24_clang":    "ghcr.io/idaholab/moose-containers/moose-mpi-ubuntu24-clang@sha256:7475ca1293095d3147767beb1e6a9a2afc678597647d0635ad8703f2059f9abe",
  "ubuntu24_cuda_gcc": "ghcr.io/idaholab/moose-containers/moose-mpi-ubuntu24-cuda-gcc@sha256:e924a14256a8339b36be972487d911800a081365d502b1c2dfda164d1a16ac3f",
  "ubuntu24_gcc":      "ghcr.io/idaholab/moose-containers/moose-mpi-ubuntu24-gcc@sha256:ec0f5b6f3cb2e13e470159b242e9073b498b984888060510d251817fa4329883",
  "ubuntu24_gccmin":   "ghcr.io/idaholab/moose-containers/moose-mpi-ubuntu24-gccmin@sha256:47a7577b7e323d9fb0c063887a275b08321446b40b1ff7f06c837da2b2660c59"
} -%}

Bootstrap: docker
From: {{ FROM_IMAGES.get(VARIANT, FROM_IMAGES.get("ubuntu24_gcc")) }}

%environment
    # Fix locale warnings
    export LC_ALL=C

    # Environment from underyling docker image
    test -f /moose_env.sh && . /moose_env.sh

%post -c /bin/bash
    set -uexo pipefail

    source /.singularity.d/build_utils.sh
    update_system_packages

    # Remove apptainer if it's installed
    if is_rocky && dnf list installed apptainer &> /dev/null; then
        dnf remove -y apptainer
    fi

    # Enable additional rocky repos
    if is_rocky; then
        dnf install -y dnf-plugins-core
        if is_rocky8; then
            dnf config-manager --set-enabled powertools
            dnf install -y redhat-lsb-core.x86_64
        elif is_rocky9; then
            dnf config-manager --set-enabled crb
        fi
        dnf install -y epel-release
    fi

    # Additional installs
    INSTALLS=(
        "autoconf" "automake" "bash-completion" "bison" "cmake" "diffutils"
        "doxygen" "emacs" "flex" "lcov" "libtool" "ninja-build" "patch" "patchelf"
        "patchutils"
    )
    ROCKY_INSTALLS=(
        "cppunit" "cppunit-devel" "fftw-devel" "glpk-devel" "gsl-devel" "libpng"
        "libpng-devel" "libtirpc" "libtirpc-devel" "perl-IO-Compress" "perl-JSON"
        "perl-JSON-PP" "zlib-devel"
    )
    UBUNTU_INSTALLS=(
        "libcppunit-dev" "libfftw3-dev" "libglpk-dev" "libgsl-dev" "libio-compress-perl"
        "libjson-perl" "libjson-pp-perl" "libpng-dev" "libtirpc3" "libtirpc-dev"
        "zlib1g-dev" "libc6-dbg"
    )
    if is_rocky; then
        dnf install -y "${INSTALLS[@]}" "${ROCKY_INSTALLS[@]}"
        dnf debuginfo-install -y glibc
    elif is_ubuntu; then
        apt-get install -y --no-install-recommends "${INSTALLS[@]}" "${UBUNTU_INSTALLS[@]}"
    fi

    # Clean after install
    clean_system_packages

%test
    if [ -n "$MOOSE_MPICH_DIR" ]; then
        ${MOOSE_MPICH_DIR}/bin/mpiexec --version
    fi
    if [ -n "$MOOSE_OPENMPI_DIR" ]; then
        ${MOOSE_OPENMPI_DIR}/bin/mpiexec --version
        ${MOOSE_OPENMPI_DIR}/bin/ompi_info
    fi

%files
    {{ FILES_DIR }}/.singularity.d/env/02-fix-actions.sh /.singularity.d/env/02-fix-actions.sh
    {{ FILES_DIR }}/.singularity.d/moose_bashrc /.singularity.d/moose_bashrc
    {{ FILES_DIR }}/.singularity.d/build_utils.sh /.singularity.d/build_utils.sh
