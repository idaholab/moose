[Tests]
  design = 'syntax/Functions/index.md syntax/Distributions/index.md'
  issues = '#22766'

  [distribution_evaluation_errors]
    type = GoogleTest
    unit_test = MooseServerTest.PlottingDistributionEvaluationErrors
    requirement = 'The system shall provide a valid distribution preview when evaluation of the other distribution curve fails.'
  []

  [distribution_settings]
    type = GoogleTest
    unit_test = MooseServerTest.PlottingDistributionSettings
    requirement = 'The system shall reject invalid distribution preview sampling settings and accept supported point counts.'
  []

  [distribution_values]
    type = GoogleTest
    unit_test = MooseServerTest.PlottingDistributionValues
    requirement = 'The system shall reject invalid probability densities and cumulative probabilities while permitting small floating-point roundoff.'
  []
[]
