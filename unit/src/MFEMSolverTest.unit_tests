[Tests]
  issues = '#34206'

  [minres]
    type = GoogleTest
    unit_test = MFEMSolverTest.MFEMMINRESSolver
    design = 'MFEMMINRESSolver.md'
    requirement = 'The system shall solve an MFEM linear system with the MINRES method.'
  []
  [hypre_diag_scale]
    type = GoogleTest
    unit_test = MFEMSolverTest.MFEMHypreDiagScale
    design = 'MFEMHypreDiagScale.md'
    requirement = 'The system shall precondition a hypre conjugate gradient solve of an MFEM linear '
                  'system with diagonal scaling.'
  []
  [hypre_smoother]
    design = 'MFEMHypreSmoother.md'
    requirement = 'The system shall apply a hypre smoother to an MFEM linear system'
    [default_type]
      type = GoogleTest
      unit_test = MFEMSolverTest.MFEMHypreSmoother
      detail = 'of the default type, as the preconditioner of a conjugate gradient solve,'
    []
    [l1_jacobi]
      type = GoogleTest
      unit_test = MFEMSolverTest.MFEMHypreSmootherl1Jacobi
      detail = 'with l1 Jacobi relaxation and positive l1 norms, as the preconditioner of a MINRES '
               'solve, and'
    []
    [low_order_refined]
      type = GoogleTest
      unit_test = MFEMSolverTest.MFEMHypreSmootherLOR
      detail = 'built on a low-order-refined discretization, as the solver.'
    []
  []
[]
