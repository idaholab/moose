[Tests]
  design = 'CSGBase.md'
  issues = '#29095'

  [root_constructor]
    type = GoogleTest
    unit_test = CSGUniverseTest.testRootUniverseConstructor
    requirement = 'The system shall create an empty constructive solid geometry (CSG) universe that is flagged as the root universe.'
  []
  [cells_constructor]
    type = GoogleTest
    unit_test = CSGUniverseTest.testCellsUniverseConstructor
    requirement = 'The system shall create a non-root CSG universe from a name and a list of cells.'
  []
  [get_cell]
    type = GoogleTest
    unit_test = CSGUniverseTest.testGetCell
    requirement = 'The system shall return a cell of a CSG universe by name and report an error if the universe does not contain the cell.'
  []
  [add_cell]
    type = GoogleTest
    unit_test = CSGUniverseTest.testAddCell
    requirement = 'The system shall add a cell to a CSG universe and warn without adding it when the universe already contains a cell of the same name.'
  []
  [remove_cell]
    type = GoogleTest
    unit_test = CSGUniverseTest.testRemoveCell
    requirement = 'The system shall remove a cell from a CSG universe and report an error if the universe does not contain the cell.'
  []
  [remove_all_cells]
    type = GoogleTest
    unit_test = CSGUniverseTest.testRemoveAllCells
    requirement = 'The system shall remove all cells from a CSG universe.'
  []
  [set_name]
    type = GoogleTest
    unit_test = CSGUniverseTest.testSetName
    requirement = 'The system shall rename a CSG universe.'
  []
  [equality]
    type = GoogleTest
    unit_test = CSGUniverseTest.testUniverseEquality
    requirement = 'The system shall compare CSG universes for equality using their name, cells, and transformations.'
  []
[]
