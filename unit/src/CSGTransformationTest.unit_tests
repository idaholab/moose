[Tests]
  design = 'CSGBase.md'
  issues = '#29095 #32308'

  [invalid_values]
    type = GoogleTest
    unit_test = CSGTransformationTest.testInvalidValues
    requirement = 'The system shall identify a constructive solid geometry (CSG) scale transformation with a zero scaling factor as invalid.'
  []
  [get_strings]
    type = GoogleTest
    unit_test = CSGTransformationTest.testGetStrings
    requirement = 'The system shall return the string name of each CSG transformation type.'
  []
[]
