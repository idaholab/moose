[Tests]
  design = 'meshgenerators/DualMeshGenerator.md'
  issues = '#33143'

  [point_in_polygon]
    type = GoogleTest
    unit_test = PolygonUtilsTest.pointInPolygon2D
    requirement = 'The system shall determine whether a point lies inside a two-dimensional polygon for non-convex polygons, counting points on the boundary as inside.'
  []
  [fan_apex]
    type = GoogleTest
    unit_test = PolygonUtilsTest.fanApexOffset
    requirement = 'The system shall select a polygon corner from which a triangle fan contains no degenerate triangle, so that a polygon carrying collinear corners can be triangulated.'
  []
[]
