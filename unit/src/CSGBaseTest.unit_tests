[Tests]
  design = 'CSGBase.md CSGEngUnit.md'
  issues = '#34321'

  [reuse_identical_surfaces]
    requirement = 'The system shall reuse an existing surface, rather than add a duplicate, when expanding an engineering unit creates a surface identical to one already in the Constructive Solid Geometry (CSG) representation, for'
    [surface_unit]
      type = GoogleTest
      unit_test = CSGBaseTest.testSurfEngUnitExpandSharedSurface
      detail = 'a surface engineering unit, with the expanded region referring to the stored surface,'
    []
    [cell_unit]
      type = GoogleTest
      unit_test = CSGBaseTest.testCellEngUnitExpandSharedSurface
      detail = 'a cell engineering unit, with the expanded cell referring to the stored surface, and'
    []
    [universe_units]
      type = GoogleTest
      unit_test = CSGBaseTest.testUnivEngUnitExpandSharedSurface
      detail = 'several universe engineering units that create the same surface.'
    []
  []
  [conflicting_surfaces]
    requirement = 'The system shall report an error when expanding an engineering unit creates a surface with the name of an existing surface in the Constructive Solid Geometry (CSG) representation but a different definition, for'
    [surface_unit]
      type = GoogleTest
      unit_test = CSGBaseTest.testSurfEngUnitExpandConflictingSurface
      detail = 'a surface engineering unit,'
    []
    [transformed_surface_unit]
      type = GoogleTest
      unit_test = CSGBaseTest.testSurfEngUnitExpandTransformedSharedSurface
      detail = 'a surface engineering unit whose transformation makes the created surface differ from the existing one,'
    []
    [cell_unit]
      type = GoogleTest
      unit_test = CSGBaseTest.testCellEngUnitExpandConflictingSurface
      detail = 'a cell engineering unit, and'
    []
    [universe_units]
      type = GoogleTest
      unit_test = CSGBaseTest.testUnivEngUnitExpandConflictingSurface
      detail = 'universe engineering units that create surfaces with the same name.'
    []
  []
[]
