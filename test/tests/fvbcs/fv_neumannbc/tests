[Tests]
  [fv_neumann]
    design = 'FVNeumannBC.md'
    issues = '#16477'
    type = 'Exodiff'
    input = 'fv_neumannbc.i'
    exodiff = 'fv_neumannbc_out.e'
    requirement = 'The system shall run a simple 1D diffusion problem with a Neumann BC value.'
    allow_warnings = true # parsed sideset generation isn't fully supported on distributed meshes
  []
  [fvbcs_internal]
    design = 'FVNeumannBC.md'
    issues = '#16882 #33435'
    type = RunException
    input = 'fv_neumannbc.i'
    cli_args = "FVBCs/inactive=''"
    expect_err = "FVFluxBC 'center' for variable 'u' is being triggered on an internal face .* where the variable is defined on both sides\."
    requirement = 'The system shall report an error if a finite volume flux boundary condition, in this case a finite volume Neumann boundary condition, is used inside the domain.'
    allow_warnings = true # parsed sideset generation isn't fully supported on distributed meshes
  []
  [fvbcs_internal_runtime_check]
    design = 'FVNeumannBC.md'
    issues = '#16882 #33435'
    type = RunException
    input = 'fv_neumannbc.i'
    cli_args = "FVBCs/inactive='' Problem/fv_face_integrity_check=false"
    expect_err = "FVFluxBC 'center' for variable 'u' is being triggered on an internal face .* where the variable is defined on both sides\."
    requirement = 'The system shall retain runtime finite volume flux boundary condition face validation when the setup-time FV face integrity check is disabled.'
    allow_warnings = true # parsed sideset generation isn't fully supported on distributed meshes
  []
  [fvbcs_disconnected_from_variable]
    design = 'FVNeumannBC.md'
    issues = '#16882 #33435'
    type = RunException
    input = 'fv_neumannbc.i'
    expect_err = "FVFluxBC 'right' for variable 'u' is being triggered on a face .* where the variable is defined on neither side\."
    cli_args = "Mesh/mesh/subdomain_id='1 2' Problem/kernel_coverage_check=false"
    requirement = 'The system shall report an error if a finite volume flux boundary condition is used on a mesh element face that is not connected to an element with the corresponding finite volume variable.'
    allow_warnings = true # parsed sideset generation isn't fully supported on distributed meshes
  []
[]
