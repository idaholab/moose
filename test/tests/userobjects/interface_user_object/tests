[Tests]
    design = 'InterfaceQpValueUserObject.md InterfaceValueUserObjectAux.md'
    [./interface_UO_QP_test]
      type = 'Exodiff'
      input = 'interface_value_user_object_QP.i'
      exodiff = 'interface_value_user_object_QP_out.e'
      requirement = "The system shall correctly compute interface values at quadrature points and "
                 "store them in an auxiliary variable for averaging over a side. At the end of "
                 "the first step it shall report an average material property of 7, an absolute "
                 "jump of 6, a signed jump (primary minus secondary) of 6, a signed jump "
                 "(secondary minus primary) of -6, a value on the primary side of 10, and a "
                 "value on the secondary side of 4."
      issues = '#11647'
      max_threads = 1
    [../]
    [./interface_UO_get_material_test]
      type = 'RunApp'
      input = 'interface_userobject_material_value.i'
      expect_out = ' Solve Converged!'
      requirement = "The system shall be able to get updated bulk, boundary and interface "
                    "material property values from an interface user object, and shall produce "
                    "an error if the computed and retrieved material property are not the same."
      issues = '#14680'
      max_threads = 1
    [../]
    [./interface_Qp_rate_incremement_test]
      type = 'Exodiff'
      input = 'interface_value_rate_increment_user_object_QP.i'
      exodiff = 'interface_value_rate_increment_user_object_QP_out.e'
      requirement = "The system shall correctly compute interface values at quadrature"
                    "points when computing the variable rate or increment."
      issues = '#14680'
      max_threads = 1
    [../]
    [./interface_Qp_real_material]
      type = 'Exodiff'
      input = 'interface_mp_real_user_object_QP.i'
      exodiff = 'interface_mp_real_user_object_QP_out.e'
      requirement = "The system shall correctly compute values with the InterfaceQpMaterialPropertyRealUO."
      issues = '#14680'
      max_threads = 1
    [../]
  []
