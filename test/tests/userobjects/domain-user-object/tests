[Tests]
  [domain_uo]
    type = RunApp
    input = measure-conservation.i
    requirement = 'The system shall be able to execute user objects that perform operations on elements, boundaries, and internal sides.'
    design = 'UserObjects/index.md'
    issues = '#19995'
  []
  [domain_uo_interface]
    type = RunApp
    input = measure-conservation-interface.i
    requirement = 'The system shall be able to execute user objects that perform operations on elements, boundaries, and interfaces.'
    design = 'UserObjects/index.md'
    issues = '#19995'
  []
  [domain_uo_overlapping_interfaces]
    # This test is designed to check whether the system correctly performs DomainUO callbacks and
    # Exodiff checks on partially overlapping sidesets.
    # Without the fix in ComputeUserObjectsThread, the conservation check fails because
    # executeOnBoundary() is mistakenly called for the interface.
    requirement = 'The system shall preserve the solution and domain user object interface conservation check on partially overlapping sidesets'
    design = 'UserObjects/index.md'
    issues = '#34282'
    # finalize() detects missing or repeated DomainUO contributions.
    # Exodiff checks the solution against the same gold file in both cases.
    [higher_id]
      type = Exodiff
      # ParsedGenerateSideset requires a replicated mesh.
      mesh_mode = REPLICATED
      input = overlapping-interface.i
      exodiff = overlapping-interface_out.e
      detail = 'when the selected subset has the higher boundary ID, and'
    []
    [lower_id]
      type = Exodiff
      mesh_mode = REPLICATED
      input = overlapping-interface.i
      cli_args = 'Mesh/renumber/new_boundary="20 10"
                  Outputs/file_base=overlapping-interface_lower_id_out'
      # The gold symlink points to the same overlapping-interface_out.e reference.
      exodiff = overlapping-interface_lower_id_out.e
      detail = 'when the selected subset has the lower boundary ID.'
    []
  []

  [prevent_wrong_boundary_calls]
    # This test is designed to check whether the system correctly performs DomainUO callbacks
    # and does not mistakenly execute executeOnBoundary() on an interface boundary.
    # Without the fix in ComputeUserObjectsThread, the test fails because executeOnBoundary()
    # is called on an interface boundary.
    type = RunApp
    # ParsedGenerateSideset requires a replicated mesh.
    mesh_mode = REPLICATED
    input = overlapping-interface.i
    cli_args = 'UserObjects/conservation/check_interface_calls=false Outputs/exodus=false'
    requirement = 'The system shall be able to execute user objects that perform operations on elements, boundaries, and interfaces and verify that boundary callbacks are not executed on interface boundaries.'
    design = 'UserObjects/index.md'
    issues = '#34282'
  []

  [prevent_wrong_interface_number_calls]
    # This test is designed to check whether the system correctly performs DomainUO callbacks
    # and does not execute the interface callback an incorrect number of times.
    # Without the fix in ThreadedElementLoop, the test fails because executeOnInterface()
    # is called twice on overlapping interfaces.
    type = RunApp
    # ParsedGenerateSideset requires a replicated mesh.
    mesh_mode = REPLICATED
    input = overlapping-interface.i
    cli_args = 'UserObjects/conservation/check_boundary_calls=false Outputs/exodus=false'
    requirement = 'The system shall be able to execute user objects that perform operations on elements, boundaries, and interfaces and verify interface execution counts when boundary call checking is disabled.'
    design = 'UserObjects/index.md'
    issues = '#34282'
  []

  [boundary_selection]
    requirement = 'The system shall execute domain user objects'
    design = 'UserObjects/index.md'
    issues = '#19995 #32413 #34421'
    [unset]
      detail = 'on every boundary not selected as an interface when boundaries is unset,'
      type = RunApp
      mesh_mode = REPLICATED
      input = overlapping-interface.i
      # When boundaries is unset, boundary callbacks run on every non-interface boundary ID. Boundary
      # IDs are not limited to the mesh exterior: crack tags 2 internal sides between blocks 0 and 1,
      # and both are included even though they have neighbors. The 6 calls consist of these 2 crack
      # sides and block 0's 4 exterior sides (2 bottom, 1 left, and 1 right); the overlapping 'new'
      # interface boundary ID is excluded.
      cli_args = 'UserObjects/conservation/expected_boundary_calls=6 Outputs/exodus=false'
    []
    [selected]
      detail = 'only on the boundary IDs listed in boundaries when it is set, and'
      type = RunApp
      mesh_mode = REPLICATED
      input = overlapping-interface.i
      # The selected bottom boundary has 2 element sides in block 0 (nx = 2).
      cli_args = 'UserObjects/conservation/boundaries=bottom UserObjects/conservation/expected_boundary_calls=2 Outputs/exodus=false'
    []
    [empty]
      detail = 'on no boundaries when boundaries is set to an empty list.'
      type = RunApp
      mesh_mode = REPLICATED
      input = overlapping-interface.i
      # An explicitly empty list disables all boundary callbacks without disabling independently
      # selected interface callbacks.
      cli_args = 'UserObjects/conservation/boundaries= UserObjects/conservation/expected_boundary_calls=0 UserObjects/conservation/check_conservation=false Outputs/exodus=false'
    []
  []

  [boundary_selection_accepts_internal_side]
    requirement = 'The system shall execute a domain user object on a selected boundary containing internal sides.'
    design = 'UserObjects/index.md'
    issues = '#19995 #32413 #34421'
    type = RunApp
    mesh_mode = REPLICATED
    input = overlapping-interface.i
    cli_args = 'UserObjects/conservation/boundaries=crack UserObjects/conservation/expected_boundary_calls=2 Outputs/exodus=false'
  []

  [interface_boundary_rejects_external_side]
    requirement = 'The system shall reject a DomainUserObject interface boundary selection containing an external side.'
    design = 'UserObjects/index.md'
    issues = '#19995 #32413 #34421'
    type = RunException
    mesh_mode = REPLICATED
    input = overlapping-interface.i
    cli_args = 'UserObjects/conservation/interface_boundaries=bottom Outputs/exodus=false'
    expect_err = 'contains an external side, but interface boundaries must contain neighbors'
  []

  [boundary_interface_overlap]
    requirement = 'The system shall reject a DomainUserObject boundary ID selected for both boundary and interface execution.'
    design = 'UserObjects/index.md'
    issues = '#19995 #32413 #34421'
    type = RunException
    mesh_mode = REPLICATED
    input = overlapping-interface.i
    cli_args = 'UserObjects/conservation/boundaries=new Outputs/exodus=false'
    expect_err = 'cannot be selected by both boundaries and interface_boundaries'
  []
[]
