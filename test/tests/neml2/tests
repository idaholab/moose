[Tests]
  # The original issue is idaholab/blackbear#333
  issues = '#26450 #26920'
  design = 'NEML2/index.md NEML2Action.md'
  [custom_model]
    requirement = 'The framework shall be capable of running custom NEML2 models implemented in MOOSE (optionally with automatic differentiation).'
    type = Exodiff
    input = 'custom_model.i'
    exodiff = 'custom_model_out.e'
    capabilities = 'libtorch & neml2'
    valgrind = heavy
  []
  # cpp-aoti compile-then-run pipeline: compile the NEML2TestModel to an AOTI artifact, then
  # evaluate it through the cpp-aoti runtime and check it reproduces the cpp-eager result (the
  # run loads the artifact, so it implicitly verifies the compile produced it). Requires the
  # activated neml2 conda environment (neml2-compile on PATH). MOOSE conda environments set CXX
  # to an MPI compiler wrapper, but TorchInductor requires a plain host compiler for AOTI builds.
  [aoti_compile]
    requirement = 'The framework shall compile a NEML2 model to ahead-of-time (AOTI) artifacts.'
    type = RunCommand
    command = 'python3 aoti_compile.py --model model models/custom_model.i --device cpu --output-dir aoti_artifacts --load models/test_models.py -d product:A'
    capabilities = 'libtorch & neml2'
    valgrind = none
    min_slots = 2
  []
  [aoti_run]
    requirement = 'The framework shall evaluate a NEML2 model through the cpp-aoti runtime, reproducing the cpp-eager result.'
    type = Exodiff
    prereq = 'aoti_compile'
    input = 'custom_model_aoti.i'
    exodiff = 'custom_model_aoti_out.e'
    capabilities = 'libtorch & neml2'
    valgrind = none
  []
  # Same cpp-aoti artifact, but with device_batch > 0 so the work is dispatched in
  # device-batch-sized chunks through NEML2's MPISimpleScheduler (device = 'cpu' -> this
  # rank chunks its local batch on the CPU). Chunk boundaries cannot change the result, so
  # it reuses aoti_run's gold; prereq = aoti_run serializes the shared output file.
  [aoti_dispatch]
    requirement = 'The framework shall dispatch cpp-aoti NEML2 evaluation in device-batch-sized chunks (device_batch > 0) via the MPI work scheduler, reproducing the unchunked result.'
    type = Exodiff
    prereq = 'aoti_run'
    input = 'custom_model_aoti.i'
    cli_args = 'NEML2/all/device_batch=32'
    exodiff = 'custom_model_aoti_out.e'
    capabilities = 'libtorch & neml2'
    valgrind = none
  []
  # The same cpp-aoti artifact accepted via its self-describing forms rather than the stub .i: the
  # artifact folder itself, and the metadata.json inside it. Both must reproduce the stub result
  # (same gold). prereq chains onto aoti_dispatch to serialize the shared output file. Unlike the
  # stub (whose artifact_path is an absolute machine path), these reference the relative folder.
  [aoti_run_folder]
    requirement = 'The framework shall load a cpp-aoti NEML2 artifact directly from the artifact folder, without the neml2-compile stub.'
    type = Exodiff
    prereq = 'aoti_dispatch'
    input = 'custom_model_aoti.i'
    cli_args = 'NEML2/all/input=aoti_artifacts/model'
    exodiff = 'custom_model_aoti_out.e'
    capabilities = 'libtorch & neml2'
    valgrind = none
  []
  [aoti_run_metadata]
    requirement = 'The framework shall load a cpp-aoti NEML2 artifact from the metadata.json inside the artifact folder.'
    type = Exodiff
    prereq = 'aoti_run_folder'
    input = 'custom_model_aoti.i'
    cli_args = 'NEML2/all/input=aoti_artifacts/model/metadata.json'
    exodiff = 'custom_model_aoti_out.e'
    capabilities = 'libtorch & neml2'
    valgrind = none
  []
  [variable_dependency]
    requirement = 'The framework shall gather variable dependencies of a NEML2 model to perform selective variable computations in user object loops.'
    type = Exodiff
    input = 'custom_model.i'
    exodiff = 'custom_model_out.e'
    # the presence of this postprocessor declaring a variable dependency triggers the restriction of element reinitialization to the variables that the user objects declare as dependencies. If no dependencies are declared, all variables would be computed by default.
    cli_args = 'Postprocessors/u_avg/type=ElementAverageValue Postprocessors/u_avg/variable=u '
               'Postprocessors/u_avg/execute_on=LINEAR Postprocessors/u_avg/outputs=none'
    prereq = 'custom_model'
    issues = '#34186'
    capabilities = 'libtorch & neml2'
  []
  [neml2_error]
    requirement = 'The framework shall be capable of capturing errors that occur during the evaluation of a NEML2 model.'
    type = RunException
    input = 'custom_model.i'
    cli_args = 'NEML2/all/model=error'
    expect_err = 'NEML2 model evaluation failed with a non-recoverable error'
    collections = 'SYSTEM'
    capabilities = 'libtorch & neml2'
    valgrind = none
  []
  [no_neml2]
    requirement = 'The framework shall throw an error upon instantiation of NEML2 interface objects if NEML2 is not available.'
    type = RunException
    input = 'custom_model.i'
    expect_err = 'The `NEML2` library is required but not enabled'
    collections = 'SYSTEM'
    capabilities = '!neml2'
  []
  [infer_io_type_ambiguous]
