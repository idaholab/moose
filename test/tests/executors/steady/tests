[Tests]
  design = 'SteadyExecutor.md'
  issues = '#32860'

  [steady]
    requirement = 'The system shall provide a steady-state executor that'
    [order]
      type = RunApp
      input = steady.i
      # Disable the live perf graph because the expected output relies on line breaks
      cli_args = '--executor --disable-perf-graph-live'
      expect_out = 'BinaryTestExecutor first BEGIN\nBinaryTestExecutor first END\nBinaryTestExecutor second BEGIN\nBinaryTestExecutor second END'
      capture_perf_graph = false
      detail = 'runs its inner executors in the given order,'
    []
    [output]
      type = CSVDiff
      input = steady.i
      cli_args = '--executor'
      csvdiff = steady_out.csv
      detail = 'outputs the initial condition and the solution,'
    []
    [stop_on_failure]
      type = RunException
      input = steady.i
      cli_args = 'Executors/first/fail_late=true --executor --disable-perf-graph-live'
      expect_err = 'first\(FAIL\): manual late fail'
      absent_out = 'BinaryTestExecutor second BEGIN'
      detail = 'and stops at the first inner executor that does not converge.'
    []
  []

  [retrieve_by_type]
    type = RunException
    input = steady.i
    cli_args = 'Executors/first/steady_inner=second --executor'
    expect_err = "Executor 'second' of type 'BinaryTestExecutor' is not of the requested type "
                 "'SteadyExecutor'"
    requirement = 'The system shall report an error if an executor is retrieved as a type that it '
                  'does not have.'
  []
[]
