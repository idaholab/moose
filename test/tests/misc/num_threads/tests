[Tests]
  design = 'CreateApplicationBlockAction.md'
  issues = '#33724'

  [input_block]
    type = RunApp
    input = test.i
    capabilities = 'threads'
    min_threads = 3
    max_threads = 3
    expect_out = 'Num Threads:\s+2'
    requirement = 'The system shall allow an application to use fewer threads than the process-wide thread pool via a parameter in the input file.'
  []
  [over_request]
    type = RunApp
    input = test.i
    capabilities = 'threads'
    min_threads = 2
    max_threads = 2
    cli_args = 'Application/num_threads=4'
    allow_warnings = true
    expect_out = 'exceeds the process-wide thread count'
    requirement = 'The system shall cap an application to the process-wide thread pool and warn when a larger number of threads than set on the command line is requested in the input file.'
  []
[]
