[Tests]
  issues = '#28380 #28354'
  design = 'Executioner.md'
  [take_vec_mat_types]
    requirement = 'The system shall set vector and matrix types from the PETSc command line option parameters within an input file.'
    input = test.i
    csvdiff = test_out.csv
    type = CSVDiff
    absent_out = 'Option left'
  []
  [preconditioner_flag_overrides_default_pair]
    issues = '#34457'
    requirement = 'The system shall apply a converged reason flag that a preconditioner sets in place of the default that prints only failed linear solves.'
    input = test.i
    type = RunApp
    cli_args = "Preconditioning/smp/type=SMP Preconditioning/smp/petsc_options=-ksp_converged_reason Outputs/csv=false"
    expect_out = 'Linear solve converged due to'
  []
[]
