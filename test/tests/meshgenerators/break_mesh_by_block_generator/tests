[Tests]
  [break_mesh_by_blocks_generator]
    requirement = 'The system shall be able to create separate blocks in a mesh'
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#11640 #22117 #34228'

    [3d_auto_test]
      type = 'Exodiff'
      input = 'break_mesh_3D_auto.i'
      cli_args = '--mesh-only'
      exodiff = 'break_mesh_3D_auto_in.e'
      recover = false
      exodiff_opts = '-pedantic'

      detail = "with directional block-pair interfaces in 3D;"
    []

    [3d_polycrystal_test]
      type = 'Exodiff'
      input = 'break_mesh_3D_polycrystal.i'
      cli_args = '--mesh-only'
      exodiff = 'break_mesh_3D_polycrystal_in.e'
      recover = false
      exodiff_opts = '-pedantic'

      detail = "with a polycrystal based mesh in 3D;"
    []

    [2d_auto_test]
      type = 'Exodiff'
      input = 'break_mesh_2DJunction_auto.i'
      cli_args = '--mesh-only'
      exodiff = 'break_mesh_2DJunction_auto_in.e'
      exodiff_opts = '-pedantic'
      recover = false

      detail = "with directional block-pair interfaces in 2D; and"
    []

    [polycrystal_test]
      type = 'Exodiff'
      input = 'break_mesh_2DJunction_polycrystal.i'
      cli_args = '--mesh-only'
      exodiff = 'break_mesh_2DJunction_polycrystal_in.e'
      recover = false
      exodiff_opts = '-pedantic'

      detail = "with a polycrystal based mesh in 2D."
    []
  []

  [surrounding_block_restricted]
    type = 'Exodiff'
    input = 'break_mesh_block_restricted.i'
    cli_args = '--mesh-only'
    exodiff = 'break_mesh_block_restricted_in.e'
    exodiff_opts = '-pedantic'
    recover = false
    requirement = 'The system shall create separate directional block-pair interfaces within the listed blocks and between the listed blocks and the rest of the mesh.'
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#15895 #34228'
  []

  [block_pairs_restricted]
    type = 'Exodiff'
    input = 'break_mesh_block_pairs_restricted.i'
    cli_args = '--mesh-only break_mesh_block_pairs_restricted_two_sides_interfaces_in.e'
    exodiff = 'break_mesh_block_pairs_restricted_two_sides_interfaces_in.e'
    exodiff_opts = '-pedantic'
    recover = false
    requirement = 'The system shall create separate directional interfaces on both sides between listed block pairs.'
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#17749 #34228'
  []

  [block_pairs_restricted_3blocks]
    requirement = 'The system shall be able to break the mesh between listed block pairs'
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#17749 #34228'
    [one_new_node]
      type = 'Exodiff'
      input = 'break_mesh_block_pairs_restricted_3blocks.i'
      cli_args = "Mesh/split/block_pairs='0 2' --mesh-only "
                 "block_pairs_restricted_3blocks_one_new_node_in.e"
      exodiff = 'block_pairs_restricted_3blocks_one_new_node_in.e'
      exodiff_opts = '-pedantic'
      recover = false
      detail = 'by creating one new node.'
    []
    [two_new_nodes]
      type = 'Exodiff'
      input = 'break_mesh_block_pairs_restricted_3blocks.i'
      cli_args = "Mesh/split/block_pairs='0 1' --mesh-only "
                 "block_pairs_restricted_3blocks_two_new_nodes_in.e"
      exodiff = 'block_pairs_restricted_3blocks_two_new_nodes_in.e'
      exodiff_opts = '-pedantic'
      recover = false
      detail = 'by creating two new nodes.'
    []
    [three_new_nodes]
      type = 'Exodiff'
      input = 'break_mesh_block_pairs_restricted_3blocks.i'
      cli_args = "Mesh/split/block_pairs='0 2;0 1' --mesh-only "
                 "block_pairs_restricted_3blocks_three_new_nodes_in.e"
      exodiff = 'block_pairs_restricted_3blocks_three_new_nodes_in.e'
      exodiff_opts = '-pedantic'
      recover = false
      detail = 'by creating three new nodes.'
    []
  []

  [hanging_nodes]
    type = 'Exodiff'
    input = 'hanging_nodes_parallel.i'
    exodiff = 'hanging_nodes_parallel_out.e'
    exodiff_opts = '-pedantic'
    requirement = 'The system shall properly assign node processor ids for paritioned meshes'
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#15793 #34228'
    min_parallel = 12
    max_parallel = 12
    recover = false
  []

  [deprecated_parameters]
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#34228'
    requirement = 'The system shall preserve the default mesh and warn when a deprecated interface option is explicitly enabled:'
    # Run in sequence because these cases share the default mesh output filename.
    [split_interface]
      type = Exodiff
      input = break_mesh_2DJunction_auto.i
      cli_args = 'Mesh/breakmesh/split_interface=true --mesh-only'
      exodiff = 'break_mesh_2DJunction_auto_in.e'
      exodiff_opts = '-pedantic'
      prereq = 'break_mesh_by_blocks_generator/2d_auto_test'
      expect_out = 'split_interface.*Remove this parameter'
      no_error_deprecated = true
      recover = false
      detail = 'the split_interface option.'
    []
    [add_interface_on_two_sides]
      type = Exodiff
      input = break_mesh_2DJunction_auto.i
      cli_args = 'Mesh/breakmesh/add_interface_on_two_sides=true --mesh-only'
      exodiff = 'break_mesh_2DJunction_auto_in.e'
      exodiff_opts = '-pedantic'
      prereq = 'deprecated_parameters/split_interface'
      expect_out = 'add_interface_on_two_sides.*Remove this parameter'
      no_error_deprecated = true
      recover = false
      detail = 'the add_interface_on_two_sides option.'
    []
    [split_transition_interface]
      type = Exodiff
      input = break_mesh_2DJunction_auto.i
      cli_args = 'Mesh/breakmesh/split_transition_interface=true --mesh-only'
      exodiff = 'break_mesh_2DJunction_auto_in.e'
      exodiff_opts = '-pedantic'
      prereq = 'deprecated_parameters/add_interface_on_two_sides'
      expect_out = 'split_transition_interface.*Remove this parameter'
      no_error_deprecated = true
      recover = false
      detail = 'the split_transition_interface option.'
    []
  []

  [unsupported_parameters]
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#34228'
    requirement = 'The system shall reject disabling the deprecated interface options:'
    [split_interface]
      type = RunException
      input = break_mesh_2DJunction_auto.i
      cli_args = 'Mesh/breakmesh/split_interface=false --mesh-only'
      expect_err = 'Setting split_interface=false is no longer supported'
      no_error_deprecated = true
      detail = 'the split_interface option.'
    []
    [add_interface_on_two_sides]
      type = RunException
      input = break_mesh_2DJunction_auto.i
      cli_args = 'Mesh/breakmesh/add_interface_on_two_sides=false --mesh-only'
      expect_err = 'Setting add_interface_on_two_sides=false is no longer supported'
      no_error_deprecated = true
      detail = 'the add_interface_on_two_sides option.'
    []
    [split_transition_interface]
      type = RunException
      input = break_mesh_2DJunction_auto.i
      cli_args = 'Mesh/breakmesh/split_transition_interface=false --mesh-only'
      expect_err = 'Setting split_transition_interface=false is no longer supported'
      no_error_deprecated = true
      detail = 'the split_transition_interface option.'
    []
  []

  [invalid_block_pair]
    type = RunException
    input = break_mesh_block_pairs_restricted.i
    cli_args = 'Mesh/split/block_pairs="0 missing;2 3"'
    expect_err = "The block 'missing' was not found in the mesh"
    requirement = "The system shall report an error if the mesh does not contain the specified block "
                  "pair"
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#22117'
  []

  [invalid_surrounding_block]
    type = RunException
    input = break_mesh_block_restricted.i
    cli_args = 'Mesh/split/surrounding_blocks="missing"'
    expect_err = "The block 'missing' was not found in the mesh"
    requirement = "The system shall report an error if the mesh does not contain the specified "
                  "surrounding block"
    design = 'meshgenerators/BreakMeshByBlockGenerator.md'
    issues = '#22117'
  []
[]
