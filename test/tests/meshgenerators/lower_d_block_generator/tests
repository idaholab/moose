[Tests]
  design = 'meshgenerators/LowerDBlockFromSidesetGenerator.md'
  [mesh]
    requirement = 'The system shall be able to create different subdomains (with first order elements)'
    issues = '#11640'
    [ids]
      type = 'Exodiff'
      input = 'ids.i'
      exodiff = 'ids_out.e'
      mesh_mode = 'REPLICATED'
      recover = false
      detail = 'using boundary ids.'
    []
    [names]
      type = 'Exodiff'
      input = 'names.i'
      exodiff = 'names_out.e'
      detail = 'using boundary names.'
      mesh_mode = 'REPLICATED'
      recover = false
    []
  []

  [second_order]
    requirement = "The system shall support the creation of lower dimensional elements on an "
                  "existing sideset of second-order elements."
    issues = '#13814'
    type = Exodiff
    exodiff = 'lower_d_second_order_out.e'
    input = 'ids.i'
    mesh_mode = REPLICATED
    cli_args = 'Mesh/second_order=true Outputs/file_base=lower_d_second_order_out '
                 'GlobalParams/order=SECOND Mesh/gmg/nx=5 Mesh/gmg/ny=5'
  []
  [error]
    type = 'RunException'
    input = 'names.i'
    cli_args = 'Mesh/lower_d_block/sidesets=invalid --mesh-only'
    requirement = 'The system shall report an error if a non-existing sideset is specified as the sideset to create a lower-dimensional block from.'
    issues = '#24638 #22117'
    expect_err = 'The sideset \'invalid\' was not found within the mesh'
  []
  [refine_before]
    type = 'Exodiff'
    input = 'refine-before-lower-d.i'
    exodiff = 'refine-before-lower-d_in.e'
    cli_args = '--mesh-only'
    recover = false
    requirement = 'The system shall support creating lower dimensional elements from a sideset that has been refined by preceding refinement generators.'
    issues = '#24638 #22117'
  []
[]
