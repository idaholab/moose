[Tests]
  design = 'Exodus.md'
  [polygons]
    issues = '#32159'
    requirement = 'The system shall be able to compare Exodus files holding polygons, whose elements have differing node counts within a single element block,'
    [mapped]
      type = Exodiff
      input = 'polygons_exodus.i'
      cli_args = '--mesh-only'
      exodiff = 'polygons_exodus_in.e'
      recover = false
      detail = 'matching elements by their location,'
    []
    [file_order]
      type = Exodiff
      input = 'polygons_exodus.i'
      cli_args = '--mesh-only'
      exodiff = 'polygons_exodus_in.e'
      map = false
      exodiff_opts = '-pedantic'
      recover = false
      detail = 'and comparing their connectivity in file order,'
    []
    [many_sides]
      type = Exodiff
      input = 'polygons_many_sides.i'
      cli_args = '--mesh-only'
      exodiff = 'polygons_many_sides_in.e'
      exodiff_opts = '-pedantic'
      recover = false
      detail = 'including the sidesets of polygons with more than eight sides.'
    []
  []
  [polygon_variables]
    issues = '#32159'
    requirement = 'The system shall be able to compare nodal and elemental variables on a polygon mesh,'
    [same_order]
      type = Exodiff
      input = 'polygons_variables.i'
      exodiff = 'polygons_variables_out.e'
      detail = 'with the elements in the same order in both files,'
    []
    [reordered]
      type = Exodiff
      input = 'polygons_variables_reordered.i'
      exodiff = 'polygons_variables_out.e'
      cli_args = 'Outputs/file_base=polygons_variables_out'
      prereq = 'polygon_variables/same_order'
      detail = 'and with elements of differing node counts written in a different order, matching them by location.'
    []
  []
[]
