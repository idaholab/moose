[Tests]
  design = 'syntax/Controls/index.md NumFailedTimeSteps.md'
  issues = '#34337'
  [retry]
    requirement = 'The system shall support controls executed when a time step fails.'
    [same_dt_without_predictor]
      type = CSVDiff
      input = 'retry_without_predictor.i'
      csvdiff = 'retry_without_predictor_out.csv'
      restep = false # the controls act on the failed time step
      detail = 'These controls can repeat a time step that failed at the minimum time step size '
               'once with the same size and without the predictor.'
    []
    [stop_on_second_failure]
      type = RunException
      input = 'retry_without_predictor.i'
      cli_args = "Problem/fail_steps='3 3' Controls/keep_dt/function=1"
      expect_err = 'Solve failed and timestep already at or below dtmin, cannot continue!'
      restep = false # the controls act on the failed time step
      detail = 'The simulation stops if the repeated time step fails again at the minimum time '
               'step size.'
    []
  []
[]
