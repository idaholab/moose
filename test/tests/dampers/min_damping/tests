[Tests]
  issues = '#7856'
  [./min_nodal_damping]
    type = 'RunApp'
    input = 'min_nodal_damping.i'
    expect_out = "From damper: 'limit' damping below min_damping"
    min_threads = 2
    min_parallel = 2
    design = 'source/dampers/BoundingValueNodalDamper.md'
    requirement = "The system shall report if the BoundingValueNodalDamper minimum value is greater than the maximum value."
  [../]
  [./min_elem_damping]
    type = 'RunApp'
    input = 'min_elem_damping.i'
    expect_out = "From damper: 'limit' damping below min_damping"
    min_threads = 2
    min_parallel = 2
    design = 'source/dampers/BoundingValueElementDamper.md'
    requirement = "The system shall report if the BoundingValueElementDamper minimum value is greater than the maximum value."
  [../]
  [./min_general_damping]
    type = 'RunException'
    input = 'min_general_damping.i'
    expect_err = "Solve failed and timestep already at or below dtmin"
    design = 'syntax/Dampers/index.md'
    requirement = "The system shall, through the Damper system, error if the damping value is below a minimum."
  [../]
