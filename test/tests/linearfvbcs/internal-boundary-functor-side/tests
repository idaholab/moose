[Tests]
  design = 'LinearFVAdvectionDiffusionFunctorDirichletBC.md LinearFVAnisotropicDiffusionFunctorNeumannBC.md'
  issues = '#31995'
  [dirichlet]
    type = CSVDiff
    input = internal-boundary.i
    csvdiff = dirichlet.csv
    cli_args = 'Outputs/file_base=dirichlet'
    abs_zero = 1e-10
    max_threads = 1 # see libmesh issue #3808
    requirement = 'The system shall evaluate a Dirichlet boundary functor defined on both sides of an internal boundary on the side of the linear finite volume variable.'
  []
  [anisotropic-neumann]
    type = CSVDiff
    input = internal-boundary.i
    csvdiff = anisotropic-neumann.csv
    cli_args = "LinearFVKernels/active=anisotropic_diffusion "
               "LinearFVBCs/active='left anisotropic_neumann' "
               "Functions/exact/expression='2*x' "
               "Outputs/file_base=anisotropic-neumann"
    abs_zero = 1e-10
    max_threads = 1 # see libmesh issue #3808
    requirement = 'The system shall evaluate an anisotropic Neumann boundary flux functor defined only on the side of an internal boundary opposite to the linear finite volume variable.'
  []
[]
