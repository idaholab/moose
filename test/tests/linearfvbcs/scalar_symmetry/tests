[Tests]
  design = 'LinearFVAdvectionDiffusionFunctorRobinBC.md'
  issues = '#30866 #32995'

  [diffusion-1d-symmetry]
    type = MMSTest
    input = 'test.py'
    test_case = TestDiffusion1DSymmetry
    requirement = 'The system shall display second-order convergence with respect to a manufactured solution for the 1D steady diffusion equation, which shall be solved numerically using a linear finite volume system with symmetry boundary condition.'
    max_threads = 1 # see libmesh issue #3808
  []

  [advection-1d-symmetry]
    type = MMSTest
    input = 'test.py'
    test_case = TestAdvection1DSymmetry
    requirement = 'The system shall display second-order convergence with respect to a manufactured solution for the 1D steady advection equation, which shall be solved numerically in a linear finite volume system with symmetry boundary condition.'
    max_threads = 1 # see libmesh issue #3808
  []

  [advection-1d-symmetry-gradient-method]
    type = MMSTest
    input = 'test.py'
    test_case = TestAdvection1DSymmetryGradientMethod
    requirement = 'The system shall allow a linear finite volume variable to use a named limited Green-Gauss gradient method when gradients are consumed by a two-term linear finite volume advection boundary condition.'
    max_threads = 1 # see libmesh issue #3808
  []

  [advection-2d-symmetry-lagged-gradient-publication]
    type = CSVDiff
    input = 'advection-2d-symmetry.i'
    cli_args = 'gradient_method=gg advected_interp_method=muscl '
               'Convergence/linear/max_iterations=4 '
               'Outputs/file_base=lagged-gradient-publication Outputs/exodus=false'
    csvdiff = 'lagged-gradient-publication.csv'
    requirement = 'The system shall compute all linear finite volume gradient methods for a variable from the same lagged gradient values before replacing their current values.'
    max_threads = 1 # see libmesh issue #3808
  []

  [advection-1d-symmetry-two-gradient-methods]
    type = MMSTest
    input = 'test.py'
    test_case = TestAdvection1DSymmetryTwoGradientMethods
    requirement = 'The system shall allow two linear finite volume variables on the same system to use different named Green-Gauss gradient method objects when gradients are consumed by two-term linear finite volume advection boundary conditions.'
    max_threads = 1 # see libmesh issue #3808
  []

  [diffusion-2d-symmetry]
    type = MMSTest
    input = 'test.py'
    test_case = TestDiffusion2DSymmetry
    requirement = 'The system shall display second-order convergence with respect to a manufactured solution for the 2D steady diffusion equation, which shall be solved numerically using a linear finite volume system with symmetry boundary conditions.'
    min_slots = 2 # Memory heavy
    max_threads = 1 # see libmesh issue #3808
  []

  [advection-2d-symmetry]
    type = MMSTest
    input = 'test.py'
    test_case = TestAdvection2DSymmetry
    requirement = 'The system shall display second-order convergence with respect to a manufactured solution for the 2D steady advection equation, which shall be solved numerically using a linear finite volume system with symmetry boundary conditions.'
    max_threads = 1 # see libmesh issue #3808
  []

  [diffusion-2d-symmetry-nonorthogonal]
    type = MMSTest
    input = 'test.py'
    test_case = TestDiffusion2DSymmetryNonOrthogonal
    requirement = 'The system shall display second-order convergence with respect to a manufactured solution for the 2D steady diffusion equation, which shall be solved numerically on nonorthogonal cells using a linear finite volume system with symmetry boundary conditions.'
    max_threads = 1 # see libmesh issue #3808
  []

  [advection-2d-symmetry-nonorthogonal]
    type = MMSTest
    input = 'test.py'
    test_case = TestAdvection2DSymmetryNonOrthogonal
    requirement = 'The system shall display second-order convergence with respect to a manufactured solution for the 2D steady advection equation, which shall be solved numerically on nonorthogonal cells using a linear finite volume system with symmetry boundary conditions.'
    max_threads = 1 # see libmesh issue #3808
  []
[]
