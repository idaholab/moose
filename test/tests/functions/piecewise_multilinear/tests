[Tests]
  issues = '#2476'
  design = 'source/functions/PiecewiseMultilinear.md'
  [./except1]
    type = 'RunException'
    input = 'except1.i'
    expect_err = "Error opening file .* from GriddedData."
    max_parallel = 1
    requirement = "The system shall error if the file supplied to the PiecewiseMultilinear object fails to open."
  [../]
  [./except2]
    type = 'RunException'
    input = 'except2.i'
    expect_err = "PiecewiseMultiInterpolation needs monotonically-increasing axis data.  Axis 0 contains non-monotonicity at value -1"
    max_parallel = 1
    requirement = "The system shall error if the data supplied to the PiecewiseMultiInterpolation object is not monotonically increasing."
  [../]
  [./except3]
    type = 'RunException'
    input = 'except3.i'
    expect_err = "According to AXIS statements in GriddedData, number of data points is 2 but 3 function values were read from file"
    max_parallel = 1
    requirement = "The system shall error if the number of functions requested by the PiecewiseMultiInterpolation object differ than the number available from the file."
  [../]
  [./except4]
    type = 'RunException'
    input = 'except4.i'
    expect_err = "PiecewiseMultiInterpolation needs the AXES to be independent.  Check the AXIS lines in your data file."
    max_parallel = 1
    requirement = "The system shall error if the axes supplied to the PiecewiseMultiInterpolation are not independent."
  [../]
  [./except5]
    type = 'RunException'
    input = 'except5.i'
    expect_err = "No valid AXIS lines found by GriddedData"
    max_parallel = 1
    requirement = "The system shall error if the PiecewiseMultilinear axis lines are not located in the supplied data."
  [../]

  [./oneDa]
    type = 'CSVDiff'
    input = 'oneDa.i'
    csvdiff = 'oneDa.csv'
    abs_zero = 1E-8
    requirement = "The system shall perform PiecewiseMultilinear interpolation on a 1D domain."
  [../]
  [./oneDb]
    type = 'CSVDiff'
    input = 'oneDb.i'
    csvdiff = 'oneDb.csv'
    abs_zero = 1E-8
    requirement = "The system shall perform PiecewiseMultilinear interpolation on a 1D domain that compares to an equivalent known function."
  [../]

  [./time]
    type = 'CSVDiff'
    input = 'time.i'
    csvdiff = 'time.csv'
    abs_zero = 1E-8
    requirement = "The system shall perform PiecewiseMultilinear interpolation of time-dependent data."
  [../]

  [./twoDa]
    type = 'CSVDiff'
    input = 'twoDa.i'
    csvdiff = 'twoDa.csv'
    abs_zero = 1E-8
    requirement = "The system shall perform PiecewiseMultilinear interpolation on a 2D domain."
  [../]
  [./twoDb]
    type = 'Exodiff'
    input = 'twoDb.i'
    exodiff = 'twoDb.e'
    rel_err = 1E-5
    use_old_floor = True
    requirement = "The system shall perform PiecewiseMultilinear interpolation on a 2D domain that compares to an equivalent known function."
  [../]

  [./twoD_const]
    type = 'Exodiff'
    input = 'twoD_const.i'
    exodiff = 'twoD_const.e'
    requirement = "The system shall perform PiecewiseMultilinear constant interpolation on a 2D domain."
  [../]

  [./fourDa]
    type = 'Exodiff'
    input = 'fourDa.i'
    exodiff = 'fourDa.e'
    rel_err = 1E-5
    use_old_floor = True
    requirement = "The system shall perform PiecewiseMultilinear interpolation on a 3D domain with time-dependent data."
  [../]
[]
