[Tests]
  design = 'CoupledValueFunctionMaterial.md'
  issues = '#20193'

  [order]
    type = Exodiff
    input = order.i
    exodiff = order_out.e
    requirement = "The system shall, by default, map coupled variables to the x,y,z, and t function parameters."
  []
  [order_shuffled]
    type = Exodiff
    input = order.i
    cli_args = 'Materials/cvf/v="d c b a" Materials/cvf/parameter_order="T Z Y X"'
    exodiff = order_out.e
    requirement = "The system shall allow the user to provide a custom mapping of coupled variables to "
                  "function parameters."
  []

  [order_duplicate_error]
    type = RunException
    input = order.i
    cli_args = 'Materials/cvf/parameter_order="Y Z Z T"'
    expect_err = 'You must not repeat any positions.'
    requirement = "The system shall raise an error for duplicate positions in the coupled variable "
                  "mapping to function parameters."
  []
  [order_count_error]
    type = RunException
    input = order.i
    cli_args = 'Materials/cvf/parameter_order="Y Z X"'
    expect_err = 'Specify either as many items as coupled variables, or none at all for the default '
                 'order of x,y,z,t.'
    requirement = "The system shall raise an error if a number of positions in mapping to function parameters that does not match the "
                  "number of coupled variable is provided."
  []

  [adjac]
    type = PetscJacobianTester
    input = adjac.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    issues = '#20193'
    requirement = "The system shall return, using the ADCoupledValueFunctionMaterial, correct derivatives for coupled "
                  "AD variables."
  []
[]
