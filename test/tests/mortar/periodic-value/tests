[Tests]
  design = 'Constraints/index.md'
  issues = '#13080'
  [exo]
    type = Exodiff
    input = periodic.i
    exodiff = periodic_out.e
    requirement = 'The system shall be able to enforce periodic boundary conditions on a non-uniform mesh using the mortar method'
  []
  [jac]
    type = PetscJacobianTester
    input = periodic.i
    run_sim = True
    difference_tol = 1e-7
    cli_args = 'Mesh/file/file=square_coarse.msh'
    requirement = 'The system shall compute a perfect Jacobian for mortar enforcement of periodic boundary conditions'
  []
[]
