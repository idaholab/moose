[Tests]
  design = 'Constraints/index.md'
  issues = '#13080'
  [./real_mortar_gap_conductance]
    type = Exodiff
    input = 'gap-conductance.i'
    exodiff = 'gap-conductance_out.e'
    requirement = 'The system shall be able to produce the expected result for a gap conductance test case using the mortar method. Specifically, the Lagrange multipliers shall be correctly proportional to the delta of temperature across the gap, e.g. the heat flux'
  [../]
  [gap_jacobian]
    type = PetscJacobianTester
    run_sim = True
    input = 'gap-conductance.i'
    difference_tol = 1e-7
    requirement = 'The system shall compute a perfect Jacobian for the gap conductance test case'
    prereq = 'real_mortar_gap_conductance'
  []
  [gap_conductance_fine]
    type = Exodiff
    input = 'gap-conductance.i'
    cli_args = 'Mesh/file/file=nodal_normals_test_offset_nonmatching_gap_fine.e Outputs/file_base=gap-conductance-fine_out'
    exodiff = 'gap-conductance-fine_out.e'
    requirement = 'The system shall be able to produce the expected result for a gap conductance test case using the mortar method on a fine mesh. Specifically, the Lagrange multipliers shall be correctly proportional to the delta of temperature across the gap, e.g. the heat flux'
  [../]
[]
