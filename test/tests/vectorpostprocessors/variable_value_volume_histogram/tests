[Tests]
  [test]
    type = CSVDiff
    input = volume_histogram.i
    csvdiff = 'volume_histogram_out_histo_0002.csv'

    requirement = 'The system shall allow support the creation of histogram or binned data of volume fractions with respect to variable values.'
    issues = '#7803 #7801'
    design = 'VariableValueVolumeHistogram.md'
  []
  [variable_bnds]
    type = CSVDiff
    input = pp_bounds.i
    csvdiff = 'pp_bounds_out_histo_0001.csv'
    requirement = "The system shall be able to change the bounds of the histogram computed for a variable value."
    issues = '#33787'
    design = 'VariableValueVolumeHistogram.md'
  []
  [valid_bnds]
    type = RunException
    input = pp_bounds.i
    cli_args = 'VectorPostprocessors/histo/min_value=1.0 VectorPostprocessors/histo/max_value=0.0'
    expect_err = 'max_value is less than or equal to min_value!'
    requirement = "The system shall ensure that the bounds of the histogram computed for a variable are valid."
    issues = '#33787'
    design = 'VariableValueVolumeHistogram.md'
  []
[]
