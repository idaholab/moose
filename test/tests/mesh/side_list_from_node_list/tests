[Tests]
  [missing_side_set]
    type = 'RunException'
    input = 'side_list_from_node_list.i'
    expect_err = 'the following side sets \(ids\) do not exist on the mesh: 2.*The following boundary id exists as a node set but is being requested as a side set: 2.*Mesh/construct_side_list_from_node_list=true'

    requirement = 'The system shall issue a diagnostic when a boundary requested as a side set exists only as a node set and identify the mesh option for constructing side sets from node sets.'
    design = 'MooseMesh.md'
    issues = '#13509 #33022'
  []

  [construct_side_sets]
    type = 'Exodiff'
    input = 'side_list_from_node_list.i'
    cli_args = 'Mesh/construct_side_list_from_node_list=true'
    exodiff = 'side_list_from_node_list_out.e'

    requirement = 'The system shall have the ability to construct a side set from a set of nodes.'
    design = 'MooseMesh.md'
    issues = '#13509'
  []

  [construct_side_sets_exterior_only]
    type = 'Exodiff'
    input = 'side_list_from_node_list_exterior_only.i'
    cli_args = "--mesh-only"
    exodiff = 'side_list_from_node_list_exterior_only_in.e'
    recover = false
    exodiff_opts = '-pedantic'

    requirement = 'The system shall have the ability to exclude sides that are interior to the '
                 'mesh when constructing a side set from a set of nodes, so that a node set '
                 'spanning both faces of a mesh that is a single element layer deep does not '
                 'spuriously add interior sides to the side set.'
    design = 'MooseMesh.md'
    issues = '#30917'
  []

[]
