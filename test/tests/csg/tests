[Tests]
  design = 'CSGBase.md'
  issues = '#29095'
  [geometry]
    requirement = "The system shall support the generation of Constructive Solid Geometry (CSG) representations by correctly constructing a CSG object that "
    [csg_only]
      type = 'JSONDiff'
      input = 'csg_only_inf_planes.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_only_inf_planes_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'is uniquely generated from a single mesh generator input.'
    []
    [csg_only_chained]
      type = 'JSONDiff'
      input = 'csg_only_chained.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_only_chained_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'updates an existing CSG representation from another mesh generator.'
    []
    [csg_only_chained_with_universe_cell_deletion]
      type = 'JSONDiff'
      input = 'csg_only_chained_with_universe_cell_deletion.i'
      cli_args = '--csg-only csg_only_chained_out_csg.json'
      jsondiff = 'csg_only_chained_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'that properly handles cell and universe deletion from CSGBase.'
    []
    [csg_only_one_to_many_dependencies]
      type = 'JSONDiff'
      input = 'csg_only_one_to_many_deps.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_only_one_to_many_deps_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'has a single mesh generator depend on multiple downstream mesh generators.'
    []
    [csg_only_cart_lattice]
      type = 'JSONDiff'
      input = 'csg_lattice_cart.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_lattice_cart_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'uses multiple existing CSG representations from other mesh generators to create a Cartesian lattice.'
    []
    [csg_only_hex_lattice]
      type = 'JSONDiff'
      input = 'csg_lattice_hex.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_lattice_hex_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'uses multiple existing CSG representations from other mesh generators to create a hexagonal lattice.'
    []
    [csg_only_nested_lattices]
      type = 'JSONDiff'
      input = 'csg_lattice_nested.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_lattice_nested_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'has nested lattice structures built from existing CSG representations.'
    []
    [csg_only_final_generator]
      type = 'JSONDiff'
      input = 'csg_only_chained.i'
      cli_args = 'Mesh/final_generator=inf_square --csg-only csg_only_inf_planes_out_csg.json'
      jsondiff = 'csg_only_inf_planes_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'specifies a final generator to create a CSG representation for an intermediate generator.'
    []
    [csg_only_poly_unit]
      type = 'JSONDiff'
      input = 'csg_only_poly_unit.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_only_poly_unit_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'includes an engineering unit.'
    []
    [csg_only_poly_unit_cli_expand]
      type = 'JSONDiff'
      input = 'csg_only_poly_unit.i'
      cli_args = 'inactive=CSG --csg-only csg_only_poly_unit_expand_out_csg.json'
      jsondiff = 'csg_only_poly_unit_expand_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'includes an engineering unit that is expanded by default when generated from the command line without a CSG block.'
    []
    [csg_only_poly_unit_expand]
      type = 'JSONDiff'
      input = 'csg_only_poly_unit_expand.i'
      cli_args = '--csg-only'
      jsondiff = 'csg_only_poly_unit_expand_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'includes an engineering unit that has been expanded.'
    []
  []
  [input_block]
    requirement = "The system shall support controlling the generation of Constructive Solid Geometry (CSG) representations from the input file "
    design = 'CSGAction.md syntax/CSG/index.md'
    issues = '#34321'
    [block_enables_csg_only]
      type = 'JSONDiff'
      input = 'csg_block_empty.i'
      jsondiff = 'csg_block_empty_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'by the presence of an empty CSG block alone,'
    []
    [output_file]
      type = 'JSONDiff'
      input = 'csg_only_chained_with_universe_cell_deletion.i'
      cli_args = 'CSG/output_file=csg_only_chained_out_csg.json'
      jsondiff = 'csg_only_chained_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'with a user-specified output file name,'
    []
    [cli_output_file_precedence]
      type = 'JSONDiff'
      input = 'csg_only_inf_planes.i'
      cli_args = 'CSG/output_file=csg_block_unused_out_csg.json --csg-only csg_only_inf_planes_out_csg.json'
      jsondiff = 'csg_only_inf_planes_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'with the output file name from the command line taking precedence over the input file,'
    []
    [disabled_block_with_cli]
      type = 'JSONDiff'
      input = 'csg_only_chained.i'
      cli_args = 'Mesh/final_generator=inf_square CSG/csg_only=false CSG/output_file=csg_only_inf_planes_out_csg.json --csg-only'
      jsondiff = 'csg_only_inf_planes_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'with the output options applied when CSG-only mode is disabled in the input file but enabled from the command line,'
    []
    [expand_units]
      type = 'JSONDiff'
      input = 'csg_only_poly_unit_expand.i'
      jsondiff = 'csg_only_poly_unit_expand_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'with all engineering units expanded before output by default,'
    []
    [retain_units]
      type = 'JSONDiff'
      input = 'csg_only_poly_unit.i'
      jsondiff = 'csg_only_poly_unit_out_csg.json'
      recover = false
      mesh_mode = REPLICATED
      detail = 'with engineering units retained when requested, and'
    []
    [mesh_only_precedence]
      type = 'RunApp'
      input = '../meshgenerators/generated_mesh_generator/generated_mesh_generator.i'
      cli_args = 'CSG/csg_only=true --mesh-only csg_block_mesh_only_in.e'
      expect_out = 'csg_only = true is ignored because --mesh-only was passed on the command line'
      allow_warnings = true
      recover = false
      detail = 'with a warning when CSG-only mode is overridden by another command line execution mode.'
    []
  []
  [errors]
    requirement = 'The system shall report an error when generating a mesh in CSG-only mode when'
    [csg_only_chained_not_moved]
      type = 'RunException'
      input = 'csg_only_chained_not_moved.i'
      detail = ' a CSG object from an input mesh generator is not moved upon retrieval.'
      cli_args = '--csg-only'
      expect_err = "The CSGBase object from input ExampleCSGInfiniteSquareMeshGenerator 'csg_inf_square' was not moved."
      mesh_mode = REPLICATED
    []
    [distributed_mesh]
      type = RunException
      input = 'csg_only_inf_planes.i'
      detail = ' used in conjunction with distributed mesh command line option'
      cli_args = '--distributed-mesh --csg-only'
      expect_err = "--csg-only cannot be used in conjunction with --distributed-mesh"
    []
    [distributed_mesh_input_block]
      type = RunException
      input = 'csg_only_inf_planes.i'
      design = 'CSGAction.md'
      issues = '#34321'
      detail = ' enabled from the input file and used in conjunction with distributed mesh command line option'
      cli_args = 'CSG/csg_only=true --distributed-mesh'
      expect_err = "--csg-only cannot be used in conjunction with --distributed-mesh"
    []
    [split_mesh]
      type = RunException
      input = 'csg_only_inf_planes.i'
      detail = ' used in conjunction with split mesh command line option.'
      cli_args = '--use-split --csg-only'
      expect_err = "--csg-only is not compatible with any mesh splitting options"
      mesh_mode = REPLICATED
    []
    [refinements]
      type = RunException
      input = 'csg_only_inf_planes.i'
      detail = ' used in conjunction with mesh refinements command line option.'
      cli_args = '-r 5 --csg-only'
      expect_err = "--csg-only cannot be used in conjunction with -r refinements option"
      mesh_mode = REPLICATED
    []
    [recover]
      type = RunException
      input = 'csg_only_inf_planes.i'
      detail = ' used in conjunction with recovery command line option.'
      cli_args = '--recover --csg-only'
      expect_err = "--csg-only option cannot be used in recovery mode"
      mesh_mode = REPLICATED
    []
  []
[]
