[Tests]
  design = PhysicsBasedPreconditioner.md
  issues = '#1048 #18777'

  [pbp]
    requirement = "The system shall support the use of a physics based preconditioner"
    [test]
      type = 'Exodiff'
      input = 'pbp_test.i'
      exodiff = 'out.e'
      max_parallel = 1

      detail = "without and"
    []

    [pbp_adapt_test]
      type = 'Exodiff'
      input = 'pbp_adapt_test.i'
      exodiff = 'out_pbp_adapt.e-s004'
      custom_cmp = 'pbp_adapt_test.cmp'
      group = 'adaptive'

      detail = "with mesh adaptivity."
    []
  []

  [pc_type_conflict]
    requirement = "The system shall error if a physics based preconditioner is set up alongside "
                  "an explicit '-pc_type' PETSc option, since the option would silently override "
                  "and disable the preconditioner, when the option is set in the"
    issues = '#18190'
    [executioner]
      type = 'RunException'
      input = 'pbp_test.i'
      cli_args = "Executioner/petsc_options_iname='-pc_type' Executioner/petsc_options_value='lu'"
      expect_err = "overrides the preconditioner set up in this Preconditioning block"

      detail = "executioner or"
    []
    [preconditioning]
      type = 'RunException'
      input = 'pbp_test.i'
      cli_args = "Preconditioning/PBP/petsc_options_iname='-pc_type' "
                 "Preconditioning/PBP/petsc_options_value='lu'"
      expect_err = "overrides the preconditioner set up in this Preconditioning block"

      detail = "preconditioning block."
    []
  []

  [check_petsc_options_test]
    type = 'RunApp'
    input = 'pbp_test_options.i'
    expect_out = 'Linear'
    max_parallel = 1

    requirement = "The system shall support the ability to add arbitrary options to the solver when "
                  "using a physics based precondioner."
  []

  [lots_of_variables]
    type = 'Exodiff'
    input = 'lots_of_variables.i'
    exodiff = 'lots_of_variables_out.e'
    requirement = "The system shall support the ability to control the variable solve order when "
                  "using a physics base preconditioner."
  []
[]
