[Tests]
  design = 'VariableCondensationPreconditioner.md'
  issues = '#15215'
  [condense_amg_test]
    type = 'CSVDiff'
    input = 'vcp_test.i'
    csvdiff = 'vcp_test_out.csv'
    requirement = "The system shall converge when using the VCP interface with AMG as the "
                  "preconditioner."
    mesh_mode = 'replicated'
  []
  [condense_amg_test_dinv]
    type = 'CSVDiff'
    input = 'vcp_test.i'
    csvdiff = 'vcp_test_out.csv'
    cli_args = 'Preconditioning/vcp/is_lm_coupling_diagonal=false'
    requirement = "The system shall converge while computing the full inverse of the coupling "
                  "matrix."
    mesh_mode = 'replicated'
  []
  [pc_type_conflict]
    type = 'RunException'
    input = 'vcp_test.i'
    cli_args = "Executioner/petsc_options_iname='-pc_type' Executioner/petsc_options_value='lu'"
    expect_err = "overrides the preconditioner set up in this Preconditioning block"
    mesh_mode = 'replicated'
    issues = '#18190'
    requirement = "The system shall error if a variable condensation preconditioner is set up "
                  "alongside an explicit '-pc_type' PETSc option, since the option would silently "
                  "override and disable the preconditioner."
  []
  [no-condense_amg_test]
    type = 'CSVDiff'
    input = 'no_condense_test.i'
    csvdiff = 'no_condense_test_out.csv'
    requirement = "The system shall converge while using LU as the solver."
  []
[]
