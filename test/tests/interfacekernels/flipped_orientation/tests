[Tests]
  issues = '#33949'
  design = 'InterfaceKernels/index.md'
  [orientation]
    requirement = 'The system shall report an error if an interface kernel does not execute on its boundary/interface because'
    [flipped]
      type = RunException
      input = 'flipped.i'
      expect_err = "The variables appear to be flipped relative to the boundary orientation"
      detail = "its variable and neighbor variable are swapped relative to the boundary orientation, or"
    []
    [undefined]
      type = RunException
      input = 'flipped.i'
      cli_args = "InterfaceKernels/penalty/variable=u InterfaceKernels/penalty/neighbor_var=u"
      expect_err = "'neighbor_var' \(u\) on the secondary \(neighbor\) side of each face. Failing block pair\(s\) \(primary -> secondary\): 0 -> 1."
      detail = "its neighbor variable is not defined on the secondary side of the boundary, or"
    []
    [mismatched_pair]
      type = RunException
      input = 'multi_pair.i'
      expect_err = "Failing block pair\(s\) \(primary -> secondary\): 2 -> 3."
      detail = "its variable and neighbor variable are not defined across every block pair that the boundary joins."
    []
  []
  [orientation_check_disabled]
    type = RunApp
    input = 'flipped.i'
    cli_args = "Problem/interface_kernel_integrity_check=false"
    requirement = 'The system shall allow disabling the check that interface kernel variables match the orientation of their boundary.'
  []
[]
