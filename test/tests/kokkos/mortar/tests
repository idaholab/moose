[Tests]
  issues = '#33860'
  design = 'Constraints/index.md'

  [segment_integral]
    requirement = 'The Kokkos system shall evaluate variables on the device at the quadrature points of mortar segments on both sides of a nonconforming interface, including on primary elements owned by other processes, matching the evaluation through libMesh on the host,'
    [2d]
      type = CSVDiff
      input = 'segment_integral.i'
      csvdiff = 'segment_integral_out.csv'
      detail = 'for first order edges,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [2d_second_order]
      type = CSVDiff
      input = 'segment_integral.i'
      cli_args = 'Mesh/second_order=true Mesh/left/elem_type=QUAD9 Mesh/right/elem_type=QUAD8 AuxVariables/u/order=SECOND Outputs/file_base=segment_integral_second_order_out'
      csvdiff = 'segment_integral_second_order_out.csv'
      detail = 'for second order edges,'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [3d]
      type = CSVDiff
      input = 'segment_integral_3d.i'
      csvdiff = 'segment_integral_3d_out.csv'
      detail = 'for first order faces, and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [3d_second_order]
      type = CSVDiff
      input = 'segment_integral_3d.i'
      cli_args = 'Mesh/second_order=true Mesh/left/elem_type=HEX27 Mesh/right/elem_type=HEX20 AuxVariables/u/order=SECOND Outputs/file_base=segment_integral_3d_second_order_out'
      csvdiff = 'segment_integral_3d_second_order_out.csv'
      detail = 'for second order faces.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []
[]
