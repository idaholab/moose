[Tests]
  issues = '#33644'
  design = 'Multigrid.md'

  # A convergence-rate (MMS) test needs a spatially-varying source term and/or Dirichlet value,
  # which none of the framework's scalar Kokkos objects currently support (only constant values);
  # the vector-FE Kokkos kernels/BCs do (e.g. KokkosVectorBodyForce's function_x), so adding an
  # analogous scalar KokkosFunctionBodyForce/KokkosFunctionDirichletBC is the natural follow-up
  # that would unblock it. Until then, pmg/pmg_lu/pmg_ksp_view below exercise the multigrid
  # hierarchy on a fixed-source problem with no closed-form solution required.

  [pmg]
    type = CSVDiff
    input = mms.i
    csvdiff = 'mms_out.csv'
    requirement = 'The Kokkos p-multigrid preconditioner shall solve a 2D diffusion problem '
                  'discretized with LAGRANGE SECOND elements.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [pmg_lu]
    type = CSVDiff
    input = mms.i
    csvdiff = 'mms_out.csv'
    cli_args = '-pc_type lu'
    prereq = pmg
    requirement = 'The Kokkos p-multigrid preconditioner shall converge to the same solution as '
                  'a direct solve, proving the level hierarchy solves the intended system.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [pmg_ksp_view]
    type = RunApp
    input = mms.i
    cli_args = "Outputs/csv=false -ksp_view"
    expect_out = 'type: mg.*levels=2.*hypre.*boomeramg'
    requirement = 'The Kokkos p-multigrid preconditioner shall wire PETSc PCMG with the '
                  'requested number of levels and a hypre BoomerAMG coarse solve, guarding '
                  'against a silent fallback to a different preconditioner.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
[]
