[Tests]
  issues = '#33860'
  design = 'KokkosElementIntegralVariablePostprocessor.md KokkosSideIntegralVariablePostprocessor.md'

  [integrals]
    requirement = 'The Kokkos system shall integrate over the current configuration given by the mesh displacements, matching integration over the displaced mesh,'
    [cartesian]
      type = CSVDiff
      input = 'kokkos_current_configuration_integrals.i'
      csvdiff = 'kokkos_current_configuration_integrals_out.csv'
      detail = 'in Cartesian coordinates and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [rz]
      type = CSVDiff
      input = 'kokkos_current_configuration_integrals.i'
      cli_args = 'Mesh/coord_type=RZ Outputs/file_base=kokkos_current_configuration_integrals_rz_out'
      csvdiff = 'kokkos_current_configuration_integrals_rz_out.csv'
      detail = 'in axisymmetric coordinates.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []
  [jacobian]
    requirement = 'The Kokkos system shall assemble exact Jacobians, including the derivatives with respect to the displacements, of a diffusion term, a volumetric source, a position-dependent source, and a flux through the boundary normal posed on the current configuration'
    design = 'KokkosDiffusion.md KokkosBodyForce.md KokkosDirectionalNeumannBC.md'
    [cartesian]
      type = PetscJacobianTester
      input = 'kokkos_current_configuration_jacobian.i'
      detail = 'in Cartesian coordinates and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [rz]
      type = PetscJacobianTester
      input = 'kokkos_current_configuration_jacobian.i'
      cli_args = 'Mesh/coord_type=RZ'
      detail = 'in axisymmetric coordinates.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
  []
  [ad_jacobian]
    requirement = 'The Kokkos system shall assemble exact Jacobians by automatic differentiation, including the derivatives with respect to the displacements, of kernels and boundary conditions posed on the current configuration'
    design = 'KokkosADDiffusion.md KokkosADCoupledVarNeumannBC.md'
    [cartesian]
      type = PetscJacobianTester
      input = 'kokkos_current_configuration_ad_jacobian.i'
      detail = 'in Cartesian coordinates and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [rz]
      type = PetscJacobianTester
      input = 'kokkos_current_configuration_ad_jacobian.i'
      cli_args = 'Mesh/coord_type=RZ'
      detail = 'in axisymmetric coordinates.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
  []
  [vector_jacobian]
    requirement = 'The Kokkos system shall assemble exact Jacobians, including the derivatives with respect to the displacements, of vector kernels and boundary conditions posed on the current configuration, covering gradient, curl, coupled vector, and value terms'
    design = 'KokkosVectorDiffusion.md KokkosVectorNeumannBC.md'
    [two_dimensional]
      type = PetscJacobianTester
      input = 'kokkos_current_configuration_vector_jacobian.i'
      detail = 'in two dimensions and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [three_dimensional]
      type = PetscJacobianTester
      input = 'kokkos_current_configuration_vector_jacobian.i'
      cli_args = "Mesh/dim=3 Mesh/nz=2 Mesh/displacements='disp_x disp_y disp_z'"
      detail = 'in three dimensions.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
  []
[]
