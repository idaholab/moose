[Tests]
  issues = '#30655'
  design = 'KokkosMaterials/index.md'

  [constant_on]
    requirement = 'The Kokkos system shall support declaring, computing, and retrieving material properties that are constant on'
    [none]
      type = 'Exodiff'
      input = 'kokkos_constant_on_test.i'
      exodiff = 'kokkos_constant_on_test_out.e'
      detail = 'quadrature points;'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [element]
      type = 'Exodiff'
      input = 'kokkos_constant_on_test.i'
      exodiff = 'kokkos_constant_on_test_out.e'
      cli_args = 'Materials/mat/constant_on=ELEMENT'
      detail = 'elements;'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [subdomain]
      type = 'Exodiff'
      input = 'kokkos_constant_on_test.i'
      exodiff = 'kokkos_constant_on_test_out.e'
      cli_args = 'Materials/mat/constant_on=SUBDOMAIN'
      detail = 'subdomains;'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [mixed]
      type = 'Exodiff'
      input = 'kokkos_mixed_constant_on_test.i'
      exodiff = 'kokkos_constant_on_test_out.e'
      detail = 'quadrature points, elements, and subdomains at the same time on different subdomains.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []

  [per_property]
    issues = '#33855'
    requirement = 'The Kokkos system shall support a single material declaring one property constant '
                  'on subdomains alongside another varying per quadrature point, and shall'
    [granularity]
      type = 'CSVDiff'
      input = 'kokkos_per_property_constant_on.i'
      csvdiff = 'kokkos_per_property_constant_on_out.csv'
      detail = 'evaluate the subdomain-constant property before the finer one so that the finer one '
               'may be computed from it;'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [finer_than_material]
      type = 'RunException'
      input = 'kokkos_per_property_constant_on.i'
      cli_args = 'Materials/mat/constant_on=SUBDOMAIN Materials/mat/coarse_constant_on=NONE
                  Outputs/csv=false'
      expect_err = 'is finer than this material'
      detail = 'report an error when a property is declared finer than the granularity the material '
               'evaluates over;'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [unsupported_granularity]
      type = 'RunException'
      input = 'kokkos_per_property_constant_on.i'
      cli_args = 'Materials/mat/coarse_constant_on=ELEMENT Outputs/csv=false'
      expect_err = 'only SUBDOMAIN is supported as a coarser per-property granularity'
      detail = 'report an error for a coarser granularity it does not yet evaluate; and'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
    [missing_hook]
      type = 'RunException'
      input = 'kokkos_per_property_constant_on.i'
      cli_args = 'Materials/mat/type=KokkosMissingGranularityHookTest Outputs/csv=false'
      expect_err = 'does not define computeSubdomainProperties'
      detail = 'report an error when the material declares such a property but defines no hook to '
               'fill it.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
    []
  []
[]
