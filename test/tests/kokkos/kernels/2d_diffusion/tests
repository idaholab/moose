[Tests]
  issues = '#30655 #33644'

  [testdirichlet]
    type = Exodiff
    input = 'kokkos_2d_diffusion_test.i'
    exodiff = 'kokkos_2d_diffusion_test_out.e'
    requirement = 'The Kokkos system shall provide an ability to solve a 2D diffusion problem with Dirichlet boundary conditions.'
    design = 'KokkosDiffusion.md KokkosDirichletBC.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [testneumann]
    type = Exodiff
    input = 'kokkos_2d_diffusion_neumannbc_test.i'
    exodiff = 'kokkos_2d_diffusion_neumannbc_test_out.e'
    requirement = 'The Kokkos system shall provide an ability to solve a 2D diffusion problem with Neumann boundary conditions.'
    design = 'KokkosDiffusion.md KokkosNeumannBC.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [testbodyforce]
    type = Exodiff
    input = 'kokkos_2d_diffusion_bodyforce_test.i'
    exodiff = 'kokkos_2d_diffusion_bodyforce_test_out.e'
    requirement = 'The Kokkos system shall provide an ability to solve a 2D diffusion problem including a volumetric source term.'
    design = 'KokkosDiffusion.md KokkosBodyForce.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [test_jacobian]
    type = PetscJacobianTester
    input = 'kokkos_2d_diffusion_test.i'
    cli_args = 'Outputs/exodus=false'
    recover = false
    requirement = 'The Kokkos system shall provide a tester that checks hand-coded Jacobian against finite difference Jacobian using -snes_type=test option.'
    design = 'framework_stp.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [test_matrix_free_jacobian]
    type = Exodiff
    input = 'kokkos_2d_diffusion_test.i'
    exodiff = 'kokkos_2d_diffusion_test_out.e'
    cli_args = 'Executioner/use_kokkos_matrix_free_jacobian=true'
    prereq = testdirichlet
    requirement = 'The Kokkos system shall reproduce the same solution when the Newton-Krylov '
                  'linear solve uses an analytic partial-assembly Jacobian-vector product '
                  'instead of the fully assembled Jacobian for the matrix-vector product.'
    design = 'KokkosDiffusion.md KokkosDirichletBC.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [test_matrix_free_jacobian_fd]
    type = PetscJacobianTester
    input = 'kokkos_2d_diffusion_test.i'
    cli_args = 'Outputs/exodus=false Executioner/use_kokkos_matrix_free_jacobian=true'
    recover = false
    requirement = 'The Kokkos system shall compute the partial-assembly Jacobian-vector product to '
                  'the same accuracy as a finite difference Jacobian, verifying the '
                  'quadrature-point linearization that product is contracted from.'
    design = 'KokkosDiffusion.md framework_stp.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [test_force_iteration]
    type = Exodiff
    input = 'kokkos_2d_diffusion_test.i'
    exodiff = 'kokkos_2d_diffusion_test_out.e'
    cli_args = 'Executioner/nl_abs_tol=1e+1 Executioner/petsc_options_iname=-snes_force_iteration Executioner/petsc_options_value=1'
    prereq = testdirichlet
    requirement = 'The Kokkos system shall force the solver to take at least one iteration regardless of the initial residual norm when the snes_force_iteration option is specified.'
    design = 'Transient.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [actual_linear_solver]
    type = RunApp
    input = 'kokkos_2d_diffusion_test.i'
    cli_args = 'Executioner/solve_type=linear Outputs/exodus=false'
    absent_out = 'Nonlinear \|R\|'
    requirement = 'The Kokkos system shall not compute an extra residual if the linear solver is used.'
    design = 'FEProblem.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [matrix_free_fdp_error]
    type = RunException
    input = 'kokkos_2d_diffusion_test.i'
    cli_args = 'Outputs/exodus=false Executioner/use_kokkos_matrix_free_jacobian=true '
               'Preconditioning/fdp/type=FDP'
    expect_err = 'Finite difference preconditioning fills the entries of an assembled system matrix'
    recover = false
    requirement = 'The Kokkos system shall report an error when finite difference preconditioning '
                  'is requested for a system whose Jacobian is computed as an operator action.'
    design = 'FiniteDifferencePreconditioner.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [matrix_free_integrated_bc_error]
    type = RunException
    input = 'kokkos_2d_diffusion_test.i'
    cli_args = 'Outputs/exodus=false Executioner/use_kokkos_matrix_free_jacobian=true '
               'BCs/vacuum/type=KokkosVacuumBC BCs/vacuum/variable=u BCs/vacuum/boundary=top'
    expect_err = 'does not support the integrated boundary condition .vacuum. of type .KokkosVacuumBC.'
    recover = false
    requirement = 'The Kokkos system shall report an error when a matrix-free Jacobian-vector '
                  'product is requested with an integrated boundary condition that carries a '
                  'Jacobian contribution, which the operator action does not evaluate.'
    design = 'KokkosVacuumBC.md'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
[]
