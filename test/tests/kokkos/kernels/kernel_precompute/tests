[Tests]
  issues = '#30655'
  design = 'KokkosKernels/index.md'

  [test]
    type = 'Exodiff'
    input = 'kokkos_kernel_precompute_test.i'
    exodiff = 'kokkos_kernel_precompute_test_out.e'
    requirement = 'The Kokkos system shall provide optimized kernels for residuals with the test function or its gradient factored out.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []

  [matrix_free_missing_tensor_error]
    type = RunException
    input = 'kokkos_kernel_precompute_test.i'
    cli_args = 'Outputs/exodus=false Executioner/solve_type=NEWTON '
               'Executioner/use_kokkos_matrix_free_jacobian=true'
    expect_err = 'does not support kernel .conv. of type .KokkosConvectionPrecompute.'
    recover = false
    issues = '#33644'
    requirement = 'The Kokkos system shall report an error when a matrix-free Jacobian-vector '
                  'product is requested for a kernel that supplies neither a quadrature-point '
                  'linearization nor an operator-action loop of its own.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
[]
