[Tests]
  issues = '#30655'
  design = 'KokkosCoupledTimeDerivative.md'

  [test]
    type = 'Exodiff'
    input = 'kokkos_coupled_time_derivative_test.i'
    exodiff = 'kokkos_coupled_time_derivative_test_out.e'
    requirement = 'The system shall provide a coupled time derivative Kokkos kernel.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
  [jac_test]
    type = 'PetscJacobianTester'
    input = 'kokkos_coupled_time_derivative_test.i'
    cli_args = 'Outputs/exodus=false'
    run_sim = True
    ratio_tol = 1e-7
    difference_tol = 1e-6
    requirement = 'The system shall compute a perfect Jacobian for the coupled time derivative Kokkos kernel.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
[]
