[Tests]
  design = 'syntax/KokkosKernels/index.md syntax/KokkosBCs/index.md'
  issues = '#33709'
  [test]
    type = Exodiff
    input = 'kokkos_scalar_constraint.i'
    exodiff = 'kokkos_scalar_constraint_out.e'
    requirement = 'The system shall, using Kokkos, support the ability to compute the scalar variable contribution to weak forms in residual objects.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
  [test_jacobian]
    type = PetscJacobianTester
    input = 'kokkos_scalar_constraint.i'
    run_sim = True
    requirement = 'The system shall produce, with Kokkos residual objects, the correct Jacobian including the scalar variable contribution.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
  []
[]
