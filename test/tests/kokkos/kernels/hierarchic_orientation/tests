[Tests]
  issues = '#33644'
  design = 'KokkosDiffusion.md'

  [orientation]
    requirement = 'The Kokkos reference shape tables shall account for the orientation of the '
                  'edges and faces of an element, so that a hierarchic basis of order three on a '
                  'triangular mesh converges through'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'

    [assembled]
      type = CSVDiff
      input = 'hierarchic.i'
      csvdiff = 'hierarchic_orientation.csv'

      detail = 'the assembled framework kernels, and'
    []

    [kokkos]
      type = CSVDiff
      input = 'kokkos_hierarchic.i'
      csvdiff = 'hierarchic_orientation_kokkos.csv'
      prereq = 'orientation/assembled'

      detail = 'the Kokkos matrix-free kernels, each against its own converged error, since the '
               'Kokkos path additionally pins the HIERARCHIC edge modes the assembled path does '
               'not yet.'
    []
  []
[]
