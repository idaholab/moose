[Tests]
  design = 'BDF2.md'
  issues = '#1953'

  [group]
    requirement = "The system shall support the second-order backward difference method for time integration"
    [./test]
      type = 'Exodiff'
      input = 'bdf2.i'
      exodiff = 'bdf2_out.e'

      detail = "with and"
    [../]

    [./adapt]
      type = 'Exodiff'
      input = 'bdf2_adapt.i'
      exodiff = 'bdf2_adapt_out.e-s005'
      group = 'adaptive'

      detail = "without mesh adaptivity."
    [../]
  []

  [fv]
    requirement = 'The system shall be able to show second order temporal accuracy using the BDF2 time integration scheme with a finite volume'
    [nonlinear]
      detail = 'nonlinear implementation, and'
      type = MMSTest
      input = test.py
      test_case = TestNonlinearFV
    []
    [linear]
      detail = 'linear implementation.'
      type = MMSTest
      input = test.py
      test_case = TestLinearFV
    []
  []

  [linear_fv_varying_factor]
    type = MMSTest
    input = test.py
    test_case = TestLinearFVVaryingFactor
    design = 'LinearFVTimeDerivative.md'
    requirement = 'The system shall be able to show second order temporal accuracy for a linear finite volume time derivative with a multiplier that varies in time, which requires each multiplier to be paired with the solution state it multiplies.'
    max_threads = 1 # MMSTest drives its own runs through mms.run_temporal
  []
[]
