[Tests]
  design = 'syntax/Problem/index.md'
  issues = '#29632'
  [MFEMComplex2DQuad]
    type = XMLDiff
    input = complex.i
    xmldiff = 'OutputData/Complex2DQuad/Run0/Run0.pvd
                OutputData/Complex2DQuad/Run0/Cycle000001/proc000000.vtu'
    requirement = 'The system shall have the ability to solve a complex-valued problem using MFEM on a 2D mesh with quadrilateral elements. This test is equivalent to MFEM Example 22.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    max_parallel = 1
    recover = false
  []
  [MFEMComplex2DTri]
    type = XMLDiff
    input = complex.i
    xmldiff = 'OutputData/Complex2DTri/Run0/Run0.pvd
                OutputData/Complex2DTri/Run0/Cycle000001/proc000000.vtu'
    cli_args = 'Mesh/file=../mesh/star.mesh '
               'Mesh/serial_refine=1 '
               'FESpaces/H1FESpace/fec_order=SECOND '
               'BCs/dbc/coefficient_real=1 '
               'BCs/dbc/coefficient_imag=0 '
               'Outputs/ParaViewDataCollection/file_base="OutputData/Complex2DTri" '
               'sigma=10'
    requirement = 'The system shall have the ability to solve a complex-valued problem using MFEM on a 2D mesh with triangular elements.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    max_parallel = 1
    recover = false
  []
  [MFEMComplexWaveguide]
    type = CSVDiff
    input = complex_waveguide.i
    csvdiff = 'OutputData/ComplexWaveguide.csv'
    requirement = 'The system shall have the ability to solve a complex-valued problem using MFEM with vector Robin boundary conditions applied.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    min_slots = 2 # memory heavy
  []
  [MFEMComplexVariableRequiresComplexNumericType]
    type = RunException
    input = complex.i
    cli_args = 'Problem/numeric_type=real'
    expect_err = "The problem numeric type does not match primary MFEM variable 'u', which is complex."
    requirement = 'The system shall reject a complex-valued primary MFEM variable when the problem uses a real-valued equation system.'
    capabilities = 'mfem'
    compute_devices = 'cpu'
    recover = false
  []
  [MFEMRealVariableRequiresRealNumericType]
    type = RunException
    input = complex.i
    cli_args = 'Variables/u/type=MFEMVariable'
    expect_err = "The problem numeric type does not match primary MFEM variable 'u', which is real."
    requirement = 'The system shall reject a real-valued primary MFEM variable when the problem uses a complex-valued equation system.'
    capabilities = 'mfem'
    compute_devices = 'cpu'
    recover = false
  []
  [MFEMPML]
    type = CSVDiff
    input = pml.i
    csvdiff = 'OutputData/PML.csv'
    design = 'MFEMPerfectlyMatchedLayerFunction.md'
    issues = '#33450'
    requirement = 'The system shall have the ability to absorb an outgoing wave using a perfectly matched layer whose coordinate stretch is directed along the gradient of a harmonic coordinate solved for inside the layer.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMMixedSesquilinear]
    type = CSVDiff
    input = mixed_sesquilinear.i
    csvdiff = 'OutputData/MixedSesquilinear.csv'
    requirement = 'The system shall have the ability to solve a complex-valued problem using MFEM with mixed sesquilinear form kernels.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMMixedSesquilinearIC]
    type = CSVDiff
    input = mixed_sesquilinear_ic.i
    csvdiff = 'OutputData/MixedSesquilinearIC.csv'
    requirement = 'The system shall have the ability to solve a complex-valued problem using MFEM with mixed sesquilinear form kernels and complex initial conditions on an eliminated variable.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMMixedSesquilinearRealImag]
    type = CSVDiff
    input = mixed_sesquilinear_real_imag.i
    csvdiff = 'OutputData/MixedSesquilinearRealImag.csv'
    requirement = 'The system shall have the ability to solve a complex-valued problem using MFEM with a mixed sesquilinear form kernel carrying both real and imaginary integrators on a trial variable with essential degrees of freedom.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMPML3D]
    type = CSVDiff
    input = pml_3d.i
    csvdiff = 'OutputData/PML3D.csv'
    design = 'MFEMPerfectlyMatchedLayerFunction.md'
    issues = '#33450'
    requirement = 'The system shall have the ability to absorb an outgoing wave using a harmonic coordinate perfectly matched layer on a three dimensional mesh, where the stretch tensor is a full matrix.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
[]
