[Tests]
  design = 'MFEMProblemComposer.md'
  issues = '#33021'
  [WeakFormProblemComposer]
    type = CSVDiff
    input = explicit_composer_darcy.i
    csvdiff = 'OutputData/Darcy.csv'
    requirement = 'The system shall allow the user to explicitly build an MFEMWeakFormProblemComposer '
                  'while still getting the same results for, e.g., a Darcy problem.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [TimeDependentWeakFormProblemComposer]
    type = XMLDiff
    input = explicit_composer_heat_transfer.i
    xmldiff = 'OutputData/HeatTransfer/Run0/Run0.pvd
                OutputData/HeatTransfer/Run0/Cycle000003/proc000000.vtu'
    requirement = 'The system shall allow the user to explicitly build an MFEMTimeDependentWeakFormProblemComposer '
                  'while still getting the same results for, e.g., a heat transfer problem.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    max_parallel = 1 # schemadiff with multiple ranks
    recover = false
    restep = false
  []
  [MFEMSteadyCustomComposer]
    type = XMLDiff
    input = prob_op_custom_operator.i
    xmldiff = 'OutputData/prob_op_custom_operator/Run0/Run0.pvd '
              'OutputData/prob_op_custom_operator/Run0/Cycle000000/proc000000.vtu '
              'OutputData/prob_op_custom_operator/Run0/Cycle000001/proc000000.vtu'
    requirement = 'The system shall have the ability to use a custom operator based on ex0p'
    capabilities = 'mfem'
    compute_devices = 'cpu'
    max_parallel = 1 # schemadiff with multiple ranks
    recover = false
    restep = false
  []
[]
