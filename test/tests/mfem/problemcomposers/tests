[Tests]
  design = 'MFEMProblemComposer.md'
  issues = '#33021'
  [WeakFormProblemComposer]
    type = CSVDiff
    input = explicit_composer_darcy.i
    csvdiff = 'OutputData/Darcy.csv'
    requirement = 'The system shall allow the user to explicitly build an MFEMWeakFormProblemComposer '
                  'while still getting the same results for, e.g., a Darcy problem.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [TimeDependentWeakFormProblemComposer]
    type = CSVDiff
    input = explicit_composer_heat_transfer.i
    csvdiff = 'OutputData/HeatTransfer/heattransfer_line_sample_0001.csv '
              'OutputData/HeatTransfer/heattransfer_line_sample_0002.csv '
              'OutputData/HeatTransfer/heattransfer_line_sample_0003.csv'
    requirement = 'The system shall allow the user to explicitly build an MFEMTimeDependentWeakFormProblemComposer '
                  'while still getting the same results for, e.g., a heat transfer problem.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    restep = false
  []
  [CustomProblemComposer]
    type = CSVDiff
    input = custom_composer_and_operator.i
    csvdiff = 'OutputData/custom_composer_and_operator/l2norm.csv'
    requirement = 'The system shall have the ability to use a custom operator based on MFEM ex0p'
    capabilities = 'mfem'
    compute_devices = 'cpu'
    max_parallel = 1 # schemadiff with multiple ranks
    recover = false
    restep = false
  []
  [MFEMTwoProblemComposers]
    type = CSVDiff
    input = two_problem_composers.i
    csvdiff = 'OutputData/TwoProblemComposers.csv'
    requirement = 'The system shall be able to solve two independent equation systems sequentially in a single problem, each built by its own weak form and executed by its own problem composer.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    # MFEM problems do not currently support recovery.
    recover = false
  []
[]
