[Tests]
  design = 'syntax/Problem/index.md'
  issues = '#29632'
  [MFEMCurlCurl]
    type = CSVDiff
    input = curlcurl.i
    csvdiff = 'OutputData/CurlCurl/curlcurl_line_sample_db_dt_field_0001.csv '
              'OutputData/CurlCurl/curlcurl_line_sample_e_field_0001.csv'
    requirement = 'The system shall have the ability to solve a definite Maxwell problem with Nedelec elements of the first kind using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    max_parallel = 1 # schemadiff with multiple ranks
    recover = false
  []
  [MFEMCurlCurlPartial]
    type = CSVDiff
    input = curlcurl.i
    csvdiff = 'OutputData/CurlCurl/curlcurl_line_sample_db_dt_field_0001.csv '
              'OutputData/CurlCurl/curlcurl_line_sample_e_field_0001.csv'
    cli_args = 'Solvers/active="cg matrix_free_ams" Executioner/assembly_level=partial'
    requirement = 'The system shall have the ability to solve a partially assembled definite Maxwell problem with Nedelec elements of the first kind using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    abs_zero = 1e-6
  []
  [MFEMDiffusion]
    type = CSVDiff
    input = diffusion.i
    csvdiff = 'OutputData/Diffusion/diffusion_line_sample_0001.csv'
    requirement = 'The system shall have the ability to solve a diffusion problem using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    expect_out = 'Parallel Type:.*distributed.*Mesh Dimension.*3.*Spatial Dimension.*3.*Elems.*2476.*Num Subdomains.*1.*Solver.*MFEMHypreGMRES'
    abs_zero = 1e-6
  []
  [MFEMDiffusion1D]
    type = CSVDiff
    input = diffusion.i
    csvdiff = 'OutputData/Diffusion1D.csv'
    cli_args = 'Mesh/file=../mesh/ref-segment.mesh '
               'Mesh/uniform_refine=5 '
               'BCs/bottom/boundary=1 '
               'BCs/top/boundary=2 '
               'VectorPostprocessors/active="" '
               'Outputs/active=csv Outputs/csv=true '
               'Outputs/file_base=OutputData/Diffusion1D'
    requirement = 'The system shall have the ability to solve a 1D diffusion problem using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    expect_out = 'Parallel Type:.*distributed.*Mesh Dimension.*1.*Spatial Dimension.*1.*Elems.*32.*Num Subdomains.*1.*Solver.*MFEMHypreGMRES'
  []
  [MFEMDiffusionAMR]
    design = 'MFEMRefinementMarker.md MFEMIndicator.md MFEML2ZienkiewiczZhuIndicator.md'
    issues = '#30943'
    requirement = 'The system shall have the ability to solve a diffusion problem using MFEM with AMR using both '
    [hRefinement]
      type = CSVDiff
      input = diffusion_amr.i
      csvdiff = 'OutputData/DiffusionHRefinement.csv'
      capabilities = 'mfem'
      compute_devices = 'cpu cuda'
      recover = false
      detail = 'h-refinement, '
    []
    [pRefinement]
      type = CSVDiff
      input = diffusion_amr.i
      csvdiff = 'OutputData/DiffusionPRefinement.csv'
      cli_args = 'Adaptivity/Markers/ref/max_h_level=0 Adaptivity/Markers/ref/max_p_level=1 '
                 'Outputs/file_base=OutputData/DiffusionPRefinement'
      capabilities = 'mfem'
      compute_devices = 'cpu cuda'
      recover = false
      detail = 'and p-refinement.'
    []
  []
  [MFEMDiffusionPartial]
    type = CSVDiff
    input = diffusion.i
    csvdiff = 'OutputData/Diffusion/diffusion_partial_line_sample_0001.csv'
    cli_args = 'Solvers/inactive="boomeramg" '
               'Solvers/main/type=MFEMCGSolver Solvers/main/preconditioner=jacobi '
               'Executioner/assembly_level=partial '
               'Outputs/CSV/file_base=OutputData/Diffusion/diffusion_partial'
    requirement = 'The system shall have the ability to solve a diffusion problem with partial assembly using MFEM.'
    abs_zero = 8e-10
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMDiffusionMatFree]
    type = CSVDiff
    input = diffusion.i
    csvdiff = 'OutputData/Diffusion/diffusion_mat_free_line_sample_0001.csv'
    cli_args = 'Solvers/inactive="boomeramg" '
               'Solvers/main/type=MFEMCGSolver Solvers/main/preconditioner=jacobi '
               'Executioner/device=ceed-cpu '
               'Executioner/assembly_level=none '
               'Outputs/CSV/file_base=OutputData/Diffusion/diffusion_mat_free'
    compute_devices = 'ceed-cpu'
    requirement = 'The system shall have the ability to solve a diffusion problem with matrix-free assembly using MFEM.'
    capabilities = 'mfem'
    recover = false
    abs_zero = 2e-10
  []
  [MFEMDiffusionPartialMultiGPUAwareMPI]
    type = CSVDiff
    input = diffusion.i
    csvdiff = 'OutputData/DiffusionPartialMPI.csv'
    cli_args = 'Solvers/main/type=MFEMCGSolver Solvers/main/preconditioner=jacobi Solvers/inactive="boomeramg" '
               'Executioner/assembly_level=partial '
               'Executioner/gpu_aware_mpi=true '
               'Outputs/active=csv Outputs/csv=true '
               'Outputs/file_base=OutputData/DiffusionPartialMPI'
    expect_out = 'Use GPU-aware MPI:    yes'
    requirement = 'The system shall be able to solve a diffusion problem with partial assembly across '
                  'multiple GPUs with GPU-aware MPI enabled.'
    capabilities = 'mfem'
    compute_devices = 'cuda'
    min_parallel = 2
    recover = false
  []
  [MFEMDiffusionPartialMultiGPUNoAwareMPI]
    type = CSVDiff
    input = diffusion.i
    csvdiff = 'OutputData/DiffusionPartialMPI.csv'
    cli_args = 'Solvers/main/type=MFEMCGSolver Solvers/main/preconditioner=jacobi Solvers/inactive="boomeramg" '
               'Executioner/assembly_level=partial '
               'Executioner/gpu_aware_mpi=false '
               'Outputs/active=csv Outputs/csv=true '
               'Outputs/file_base=OutputData/DiffusionPartialMPI'
    expect_out = 'Use GPU-aware MPI:    no'
    requirement = 'The system shall be able to solve a diffusion problem with partial assembly across '
                  'multiple GPUs with GPU-aware MPI disabled.'
    capabilities = 'mfem'
    compute_devices = 'cuda'
    min_parallel = 2
    recover = false
  []
  [MFEMGradDiv]
    type = CSVDiff
    input = graddiv.i
    csvdiff = 'OutputData/GradDiv/graddiv_F_line_sample_0001.csv '
              'OutputData/GradDiv/graddiv_divF_line_sample_0001.csv'
    requirement = 'The system shall have the ability to solve a grad-div problem with Raviart-Thomas elements using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    errors = 'foobarbaz' # allow cuda errors I guess?
  []
  [MFEMHeatConduction]
    type = CSVDiff
    input = heattransfer.i
    csvdiff = 'OutputData/HeatConduction/heatconduction_line_sample_0001.csv '
              'OutputData/HeatConduction/heatconduction_line_sample_0002.csv '
              'OutputData/HeatConduction/heatconduction_line_sample_0003.csv '
              'OutputData/HeatConduction/heatconduction_line_sample_0004.csv'
    cli_args = 'BCs/active="bottom top_dirichlet" '
               'Executioner/dt=0.25 Executioner/end_time=1.0 '
               'Outputs/CSV/file_base=OutputData/HeatConduction/heatconduction'
    requirement = 'The system shall have the ability to solve a transient heat conduction problem using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    restep = false
  []
  [MFEMHeatConductionElement]
    type = CSVDiff
    input = heattransfer.i
    csvdiff = 'OutputData/HeatConductionElement/heatconductionelement_line_sample_0001.csv '
              'OutputData/HeatConductionElement/heatconductionelement_line_sample_0002.csv '
              'OutputData/HeatConductionElement/heatconductionelement_line_sample_0003.csv '
              'OutputData/HeatConductionElement/heatconductionelement_line_sample_0004.csv'
    cli_args = 'BCs/active="bottom top_dirichlet" '
               'Executioner/dt=0.25 Executioner/end_time=1.0 '
               'Solvers/inactive="boomeramg" '
               'Outputs/CSV/file_base=OutputData/HeatConductionElement/heatconductionelement '
               'Solvers/main/type=MFEMCGSolver Solvers/main/preconditioner=jacobi '
               'Executioner/assembly_level=element'
    requirement = 'The system shall have the ability to solve a transient heat conduction problem with element assembly using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    valgrind = none
    recover = false
    restep = false
  []
  [MFEMHeatConductionMatFree]
    type = CSVDiff
    input = heattransfer.i
    csvdiff = 'OutputData/HeatConductionMatFree/heat_conduction_mat_free_line_sample_0001.csv '
              'OutputData/HeatConductionMatFree/heat_conduction_mat_free_line_sample_0002.csv '
              'OutputData/HeatConductionMatFree/heat_conduction_mat_free_line_sample_0003.csv '
              'OutputData/HeatConductionMatFree/heat_conduction_mat_free_line_sample_0004.csv'
    cli_args = 'BCs/active="bottom top_dirichlet" '
               'Executioner/dt=0.25 Executioner/end_time=1.0 '
               'Solvers/main/type=MFEMCGSolver Solvers/main/preconditioner=jacobi '
               'Solvers/inactive="boomeramg" '
               'Outputs/CSV/file_base=OutputData/HeatConductionMatFree/heat_conduction_mat_free '
               'Executioner/assembly_level=none '
               'Executioner/device=ceed-cpu'
    compute_devices = 'ceed-cpu'
    requirement = 'The system shall have the ability to solve a transient heat conduction problem with matrix-free assembly using MFEM.'
    capabilities = 'mfem'
    valgrind = none
    recover = false
    restep = false
  []
  [MFEMHeatTransfer]
    type = CSVDiff
    input = heattransfer.i
    csvdiff = 'OutputData/HeatTransfer/heattransfer_line_sample_0001.csv '
              'OutputData/HeatTransfer/heattransfer_line_sample_0002.csv '
              'OutputData/HeatTransfer/heattransfer_line_sample_0003.csv'
    requirement = 'The system shall have the ability to solve a transient heat conduction problem with a heat transfer coefficient on one boundary using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    restep = false
  []
  [MFEMTransientScheme]
    type = RunException
    input = heattransfer.i
    cli_args = 'Executioner/scheme=bdf2'
    expect_err = 'Time Integration scheme "BDF2" is not supported by MFEMTransient Executioner.'
    requirement = 'The system shall report an error if the user specifies an unsupported time integration scheme.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
  []
  [MFEMMixedHeatTransfer]
    type = CSVDiff
    input = mixed_heattransfer.i
    csvdiff = 'OutputData/MixedHeatTransfer/mht_temperature_line_sample_0001.csv '
              'OutputData/MixedHeatTransfer/mht_temperature_line_sample_0002.csv '
              'OutputData/MixedHeatTransfer/mht_temperature_line_sample_0003.csv '
              'OutputData/MixedHeatTransfer/mht_time_integrated_heat_flux_line_sample_0001.csv '
              'OutputData/MixedHeatTransfer/mht_time_integrated_heat_flux_line_sample_0002.csv '
              'OutputData/MixedHeatTransfer/mht_time_integrated_heat_flux_line_sample_0003.csv'
    requirement = 'The system shall have the ability to solve a transient heat conduction problem solved using the mixed form of the heat equation using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
    restep = false
  []
  [MFEMLinearElasticity]
    type = XMLDiff
    input = linearelasticity.i
    xmldiff = 'OutputData/LinearElasticity/Run0/Run0.pvd
                OutputData/LinearElasticity/Run0/Cycle000001/proc000000.vtu'
    requirement = 'The system shall have the ability to solve a linear elasticity problem using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    max_parallel = 1 # schemadiff with multiple ranks
    recover = false
  []
  [MFEMGravity]
    type = XMLDiff
    input = gravity.i
    xmldiff = 'OutputData/Gravity/Run0/Run0.pvd
                OutputData/Gravity/Run0/Cycle000001/proc000000.vtu'
    requirement = 'The system shall have the ability to solve a linear elasticity problem for a beam deformed under gravitational loads using MFEM.'
    capabilities = 'mfem & platform=linux'
    compute_devices = 'cpu' # schemadiff with cuda
    max_parallel = 1 # schemadiff with multiple ranks
    recover = false
  []
  [MFEMGravityQuadratureFunction]
    type = CSVDiff
    input = gravity_qf.i
    csvdiff = 'OutputData/GravityQF.csv'
    design = 'MFEMVectorQuadratureFunction.md'
    requirement = 'The system shall have the ability to precompute a vector coefficient at quadrature points and reuse the stored values in place of the original coefficient.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMIrrotational]
    type = CSVDiff
    input = irrotational.i
    csvdiff = 'OutputData/Irrotational.csv'
    requirement = 'The system shall have the ability to solve for an irrotational vortex in two dimensions using MFEM.'
    abs_zero = 2e-7
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMDarcy]
    type = CSVDiff
    input = darcy.i
    csvdiff = 'OutputData/Darcy.csv'
    requirement = 'The system shall have the ability to solve a mixed Darcy problem in two dimensions using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMDiffusionEigenproblem]
    type = CSVDiff
    input = diffusion_eigenproblem.i
    csvdiff = 'OutputData/DiffusionEigenproblem_eigenvalues_0001.csv'
    requirement = 'The system shall have the ability to solve a scalar eigenproblem with Dirichlet BCs using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
  [MFEMMaxwellEigenproblem]
    type = CSVDiff
    input = maxwell_eigenproblem.i
    csvdiff = 'OutputData/MaxwellEigenproblem_eigenvalues_0001.csv'
    requirement = 'The system shall have the ability to solve a vector-valued eigenproblem with Dirichlet BCs using MFEM.'
    capabilities = 'mfem'
    compute_devices = 'cpu cuda'
    recover = false
  []
[]
