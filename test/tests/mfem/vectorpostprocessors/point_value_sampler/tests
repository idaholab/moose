    recover = false
    compute_devices = 'cpu cuda'
    # we will get a warning for being near the boundary
    allow_warnings = 'true'
  []
  [MFEMPointVariableValueSamplerAvgTypeHarmonic]
    type = CSVDiff
    input = point_value_sampler_boundary_warn.i
    csvdiff = 'OutputData/point_value_sampler_avgtype_harmonic_point_sample_0001.csv'
    cli_args = 'VectorPostprocessors/point_sample/side_interpolation_type=HARMONIC '
               'Outputs/csv=true '
               'Outputs/file_base=OutputData/point_value_sampler_avgtype_harmonic'
    requirement = 'The system has the ability to use harmonic average near non-continuous boundaries'
    capabilities = 'mfem'
    recover = false
    compute_devices = 'cpu cuda'
    # we will get a warning for being near the boundary
    allow_warnings = 'true'
  []
  [MFEMPointVariableValueSamplerSubMesh]
    type = CSVDiff
    input = point_variable_value_sampler_submesh.i
    csvdiff = 'point_variable_value_sampler_submesh_out_submesh_sample_0001.csv'
    issues = '#33439'
    requirement = 'The system shall sample the prescribed value of an MFEM variable using the '
                  'mesh belonging to its submesh finite element space.'
    capabilities = 'mfem'
    recover = false
  []
