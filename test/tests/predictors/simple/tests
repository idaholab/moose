[Tests]
  design = 'SimplePredictor.md'
  issues = '#2282 #6506 #16796'

  [test]
    type = 'CSVDiff'
    input = 'predictor_test.i'
    csvdiff = 'predictor_test_out.csv'

    requirement = "The system shall include a means for predicting future solution based on previous "
                  "solutions."
  []
  [output]
    type = 'RunApp'
    input = 'predictor_reference_residual_test.i'
    expect_out = 'Applying predictor with scale factor = 1e-10'

    requirement = "The system shall include a means for predicting future solution based on previous "
                  "solutions and print the scale factor to the output stream."
  []

  [skip]
    requirement = "The system shall support the ability to skip performing solution predictions"
    [test_skip]
      type = 'CSVDiff'
      input = 'predictor_skip_test.i'
      csvdiff = 'predictor_skip_test_out.csv'

      detail = "using solution times or"
    []
    [test_skip_old]
      type = 'CSVDiff'
      input = 'predictor_skip_old_test.i'
      csvdiff = 'predictor_skip_old_test_out.csv'

      detail = "previous solution times."
    []
  []

  [skip_after_failed_timestep]
    requirement = "The system shall support the ability to skip a prediction after a failed time "
                  "step"
    input = 'predictor_test_skip_after_failed_tstep.i'
    type = 'CSVDiff'
    csvdiff = 'predictor_test_skip_after_failed_tstep_out.csv'
    restep = false # Testing feature where behavior changes on failed timestep
  []

  [pre_smo]
    requirement = "The system shall support the ability to output pre-SMO residual"
    input = 'predictor_test_pre_smo.i'
    type = 'CSVDiff'
    csvdiff = 'predictor_test_pre_smo_out.csv'
  []

  [damping]
    requirement = "The system shall limit the change of the initial guess made by a predictor with "
                  "the dampers that are set to apply to the predictor, by"
    design = 'SimplePredictor.md syntax/Dampers/index.md'
    issues = '#34453'
    [damped]
      type = 'CSVDiff'
      input = 'predictor_damped_test.i'
      csvdiff = 'predictor_damped_out.csv'
      expect_out = 'Predictor damping factor'
      absent_out = ' Damping factor:'
      detail = "scaling the change by their damping factor, without damping the nonlinear updates,"
    []
    [trial_value]
      type = 'RunApp'
      input = 'predictor_test.i'
      cli_args = 'Dampers/bound/type=BoundingValueNodalDamper Dampers/bound/variable=u '
                 'Dampers/bound/max_value=0.8 Dampers/bound/apply_to=predictor'
      expect_out = 'Predictor damping factor: 0\.6\n'
      detail = "evaluating the dampers at the predicted solution,"
    []
    [both]
      type = 'RunApp'
      input = 'predictor_damped_test.i'
      cli_args = 'Dampers/cap/apply_to="nonlinear predictor"'
      expect_out = 'Predictor damping factor.* Damping factor:'
      detail = "also damping the nonlinear updates with dampers set to apply to both,"
    []
    [skip]
      type = 'CSVDiff'
      input = 'predictor_damped_test.i'
      cli_args = 'Dampers/cap/min_damping=0.5 Outputs/file_base=predictor_damping_skip_out'
      csvdiff = 'predictor_damping_skip_out.csv'
      detail = "skipping the prediction when a damper fails, or"
    []
    [cut_timestep]
      type = 'RunApp'
      input = 'predictor_damped_test.i'
      cli_args = 'Dampers/cap/min_damping=0.5 Executioner/Predictor/damping_failure=cut_timestep'
      expect_out = 'Cutting the time step.*Time Step 2, time = 0\.75'
      detail = "cutting the time step when a damper fails and the predictor is set to do so."
    []
  []
  [damping_no_stage]
    type = 'RunException'
    input = 'predictor_damped_test.i'
    cli_args = 'Dampers/cap/apply_to=""'
    expect_err = 'At least one solution update must be selected'
    requirement = "The system shall report an error when a damper is set to limit no solution "
                  "update."
    design = 'syntax/Dampers/index.md'
    issues = '#34453'
  []

  [timestep_tolerance]
    requirement = "The system shall support the ability to use the Execitioner timestep tolerance to "
                  "determine if a prediction should be peformed."
    type = 'CSVDiff'
    input = 'predictor_skip_test.i'
    csvdiff = 'predictor_skip_test_out.csv' # use gold file from above
    cli_args = 'Executioner/Predictor/skip_times=0.9999999999 Executioner/timestep_tolerance=1e-9'
    prereq = 'skip/test_skip'
  []
[]
